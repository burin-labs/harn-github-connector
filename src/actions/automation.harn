import {
  GithubWorkflowAutomationRequest,
  GithubWorkflowWaitReceipt,
  GithubWorkflowWaitRequest,
} from "../contracts"
import { __err } from "../errors"
import { __actions_call_raw } from "../operations/actions"
import { __client_options, __positive_int, __resolve_max_attempts } from "../request_options"

const DEFAULT_DISPATCH_POLL_INTERVAL_MS = 5000

const DEFAULT_DISPATCH_TIMEOUT_MS = 600000

/** Dispatch one workflow and return the exact run identity accepted by GitHub. */
pub fn github_dispatch_workflow_and_resolve_run(
  harness: Harness,
  request: GithubWorkflowAutomationRequest,
) -> GithubWorkflowWaitReceipt {
  const auth = __client_options(request.options ?? {})
  const workflow_id = request.workflow_id
  const dispatch = __actions_call_raw(
    harness,
    "actions.workflow_dispatch",
    auth
      + {
        owner: request.owner,
        repo: request.repo,
        workflow_id: workflow_id,
        ref: request.ref ?? "main",
        inputs: request.inputs ?? {},
        return_run_details: true,
      },
  )
  if is_err(dispatch) {
    return __workflow_wait_envelope(
      false,
      "dispatch_failed",
      workflow_id,
      nil,
      [],
      false,
      unwrap_err(dispatch),
    )
  }
  const dispatch_run_id = __extract_dispatch_run_id(unwrap(dispatch))
  if dispatch_run_id == nil {
    const error = unwrap_err(
      __err("dispatch_identity_missing", "workflow dispatch response omitted workflow_run_id"),
    )
    return __workflow_wait_envelope(
      false,
      "dispatch_identity_missing",
      workflow_id,
      nil,
      [{attempt: 0, kind: "dispatch_identity_missing", error: error}],
      false,
      error,
    )
  }
  const direct_cfg = __workflow_wait_config(request, dispatch_run_id)
    + {return_on_identity: true}
  return __workflow_wait_loop(harness, request.owner, request.repo, direct_cfg)
}

/** Dispatch one workflow, then wait for only its accepted run to finish. */
pub fn github_dispatch_workflow_and_wait(
  harness: Harness,
  request: GithubWorkflowAutomationRequest,
) -> GithubWorkflowWaitReceipt {
  const identity = github_dispatch_workflow_and_resolve_run(harness, request)
  if !identity.ok {
    return identity
  }
  const monitored = github_wait_for_workflow_run(
    harness,
    request + {run_id: identity.run_id, workflow_id: request.workflow_id},
  )
  return monitored + {attempts: identity.attempts + monitored.attempts}
}

/** Wait for one exact workflow run or one bounded workflow-run filter. */
pub fn github_wait_for_workflow_run(
  harness: Harness,
  request: GithubWorkflowWaitRequest,
) -> GithubWorkflowWaitReceipt {
  const target = request.run_id ?? request.filter ?? {workflow_id: request.workflow_id}
  const cfg = __workflow_wait_config(request, target)
  return __workflow_wait_loop(harness, request.owner, request.repo, cfg)
}

fn __workflow_wait_config(opts: any, run_id_or_filter: any) {
  const polling = opts?.polling ?? {}
  const poll_interval = __positive_int(polling?.interval_ms, DEFAULT_DISPATCH_POLL_INTERVAL_MS)
  const timeout_ms = __positive_int(polling?.timeout_ms, DEFAULT_DISPATCH_TIMEOUT_MS)
  const target_is_dict = type_of(run_id_or_filter) == "dict"
  const initial_run_id = if target_is_dict {
    nil
  } else {
    run_id_or_filter
  }
  const workflow_id = opts?.workflow_id
  const filter = if target_is_dict {
    run_id_or_filter
  } else {
    opts?.filter ?? {workflow_id: workflow_id, event: "workflow_dispatch", per_page: 10}
  }
  return {
    auth: __client_options(opts?.options ?? {}),
    poll_interval_ms: poll_interval,
    max_attempts: __resolve_max_attempts(polling?.max_attempts, poll_interval, timeout_ms),
    workflow_id: workflow_id,
    initial_run_id: initial_run_id,
    filter: filter,
  }
}

fn __workflow_wait_loop(harness: Harness, owner: any, repo: any, cfg: any) {
  let attempts = []
  let attempt = 0
  let run_id = cfg.initial_run_id
  let identity_run = nil
  let last_run = nil
  while attempt < cfg.max_attempts {
    attempt = attempt + 1
    if run_id == nil {
      const located = __workflow_wait_locate_step(
        harness,
        owner,
        repo,
        cfg.filter,
        cfg.auth,
        attempt,
      )
      attempts = attempts + located.attempts
      if len(located?.candidate_run_ids ?? []) > 1 {
        return __workflow_wait_envelope(
          false,
          "ambiguous_dispatch",
          cfg.workflow_id,
          nil,
          attempts,
          false,
          located.error,
          located.candidate_run_ids,
        )
      }
      run_id = located.run_id
      identity_run = located?.run
    }
    if run_id != nil {
      if (cfg?.return_on_identity ?? false) && identity_run != nil {
        return __workflow_envelope_from_run(
          true,
          "dispatch_accepted",
          identity_run,
          attempts,
          false,
          nil,
        )
          + {workflow_id: cfg.workflow_id}
      }
      const probed = __workflow_wait_probe_step(harness, owner, repo, run_id, cfg.auth, attempt)
      attempts = attempts + probed.attempts
      if probed.run != nil {
        last_run = probed.run
        if cfg?.return_on_identity ?? false {
          return __workflow_envelope_from_run(
            true,
            "dispatch_accepted",
            probed.run,
            attempts,
            false,
            nil,
          )
            + {workflow_id: cfg.workflow_id}
        }
      }
      if probed.completed {
        return __workflow_envelope_from_run(true, "completed", probed.run, attempts, false, nil)
      }
    }
    if attempt < cfg.max_attempts && cfg.poll_interval_ms > 0 {
      harness.clock.sleep_ms(cfg.poll_interval_ms)
    }
  }
  return __workflow_wait_loop_terminal(cfg, attempts, run_id, last_run)
}

fn __workflow_wait_loop_terminal(cfg: any, attempts: any, run_id: any, last_run: any) {
  if last_run != nil {
    return __workflow_envelope_from_run(false, "timed_out", last_run, attempts, true, nil)
  }
  if run_id == nil {
    return __workflow_wait_envelope(
      false,
      "run_not_found",
      cfg.workflow_id,
      nil,
      attempts,
      true,
      nil,
    )
  }
  return __workflow_wait_envelope(false, "timed_out", cfg.workflow_id, run_id, attempts, true, nil)
}

fn __workflow_wait_locate_step(
  harness: Harness,
  owner: any,
  repo: any,
  filter: any,
  auth: any,
  attempt: any,
) {
  const located = __locate_workflow_run(harness, owner, repo, filter, auth)
  if is_err(located) {
    return {
      attempts: [{attempt: attempt, kind: "list_failed", error: unwrap_err(located)}],
      run_id: nil,
    }
  }
  if located == nil {
    return {attempts: [{attempt: attempt, kind: "run_not_found"}], run_id: nil}
  }
  return {
    attempts: [
      {attempt: attempt, kind: "located", run_id: located.id, created_at: located?.created_at},
    ],
    run_id: located.id,
    run: located,
  }
}

fn __workflow_wait_probe_step(
  harness: Harness,
  owner: any,
  repo: any,
  run_id: any,
  auth: any,
  attempt: any,
) {
  const run = __actions_call_raw(
    harness,
    "actions.workflow_run.get",
    auth + {owner: owner, repo: repo, run_id: run_id},
  )
  if is_err(run) {
    return {
      attempts: [{attempt: attempt, kind: "get_failed", run_id: run_id, error: unwrap_err(run)}],
      run: nil,
      completed: false,
    }
  }
  const status = lowercase(to_string(run?.status ?? ""))
  return {
    attempts: [
      {
        attempt: attempt,
        kind: "polled",
        run_id: run_id,
        status: status,
        conclusion: run?.conclusion,
      },
    ],
    run: run,
    completed: status == "completed",
  }
}

fn __extract_dispatch_run_id(dispatched: any) {
  if dispatched == nil {
    return nil
  }
  return dispatched?.workflow_run_id ?? dispatched?.run_id ?? dispatched?.id
}

fn __locate_workflow_run(harness: Harness, owner: any, repo: any, filter: any, auth: any) {
  const resp = __actions_call_raw(
    harness,
    "actions.workflow_runs.list",
    auth + __locate_args(filter) + {owner: owner, repo: repo},
  )
  if is_err(resp) {
    return resp
  }
  return __pick_newest_run(unwrap(resp)?.workflow_runs ?? [], filter)
}

fn __locate_args(filter: any) {
  let args = {}
  if filter?.workflow_id != nil {
    args["workflow_id"] = filter.workflow_id
  }
  if filter?.event != nil {
    args["event"] = to_string(filter.event)
  }
  if filter?.branch != nil {
    args["branch"] = to_string(filter.branch)
  }
  if filter?.head_sha != nil {
    args["head_sha"] = to_string(filter.head_sha)
  }
  if filter?.per_page != nil {
    args["per_page"] = to_int(filter.per_page) ?? filter.per_page
  }
  return args
}

fn __pick_newest_run(runs: any, filter: any) {
  const cutoff = filter?.created_after
  const head_sha = filter?.head_sha
  let best = nil
  for r in runs {
    if !__run_matches_filter(r, cutoff, head_sha) {
      continue
    }
    if best == nil || __run_is_newer(r, best) {
      best = r
    }
  }
  return best
}

fn __run_matches_filter(run: any, cutoff: any, head_sha: any) {
  const created_at = run?.created_at
  if cutoff != nil && created_at != nil && to_string(created_at) < to_string(cutoff) {
    return false
  }
  if head_sha != nil && run?.head_sha != head_sha {
    return false
  }
  return true
}

fn __run_is_newer(candidate: any, best: any) {
  const created_at = candidate?.created_at
  if created_at == nil || best?.created_at == nil {
    return false
  }
  return to_string(created_at) > to_string(best.created_at)
}

fn __workflow_wait_envelope(
  ok: any,
  status: any,
  workflow_id: any,
  run_id: any,
  attempts: any,
  timed_out: any,
  error: any,
  candidate_run_ids: any = nil,
) {
  return {
    ok: ok,
    status: status,
    conclusion: nil,
    run_id: run_id,
    candidate_run_ids: candidate_run_ids
      ?? if run_id == nil {
        []
      } else {
        [run_id]
      },
    run_url: nil,
    workflow_id: workflow_id,
    workflow_path: nil,
    run_attempt: nil,
    head_sha: nil,
    head_branch: nil,
    event: nil,
    created_at: nil,
    started_at: nil,
    updated_at: nil,
    attempts: attempts,
    timed_out: timed_out,
    error: error,
  }
}

fn __workflow_envelope_from_run(
  ok: any,
  status: any,
  run: any,
  attempts: any,
  timed_out: any,
  error: any,
) {
  return {
    ok: ok,
    status: status,
    conclusion: run?.conclusion,
    run_id: run?.id,
    candidate_run_ids: if run?.id == nil {
      []
    } else {
      [run.id]
    },
    run_url: run?.html_url ?? run?.url,
    workflow_id: run?.workflow_id,
    workflow_path: run?.path,
    run_attempt: run?.run_attempt,
    head_sha: run?.head_sha,
    head_branch: run?.head_branch,
    event: run?.event,
    created_at: run?.created_at,
    started_at: run?.run_started_at ?? run?.started_at,
    updated_at: run?.updated_at,
    attempts: attempts,
    timed_out: timed_out,
    error: error,
  }
}
