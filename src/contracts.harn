/** One normalized connector failure. Provider-specific evidence stays typed. */
pub type GithubConnectorError = {
  code: string,
  category: string,
  message: string,
  http_status?: int,
  expected_head_oid?: string,
  observed_head_oid?: string,
  expected_base_oid?: string,
  observed_base_oid?: string,
  compensation_state?: string,
  compensation_message?: string,
  expected_commit_count?: int,
  observed_commit_count?: int,
  expected_release_id?: int,
  observed_release_id?: int,
  expected_tag_ref_oid?: string,
  observed_tag_ref_oid?: string,
  expected_tag_target_oid?: string,
  observed_tag_target_oid?: string,
  tag?: string,
  candidate_run_ids?: list<int>,
  path?: string,
  file_mode?: string,
  base_file_mode?: string,
}

/** Canonical fallible boundary for every normalized GitHub operation. */
pub type GithubConnectorResult<T> = Result<T, GithubConnectorError>

/** GitHub accepts either a workflow file/name or its numeric database id. */
pub type GithubWorkflowId = string | int

/** Bounded retry policy for one GitHub HTTP request. */
pub type GithubRetryPolicy = {
  max_attempts?: int,
  base_ms?: int,
  backoff_ms?: int,
  cap_ms?: int,
  retry_on?: list<int>,
  respect_retry_after?: bool,
}

/** Authentication, transport, and retry policy shared by typed requests. */
pub type GithubClientOptions = {
  api_base_url?: string,
  installation_token?: string,
  token?: string,
  bindings?: dict,
  secrets?: dict,
  app_id?: string | int,
  installation_id?: string | int,
  private_key_pem?: string,
  private_key_secret?: string,
  jwt_alg?: string,
  jwt_backdate_seconds?: int,
  jwt_ttl_seconds?: int,
  token_refresh_skew_seconds?: int,
  now?: int,
  timeout_ms?: int,
  rate_limit_max_sleep_seconds?: int,
  retry?: GithubRetryPolicy,
  retry_unsafe?: bool,
  idempotency_key?: string,
  allow_gh_auth_fallback?: bool,
  gh_auth_fallback?: bool,
  gh_token?: string,
  oauth_base_url?: string,
  device_code_url?: string,
  access_token_url?: string,
}

/** One low-level REST request for an endpoint without a typed helper. */
pub type GithubRawApiRequest = {
  path: string,
  method?: string,
  body?: unknown,
  options?: GithubClientOptions,
}

/** Start GitHub's user OAuth device flow. */
pub type GithubOAuthDeviceCodeRequest = {
  client_id: string,
  scope?: string,
  options?: GithubClientOptions,
}

/** Poll one user OAuth device flow. */
pub type GithubOAuthDevicePollRequest = {
  client_id: string,
  device_code: string,
  options?: GithubClientOptions,
}

/** Exchange one user OAuth web-flow code. */
pub type GithubOAuthExchangeCodeRequest = {
  client_id: string,
  code: string,
  client_secret?: string,
  redirect_uri?: string,
  options?: GithubClientOptions,
}

/** Refresh one expiring GitHub user token. */
pub type GithubOAuthRefreshRequest = {
  client_id: string,
  refresh_token: string,
  client_secret?: string,
  options?: GithubClientOptions,
}

/** Commit identity selected by a host or orchestration policy. */
pub type GithubCommitIdentity = {name: string, email: string}

/** Authorship policy that accompanies a mutation but never enters its body. */
pub type GithubAuthorChoice = {
  author_mode?: "human" | "bot",
  commit_author?: GithubCommitIdentity,
  commit_committer?: GithubCommitIdentity,
  trailers?: string,
}

/** Top-level authorship fields accepted by dynamic mutation operations. */
pub type GithubAuthorPolicy = {
  github_author_choice?: GithubAuthorChoice,
  author_choice?: GithubAuthorChoice,
  author_mode?: "human" | "bot",
}

/** Named repository identity plus isolated authentication and transport policy. */
pub type GithubRepositoryRequest = {owner: string, repo: string, options?: GithubClientOptions}

/** Read one repository file, optionally at an exact ref. */
pub type GithubRepositoryTextRequest = GithubRepositoryRequest \
  & {path: string, ref?: string, include_raw?: bool}

/** Decoded repository file content. */
pub type GithubRepositoryText = {
  name: string,
  path: string,
  sha: string,
  size: int,
  encoding: string,
  ref: string?,
  text: string,
  raw: unknown?,
}

/** Named pull-request identity used instead of a positional repository/number tuple. */
pub type GithubPullRequestRequest = GithubRepositoryRequest & {pull_number: int}

/** Closed editable field set for a pull request. */
pub type GithubPullRequestEditInput = {
  title?: string,
  body?: string?,
  state?: "open" | "closed",
  base?: string,
}

/** Request for the merge-captain pull-request view with normalized checks. */
pub type GithubPullsWithChecksRequest = GithubRepositoryRequest \
  & {state?: "open" | "closed", limit?: int, check_limit?: int}

/** One normalized GraphQL check or legacy commit-status context. */
pub type GithubStatusCheckContext = {
  name: string,
  status: string,
  conclusion: string?,
  detailsUrl: string?,
}

/** Pull-request fields needed by merge automation, including its check contexts. */
pub type GithubPullRequestWithChecks = {
  number: int,
  title: string,
  headRefName: string,
  baseRefName: string,
  isDraft: bool,
  mergeStateStatus: string,
  statusCheckRollup: list<GithubStatusCheckContext>,
  url: string,
}

/** Ordered pull requests returned by the merge-captain view. */
pub type GithubPullRequestsWithChecks = list<GithubPullRequestWithChecks>

/** Request for editing one pull request through the canonical typed operation. */
pub type GithubPullRequestEditRequest = GithubPullRequestRequest \
  & {edits: GithubPullRequestEditInput}

/** Request for a protected-branch-aware pull-request merge. */
pub type GithubPullRequestMergeRequest = GithubPullRequestRequest \
  & {
  admin_override?: bool,
  delete_branch?: bool,
  method?: "merge" | "squash" | "rebase",
  commit_title?: string,
  commit_message?: string,
}

/** Request for enabling auto-merge under an exact head lease. */
pub type GithubAutoMergeRequest = GithubPullRequestRequest \
  & {
  expected_head_oid: string,
  method?: "merge" | "squash" | "rebase",
  commit_headline?: string,
  commit_body?: string,
}

/** Request for disabling auto-merge under exact pull and base leases. */
pub type GithubAutoMergeDisableRequest = GithubPullRequestRequest \
  & {
  expected_head_oid: string,
  base_branch: string,
  expected_base_oid: string,
  restore_merge_method: "merge" | "squash" | "rebase",
}

/** Protected-branch-aware merge evidence. Raw provider documents stay nested. */
pub type GithubPullRequestMergeReceipt = {
  pull_request: dict,
  protected: bool,
  branch_protection: dict?,
  merge: dict,
  delete_branch?: dict,
}

/** Request for reading all commits on one stable pull-request head. */
pub type GithubPullRequestCommitsRequest = GithubPullRequestRequest \
  & {per_page?: int, expected_head_oid?: string}

/** Repository and immutable revision identity for one pull-request side. */
pub type GithubPullRequestRef = {ref: string, sha: string, repo: string, owner: string}

/** Public GitHub actor fields returned with a pull request. */
pub type GithubPullRequestUser = {id: int?, login: string, type: string}

/** Stable pull-request state shared by summary and detail operations. */
pub type GithubPullRequestSummary = {
  repo: string,
  number: int,
  title: string,
  url: string,
  state: string,
  github_state: string,
  draft: bool,
  merged: bool,
  merged_at: string?,
  merge_commit_oid: string?,
  mergeable: bool?,
  mergeable_state: string,
  base: GithubPullRequestRef,
  head: GithubPullRequestRef,
  labels: list<string>,
  auto_merge_armed: bool,
  auto_merge_method: string?,
  in_merge_queue: bool?,
}

/** Pull-request summary plus body, actor, and lifecycle timestamps. */
pub type GithubPullRequestDetails = GithubPullRequestSummary \
  & {
  body: string,
  user: GithubPullRequestUser?,
  created_at: string?,
  updated_at: string?,
  closed_at: string?,
}

/** Receipt proving whether pull-request creation created or reused the pull request. */
pub type GithubPullRequestCreateReceipt = GithubPullRequestDetails & {created: bool}

/** Receipt proving whether a pull-request edit changed remote state. */
pub type GithubPullRequestEditReceipt = GithubPullRequestDetails & {ok: bool, updated: bool}

/** Closed input for creating or refreshing one exact automation pull request. */
pub type GithubPullRequestUpsertRequest = GithubRepositoryRequest \
  & {head: string, base: string, title: string, body: string, expected_head_oid: string}

/** Receipt proving whether an exact automation pull request was created or updated. */
pub type GithubPullRequestUpsertReceipt = GithubPullRequestDetails \
  & {action: "created" | "updated", created: bool, updated: bool}

/** Normalized branch-protection policy, including an explicit unavailable outcome. */
pub type GithubBranchProtection = {
  available: bool,
  branch: string,
  protected: bool?,
  required_checks: list<string>,
  strict: bool?,
  required_review_count: int?,
  require_code_owner_reviews: bool?,
  require_conversation_resolution: bool?,
  allow_force_pushes: bool?,
  allow_deletions: bool?,
  error: GithubConnectorError?,
}

/** One repository branch bound to its exact current commit. */
pub type GithubBranchHead = {repo: string, branch: string, oid: string, url: string}

/** Request for one branch's exact current commit. */
pub type GithubBranchHeadRequest = GithubRepositoryRequest & {branch: string}

/**
 * Request to claim one fully qualified ref for an exact object.
 *
 * `ref` is the complete name, `refs/heads/...` or `refs/tags/...`, because the
 * create and read endpoints spell the same ref differently and normalizing at
 * one boundary is what keeps a claim and its read-back describing the same ref.
 */
pub type GithubRefClaimRequest = GithubRepositoryRequest \
  & {ref: string, oid?: string, payload?: GithubRefClaimPayload}

/**
 * A message to mint the claimed object from, when the caller has no oid.
 *
 * A lock has nothing to point at: the work it guards has not happened yet. The
 * connector mints a parentless commit carrying `message`, reusing the tree at
 * `base_ref` because a commit needs one and the caller has no opinion about it.
 * Minting here rather than in the caller keeps the claim a single round trip
 * from the caller's side, and keeps Git plumbing on the side of the boundary
 * that already owns it.
 *
 * The commit is never merged and never reachable from a branch. If the claim is
 * lost, the object is unreferenced and GitHub collects it.
 */
pub type GithubRefClaimPayload = {message: string, base_ref: string}

/**
 * Request to release one ref this caller still holds.
 *
 * `expected_oid` is not optional and not a convenience: GitHub's ref delete has
 * no compare-and-swap, so the only thing separating "release my lock" from
 * "delete whatever is there now" is reading the ref first and refusing when it
 * has moved. A payload minted per run makes that check exact.
 */
pub type GithubRefReleaseRequest = GithubRepositoryRequest & {ref: string, expected_oid: string}

/** Outcome of one ref release. `oid` is what the ref held when it was read. */
pub type GithubRefRelease = {
  repo: string,
  ref: string,
  oid: string,
  released: bool,
  reason: "released" | "already_absent" | "held_by_another",
}

/**
 * Outcome of one atomic ref claim.
 *
 * `oid` is what the ref points at once the call returns, whoever won, so a
 * caller that lost still learns the holder. `holder_headline` is the first line
 * of the holding commit's message when the ref resolves to a commit and the
 * claim was lost; it is empty otherwise. It is what turns "someone else holds
 * this" into "who, and since when", so a lock payload has somewhere to live.
 */
pub type GithubRefClaim = {
  repo: string,
  ref: string,
  oid: string,
  claimed: bool,
  holder_headline: string,
}

/** Exact commit and tree identities used to compare two repository refs. */
pub type GithubBranchTreeComparison = {
  repo: string,
  left_ref: string,
  left_oid: string,
  left_tree_oid: string,
  right_ref: string,
  right_oid: string,
  right_tree_oid: string,
  equal: bool,
}

/** Closed ref pair for one repository tree comparison. */
pub type GithubBranchTreeCompareRequest = GithubRepositoryRequest \
  & {left_ref: string, right_ref: string}

/** One repository file decoded at an exact Git ref. */
pub type GithubRepositoryFile = {
  name: string,
  path: string,
  sha: string,
  size: int,
  ref: string,
  text: string,
  url: string,
}

/** Explicit found-or-absent result for one repository path at an exact ref. */
pub type GithubFileLookup = {
  repo: string,
  path: string,
  ref: string,
  state: "found",
  found: bool,
  file: GithubRepositoryFile,
} \
  | {repo: string, path: string, ref: string, state: "absent", found: bool, file: nil}

/** Closed identity for one repository file read. */
pub type GithubFileLookupRequest = GithubRepositoryRequest & {path: string, ref: string}

