import "./actions/operations"
import "./client"
import { __err, __graphql_err } from "./errors"
import "./operations/actions"
import "./operations/branches"
import "./operations/commits"
import "./operations/oauth"
import "./operations/pull_files"
import "./operations/pull_reviews"
import "./operations/pull_upsert"
import "./operations/pulls"
import { __github_refs_update } from "./operations/ref_updates"
import "./operations/refs"
import "./operations/releases"
import "./operations/shared"
import { __request_context_keys } from "./request_options"

const GITHUB_OUTBOUND_METHODS = [
  "github.pr.list",
  "github.pr.create",
  "github.pr.view",
  "github.pr.edit",
  "github.pr.files",
  "github.pr.file_census",
  "github.pr.review_census",
  "github.pr.commits",
  "github.pr.checks",
  "github.pr.merge",
  "github.pr.enable_auto_merge",
  "github.pr.disable_auto_merge",
  "github.pr.upsert",
  "github.pr.comment",
  "github.actions.workflow_dispatch",
  "github.actions.runs",
  "github.actions.run",
  "github.actions.run_jobs",
  "github.actions.run_cancel",
  "github.actions.run_rerun",
  "github.actions.logs",
  "github.release.view",
  "github.release.edit_body",
  "github.release.latest",
  "github.release.latest_lookup",
  "github.release.assets",
  "github.merge_queue.entries",
  "github.merge_queue.membership",
  "github.merge_queue.enqueue",
  "github.issue.create",
  "github.issue.comment",
  "github.branch.protection",
  "github.branch.view",
  "github.branch.compare_trees",
  "github.branch.create_signed_commit",
  "github.ref.claim",
  "github.ref.release",
  "github.refs.update",
  "github.commit.signature",
  "github.commit.signed_identity",
  "github.file.view",
  "github.app.installation_token",
  "api_call",
  "issues.create_comment",
  "issues.create",
  "issues.create_with_template",
  "issues.update",
  "issues.add_labels",
  "pulls.list",
  "pulls.list_with_checks",
  "pulls.get",
  "pulls.update",
  "pulls.create",
  "pulls.merge",
  "pulls.merge_safe",
  "pulls.create_review_comment",
  "pulls.get_diff",
  "pulls.list_files",
  "pulls.list_reviews",
  "repos.get_content",
  "repos.get_text",
  "repos.create_or_update_file",
  "repos.put_content",
  "repos.delete_file",
  "repos.get_latest_release",
  "repos.list_release_assets",
  "repos.get_branch_protection",
  "git.create_commit",
  "git.delete_ref",
  "actions.workflow_dispatch",
  "actions.workflow_runs.list",
  "actions.workflow_run.get",
  "actions.workflow_run.jobs",
  "actions.workflow_run.cancel",
  "actions.workflow_run.rerun",
  "actions.runners.registration_token",
  "actions.runners.remove_token",
  "actions.runners.generate_jitconfig",
  "actions.runners.list",
  "actions.runners.get",
  "actions.runners.delete",
  "actions.runners.downloads",
  "actions.runners.labels.list",
  "actions.runners.labels.add",
  "actions.runners.labels.replace",
  "actions.runners.labels.remove",
  "actions.runner_groups.list",
  "actions.runner_groups.create",
  "actions.runner_groups.get",
  "actions.runner_groups.update",
  "actions.runner_groups.delete",
  "check_runs.create",
  "check_runs.update",
  "repos.commit_pulls",
  "pull_requests.resolve_mergeable",
  "oauth.user.device_code",
  "oauth.user.device_poll",
  "oauth.user.exchange_code",
  "oauth.user.refresh",
  "graphql",
]

@complexity(allow)
pub fn __call_raw(harness: Harness, method: any, args: any = {}) {
  if !contains(GITHUB_OUTBOUND_METHODS, method) {
    return __err(
      "method_not_found",
      "github connector does not implement outbound method `" + method + "`",
    )
  }
  if starts_with(method, "oauth.user.") {
    return __oauth_user_dispatch(harness, method, args ?? {})
  }
  const config = __outbound_config(harness, args ?? {})
  if is_err(config) {
    return config
  }
  const cfg = unwrap(config)
  if method == "github.app.installation_token" {
    // Resolving `cfg` above already self-minted the installation token in
    // app-credential mode (app_id + installation_id + private_key_pem/secret),
    // or carried through a direct/gh-auth token. Expose it so an orchestrator
    // can obtain a bearer token for its own git operations
    // without re-implementing RS256 JWT minting. The caller must already hold
    // the credentials, so this grants no privilege it did not already have.
    return {
      token: cfg.installation_token,
      token_mode: cfg.token_mode,
      installation_id: cfg.installation_id,
      api_base_url: cfg.api_base_url,
    }
  }
  const handler = {
    "github.pr.list": __github_pr_list,
    "github.pr.create": __github_pr_create,
    "github.pr.view": __github_pr_view,
    "github.pr.edit": __github_pr_edit,
    "github.pr.files": __github_pr_files,
    "github.pr.file_census": __github_pr_file_census,
    "github.pr.review_census": __github_pr_review_census,
    "github.pr.commits": __github_pr_commits,
    "github.pr.checks": __github_pr_checks,
    "github.pr.merge": __github_pr_merge,
    "github.pr.enable_auto_merge": __github_pr_enable_auto_merge,
    "github.pr.disable_auto_merge": __github_pr_disable_auto_merge,
    "github.pr.upsert": __github_pr_upsert,
    "github.pr.comment": __github_pr_comment,
    "github.actions.workflow_dispatch": __github_actions_workflow_dispatch,
    "github.actions.runs": __github_actions_runs,
    "github.actions.run": __github_actions_run,
    "github.actions.run_jobs": __github_actions_run_jobs,
    "github.actions.run_cancel": __github_actions_run_cancel,
    "github.actions.run_rerun": __github_actions_run_rerun,
    "github.actions.logs": __github_actions_logs,
    "github.release.view": __github_release_view,
    "github.release.edit_body": __github_release_edit_body,
    "github.release.latest": __github_release_latest,
    "github.release.latest_lookup": __github_release_latest_lookup,
    "github.release.assets": __github_release_assets,
    "github.merge_queue.entries": __github_merge_queue_entries,
    "github.merge_queue.membership": __github_merge_queue_membership,
    "github.merge_queue.enqueue": __github_merge_queue_enqueue,
    "github.issue.create": __github_issue_create,
    "github.issue.comment": __github_issue_comment,
    "github.branch.protection": __github_branch_protection,
    "github.branch.view": __github_branch_view,
    "github.branch.compare_trees": __github_branch_compare_trees,
    "github.branch.create_signed_commit": __github_create_signed_commit,
    "github.commit.signature": __github_commit_signature,
    "github.commit.signed_identity": __github_read_signed_commit,
    "github.file.view": __github_file_view,
    api_call: __api_call,
    "issues.create_with_template": __issues_create_with_template,
    "pulls.list_with_checks": __pulls_list_with_checks,
    "pulls.update": __pulls_update,
    "pulls.create": __pulls_create,
    "pulls.merge_safe": __pulls_merge_safe,
    "repos.get_text": __repos_get_text,
    "repos.create_or_update_file": __repos_create_or_update_file,
    "repos.put_content": __repos_create_or_update_file,
    "repos.delete_file": __repos_delete_file,
    "repos.get_latest_release": __repos_get_latest_release,
    "repos.list_release_assets": __repos_list_release_assets,
    "github.ref.claim": __github_ref_claim,
    "github.ref.release": __github_ref_release,
    "github.refs.update": __github_refs_update,
    "git.create_commit": __git_create_commit,
    "actions.workflow_dispatch": __actions_workflow_dispatch,
    "actions.workflow_runs.list": __actions_workflow_runs_list,
    "actions.workflow_run.get": __actions_workflow_run_get,
    "actions.workflow_run.jobs": __actions_workflow_run_jobs,
    "actions.workflow_run.cancel": __actions_workflow_run_cancel,
    "actions.workflow_run.rerun": __actions_workflow_run_rerun,
    "repos.commit_pulls": __repos_commit_pulls,
    "pull_requests.resolve_mergeable": __pull_requests_resolve_mergeable,
  }
    .get(method)
  if handler != nil {
    return handler(harness, args, cfg)
  }
  const request = fn(verb: string, path: string, body: any) { return __github_json(
    harness,
    verb,
    __github_api_url(cfg.api_base_url, "/repos/" + args.owner + "/" + args.repo + path),
    body,
    cfg,
  ) }
  if method == "issues.create_comment" {
    return request(
      "POST",
      "/issues/" + to_string(args.issue_number) + "/comments",
      {body: args.body},
    )
  }
  if method == "issues.create" {
    return request(
      "POST",
      "/issues",
      __body_without(args, __request_context_keys() + ["owner", "repo"]),
    )
  }
  if method == "issues.update" {
    return request(
      "PATCH",
      "/issues/" + to_string(args.issue_number),
      __body_without(args, __request_context_keys() + ["owner", "repo", "issue_number"]),
    )
  }
  if method == "issues.add_labels" {
    return request(
      "POST",
      "/issues/" + to_string(args.issue_number) + "/labels",
      {labels: args.labels ?? []},
    )
  }
  if method == "pulls.list" {
    return request("GET", "/pulls" + __pulls_list_query(args), nil)
  }
  if method == "pulls.get" {
    return request("GET", "/pulls/" + to_string(args.pull_number), nil)
  }
  if method == "pulls.merge" {
    const merged = __pulls_merge_safe(harness, args, cfg)
    if is_err(merged) {
      return merged
    }
    return merged.merge
  }
  if method == "pulls.create_review_comment" {
    return request(
      "POST",
      "/pulls/" + to_string(args.pull_number) + "/comments",
      __body_without(args, __request_context_keys() + ["owner", "repo", "pull_number"]),
    )
  }
  if method == "pulls.get_diff" {
    return __github_text(
      harness,
      "GET",
      __github_api_url(
        cfg.api_base_url,
        "/repos/" + args.owner + "/" + args.repo + "/pulls/" + to_string(args.pull_number),
      ),
      cfg,
      "application/vnd.github.v3.diff",
    )
  }
  if method == "pulls.list_files" {
    return request(
      "GET",
      "/pulls/" + to_string(args.pull_number) + "/files" + __pagination_query(args),
      nil,
    )
  }
  if method == "pulls.list_reviews" {
    return request(
      "GET",
      "/pulls/" + to_string(args.pull_number) + "/reviews" + __pagination_query(args),
      nil,
    )
  }
  if method == "repos.get_content" {
    return request(
      "GET",
      "/contents/" + __trim_leading_slash(args.path ?? "") + __ref_query(args),
      nil,
    )
  }
  if method == "repos.get_branch_protection" {
    return request("GET", "/branches/" + url_encode(to_string(args.branch)) + "/protection", nil)
  }
  if method == "git.delete_ref" {
    return request("DELETE", "/git/refs/" + __trim_leading_slash(args.ref ?? ""), nil)
  }
  if starts_with(method, "actions.runners.") || starts_with(method, "actions.runner_groups.") {
    return __actions_runners_dispatch(harness, method, args, cfg)
  }
  if method == "check_runs.create" {
    return request(
      "POST",
      "/check-runs",
      __body_without(args, __request_context_keys() + ["owner", "repo"]),
    )
  }
  if method == "check_runs.update" {
    return request(
      "PATCH",
      "/check-runs/" + to_string(args.check_run_id),
      __body_without(args, __request_context_keys() + ["owner", "repo", "check_run_id"]),
    )
  }
  const graph = __github_json(
    harness,
    "POST",
    __github_api_url(cfg.api_base_url, "/graphql"),
    {query: args.query, variables: args.variables ?? {}},
    cfg,
  )
  if is_err(graph) {
    return graph
  }
  if graph?.errors != nil && len(graph.errors) > 0 {
    return __graphql_err("github GraphQL", graph.errors)
  }
  return graph
}
