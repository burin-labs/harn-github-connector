/** Return every method accepted by `call`, from the executable route registry. */
pub fn outbound_methods() -> list<string> {
  return __outbound_routes().keys()
}

/** Dispatch a supported GitHub method through one explicit Result boundary. */
@complexity(allow)
pub fn call(harness: Harness, method: string, args: dict = {}) -> GithubConnectorResult<unknown> {
  const value = __call_raw(harness, method, args)
  if is_err(value) {
    const error: GithubConnectorError = unwrap_err(value)
    return Err(error)
  }
  return Ok(value)
}

/** Dispatch and validate one method against an exported success contract. */
pub fn call_typed<T>(
  harness: Harness,
  method: string,
  args: dict,
  schema: Schema<T>,
) -> GithubConnectorResult<T> {
  const result = call(harness, method, args)
  if is_err(result) {
    return Err(unwrap_err(result))
  }
  const value = unwrap(result)
  if schema_is(value, schema) {
    return Ok(value)
  }
  return connector_error(
    "invalid_response",
    "github connector method `" + method + "` did not match its declared success contract",
  )
}

fn __call_raw(harness: Harness, method, args = {}) {
  const route = __outbound_routes()[method]
  if route == nil {
    return connector_error(
      "method_not_found",
      "github connector does not implement outbound method `" + method + "`",
    )
  }
  if route?.kind == "oauth" {
    return __oauth_user_dispatch(harness, method, args ?? {})
  }
  const config = __outbound_config(harness, args ?? {})
  if is_err(config) {
    return config
  }
  const cfg = unwrap(config)
  if route?.kind == "runner" {
    return __actions_runners_dispatch(harness, method, args, cfg)
  }
  const handler = route?.handler
  if handler == nil {
    return connector_error(
      "invalid_response",
      "github connector method `" + method + "` has no executable route",
    )
  }
  return handler(harness, args, cfg)
}

fn __github_actions_workflow_dispatch(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const workflow_id = args?.workflow_id ?? args?.workflow ?? args?.workflow_file
  if workflow_id == nil || trim(to_string(workflow_id)) == "" {
    return connector_error(
      "schema_drift",
      "github.actions.workflow_dispatch requires workflow_id, workflow, or workflow_file",
    )
  }
  const ref = args?.ref ?? args?.branch ?? "main"
  const resolved = github_dispatch_workflow_and_resolve_run(
    harness,
    r.owner,
    r.name,
    workflow_id,
    ref,
    args?.inputs ?? {},
    args,
  )
  if !resolved.ok {
    return Err(
      resolved?.error ?? {code: resolved.status, category: "workflow", message: resolved.status},
    )
  }
  const receipt = __typed_workflow_dispatch(r.full_name, ref, resolved)
  if is_err(receipt) {
    return receipt
  }
  return unwrap(receipt)
}
