fn __github_pr_commits(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const number = __positive_decimal(args?.pr_number ?? args?.number ?? args?.pull_number, nil)
  if number == nil {
    return connector_error(
      "schema_drift",
      "github.pr.commits requires a positive pull-request number",
    )
  }
  const per_page = if args?.per_page == nil {
    100
  } else {
    __positive_decimal(args.per_page, 100)
  }
  if per_page == nil {
    return connector_error(
      "schema_drift",
      "github.pr.commits per_page must be an integer from 1 to 100",
    )
  }
  const initial = __github_pull_identity(harness, r, number, cfg, "github.pr.commits")
  if is_err(initial) {
    return initial
  }
  const initial_pull = unwrap(initial)
  const head_sha = to_string(initial_pull.head.sha)
  const expected_commit_count = __nonnegative_decimal(initial_pull?.commits)
  if expected_commit_count == nil || expected_commit_count == 0 {
    return connector_error(
      "invalid_response",
      "github.pr.commits response omitted a positive commit count",
    )
  }
  if expected_commit_count > 250 {
    return connector_error(
      "invalid_response",
      "github.pr.commits cannot prove completeness above GitHub's 250-commit pull-request limit",
    )
  }
  const expected_head_oid = trim(to_string(args?.expected_head_oid ?? ""))
  if expected_head_oid != "" && expected_head_oid != head_sha {
    return __stale_pr_head(expected_head_oid, head_sha)
  }
  const pages = __github_pr_commit_pages(harness, r, number, expected_commit_count, per_page, cfg)
  if is_err(pages) {
    return pages
  }
  const page_result = unwrap(pages)
  const commits: list<GithubPullRequestCommit> = page_result.commits
  const terminal_commit = commits[len(commits) - 1]
  if terminal_commit == nil {
    return connector_error(
      "invalid_response",
      "github.pr.commits could not resolve the terminal commit",
    )
  }
  const terminal_sha = terminal_commit.sha
  if terminal_sha != head_sha {
    return __stale_pr_head(head_sha, terminal_sha)
  }
  const final = __github_pull_identity(harness, r, number, cfg, "github.pr.commits")
  if is_err(final) {
    return final
  }
  const observed_head_oid = to_string(unwrap(final).head.sha)
  if observed_head_oid != head_sha {
    return __stale_pr_head(head_sha, observed_head_oid)
  }
  const observed_commit_count = __nonnegative_decimal(unwrap(final)?.commits)
  if observed_commit_count != expected_commit_count {
    return connector_error(
      "stale_head",
      "pull request commit count changed while reading canonical evidence",
      {
        expected_head_oid: head_sha,
        observed_head_oid: observed_head_oid,
        expected_commit_count: expected_commit_count,
        observed_commit_count: observed_commit_count,
      },
    )
  }
  const result: GithubPullRequestCommits = {
    repo: r.full_name,
    pull_number: number,
    head_ref: to_string(initial_pull.head.ref),
    head_sha: head_sha,
    total_count: expected_commit_count,
    commits: commits,
    pages_fetched: page_result.pages_fetched,
    per_page: per_page,
  }
  return result
}

fn __github_pr_commit_pages(harness: Harness, repo, number, expected_commit_count, per_page, cfg) {
  let commits: list<GithubPullRequestCommit> = []
  let seen_shas = {}
  let page = 1
  while page <= MAX_PULL_REQUEST_COMMIT_PAGES {
    const raw_page = __github_json(
      harness,
      "GET",
      __github_api_url(
        cfg.api_base_url,
        "/repos/" + repo.owner + "/" + repo.name + "/pulls/" + to_string(number)
          + "/commits?per_page="
          + to_string(per_page)
          + "&page="
          + to_string(page),
      ),
      nil,
      cfg,
    )
    if is_err(raw_page) {
      return raw_page
    }
    if type_of(raw_page) != "list" {
      return connector_error(
        "invalid_response",
        "github.pr.commits expected GitHub to return a commit list",
      )
    }
    for raw_commit in raw_page {
      const typed = __typed_pull_request_commit(repo.full_name, raw_commit)
      if is_err(typed) {
        return typed
      }
      const commit = unwrap(typed)
      if seen_shas.get(commit.sha) {
        return connector_error(
          "invalid_response",
          "github.pr.commits returned a duplicate commit across pages",
        )
      }
      seen_shas[commit.sha] = true
      commits = commits + [commit]
    }
    if len(commits) == expected_commit_count {
      break
    }
    if len(commits) > expected_commit_count || len(raw_page) < per_page {
      return connector_error(
        "invalid_response",
        "github.pr.commits pagination did not match the pull-request commit count",
      )
    }
    if page == MAX_PULL_REQUEST_COMMIT_PAGES {
      return connector_error(
        "invalid_response",
        "github.pr.commits exceeded the bounded pagination limit",
      )
    }
    page = page + 1
  }
  if len(commits) == 0 {
    return connector_error(
      "invalid_response",
      "github.pr.commits returned no commits for the pull request",
    )
  }
  return Ok({commits: commits, pages_fetched: page})
}

fn __github_pr_comment(harness: Harness, args, cfg) {
  const commented = __github_issue_comment(
    harness,
    args + {issue_number: args?.pr_number ?? args?.number ?? args?.pull_number},
    cfg,
  )
  if is_err(commented) {
    return commented
  }
  let result = commented + {pull_number: commented.issue_number}
  result.remove("issue_number")
  return result
}

fn __github_pr_checks(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  let head_sha = args?.head_sha ?? args?.sha
  const number = args?.pr_number ?? args?.number ?? args?.pull_number
  let pull = nil
  if (head_sha == nil || trim(to_string(head_sha)) == "") && number != nil {
    const fetched = __github_json(
      harness,
      "GET",
      __github_api_url(
        cfg.api_base_url,
        "/repos/" + r.owner + "/" + r.name + "/pulls/" + to_string(number),
      ),
      nil,
      cfg,
    )
    if is_err(fetched) {
      return fetched
    }
    pull = fetched
    head_sha = fetched?.head?.sha
  }
  if head_sha == nil || trim(to_string(head_sha)) == "" {
    return connector_error(
      "schema_drift",
      "github.pr.checks requires pr_number, number, pull_number, head_sha, or sha",
    )
  }
  const envelope = __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + r.owner + "/" + r.name + "/commits/" + to_string(head_sha) + "/check-runs"
        + __pagination_query(
        args,
      ),
    ),
    nil,
    cfg,
  )
  if is_err(envelope) {
    return envelope
  }
  const checks = __typed_check_runs(envelope?.check_runs ?? [])
  const rollup = __check_rollup(checks)
  return {
    repo: r.full_name,
    pull_number: number,
    head_sha: to_string(head_sha),
    state: __classify_pr_state(pull, rollup, nil),
    rollup: rollup,
    checks: checks,
  }
}

fn __github_pr_merge(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const number = args?.pr_number ?? args?.number ?? args?.pull_number
  if number == nil {
    return connector_error(
      "schema_drift",
      "github.pr.merge requires number, pr_number, or pull_number",
    )
  }
  const method = args?.method ?? args?.merge_method ?? args?.options?.merge_method ?? "merge"
  const options = args?.options ?? {}
  const merged = __pulls_merge_safe(
    harness,
    options
      + args
      + {owner: r.owner, repo: r.name, pull_number: number, merge_method: method},
    cfg,
  )
  if is_err(merged) {
    const err = unwrap_err(merged)
    if err?.category == "branch_protection"
      || err?.code == "protected_branch_requires_admin_override" {
      return connector_error("branch_protection", err?.message ?? "branch protection blocked merge")
    }
    return merged
  }
  return merged
    + {repo: r.full_name, pull_number: number, requested_method: method, state: "merged"}
}

