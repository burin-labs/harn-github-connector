/** Replace an exact release body under its observed release and tag leases. */
pub fn github_release_edit_body(
  harness: Harness,
  owner,
  repo,
  tag,
  body,
  lease,
  options = nil,
) -> GithubConnectorResult<GithubReleaseEditReceipt> {
  const opts = options ?? {}
  const result = call(
    harness,
    "github.release.edit_body",
    opts
      + {
      owner: owner,
      repo: repo,
      tag: tag,
      body: body,
      expected_release_id: lease?.release_id,
      expected_tag_ref_oid: lease?.tag_ref_oid,
      expected_tag_target_oid: lease?.tag_target_oid,
    },
  )
  if is_err(result) {
    return Err(unwrap_err(result))
  }
  const receipt: GithubReleaseEditReceipt = unwrap(result)
  return Ok(receipt)
}

