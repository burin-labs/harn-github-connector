/** List PRs in the same shape consumed by managed merge_captain. */
pub fn pulls_list_with_checks(
  harness: Harness,
  owner,
  repo,
  state = "open",
  limit = 100,
  options = nil,
) {
  const opts = options ?? {}
  return call(
    harness,
    "pulls.list_with_checks",
    opts + {owner: owner, repo: repo, state: state, limit: limit},
  )
}

/** Update the editable fields of one pull request. */
pub fn pulls_update(harness: Harness, owner, repo, number, edits, options = nil) {
  const opts = options ?? {}
  const body = pr_edit_body(edits ?? {})
  if is_err(body) {
    return body
  }
  return call(
    harness,
    "pulls.update",
    opts + unwrap(body) + {owner: owner, repo: repo, pull_number: number},
  )
}

/** Merge a PR after checking the base branch protection settings. */
pub fn pulls_merge_safe(harness: Harness, owner, repo, number, options = nil) {
  const opts = options ?? {}
  return call(harness, "pulls.merge_safe", opts + {owner: owner, repo: repo, pull_number: number})
}

/** Enable GitHub auto-merge for a PR through the GraphQL auto-merge mutation. */
pub fn pulls_enable_auto_merge(
  harness: Harness,
  owner,
  repo,
  number,
  options = nil,
) -> GithubConnectorResult<GithubAutoMergeReceipt> {
  const opts = options ?? {}
  const result = call(
    harness,
    "github.pr.enable_auto_merge",
    opts + {owner: owner, repo: repo, pull_number: number},
  )
  if is_err(result) {
    return Err(unwrap_err(result))
  }
  const receipt: GithubAutoMergeReceipt = unwrap(result)
  return Ok(receipt)
}

/** Hold a queued PR at an exact head while retaining its restoration method. */
pub fn pulls_disable_auto_merge(
  harness: Harness,
  owner,
  repo,
  number,
  options = nil,
) -> GithubConnectorResult<GithubAutoMergeDisableReceipt> {
  const opts = options ?? {}
  const result = call(
    harness,
    "github.pr.disable_auto_merge",
    opts + {owner: owner, repo: repo, pull_number: number},
  )
  if is_err(result) {
    return Err(unwrap_err(result))
  }
  const receipt: GithubAutoMergeDisableReceipt = unwrap(result)
  return Ok(receipt)
}

/**
 * Read every commit on one stable pull-request head, including normalized
 * GitHub signature verification evidence for each commit.
 */
pub fn github_pr_commits(
  harness: Harness,
  owner,
  repo,
  number,
  options = nil,
) -> GithubConnectorResult<GithubPullRequestCommits> {
  const opts = options ?? {}
  const result = call(
    harness,
    "github.pr.commits",
    opts + {owner: owner, repo: repo, pull_number: number},
  )
  if is_err(result) {
    return Err(unwrap_err(result))
  }
  const commits: GithubPullRequestCommits = unwrap(result)
  return Ok(commits)
}

/**
 * Atomically append a GitHub-signed commit to a branch. GitHub App callers
 * must not supply custom author, committer, or signature fields: GitHub then
 * signs the commit itself and marks it verified. `expected_head_oid` is the
 * publication lease and makes stale-head races fail closed.
 */
pub fn github_create_signed_commit(
  harness: Harness,
  request: GithubSignedCommitRequest,
  options = nil,
) -> GithubConnectorResult<GithubSignedCommitReceipt> {
  const opts = options ?? {}
  const result = call(
    harness,
    "github.branch.create_signed_commit",
    opts
      + {
      owner: request.owner,
      repo: request.repo,
      branch: request.branch,
      expected_head_oid: request.expected_head_oid,
      headline: request.headline,
      body: request.body,
      additions: request.additions,
      deletions: request.deletions,
    },
  )
  if is_err(result) {
    return Err(unwrap_err(result))
  }
  const receipt: GithubSignedCommitReceipt = unwrap(result)
  return Ok(receipt)
}

