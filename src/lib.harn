fn __github_actions_workflow_dispatch(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const workflow_id = args?.workflow_id ?? args?.workflow ?? args?.workflow_file
  if workflow_id == nil || trim(to_string(workflow_id)) == "" {
    return connector_error(
      "schema_drift",
      "github.actions.workflow_dispatch requires workflow_id, workflow, or workflow_file",
    )
  }
  const ref = args?.ref ?? args?.branch ?? "main"
  const resolved = github_dispatch_workflow_and_resolve_run(
    harness,
    r.owner,
    r.name,
    workflow_id,
    ref,
    args?.inputs ?? {},
    args,
  )
  if !resolved.ok {
    return Err(
      resolved?.error ?? {code: resolved.status, category: "workflow", message: resolved.status},
    )
  }
  const receipt = __typed_workflow_dispatch(r.full_name, ref, resolved)
  if is_err(receipt) {
    return receipt
  }
  return unwrap(receipt)
}

fn __github_actions_runs(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const per_page = if args?.per_page == nil {
    30
  } else {
    __positive_decimal(args.per_page, 100)
  }
  const page = if args?.page == nil {
    1
  } else {
    __positive_decimal(args.page, nil)
  }
  if per_page == nil {
    return connector_error(
      "schema_drift",
      "github.actions.runs per_page must be an integer from 1 to 100",
    )
  }
  if page == nil {
    return connector_error("schema_drift", "github.actions.runs page must be a positive integer")
  }
  const response = __actions_workflow_runs_list(harness, args + {owner: r.owner, repo: r.name}, cfg)
  if is_err(response) {
    return response
  }
  if type_of(response) != "dict" || response?.total_count == nil
    || type_of(response?.workflow_runs)
    != "list" {
    return connector_error(
      "invalid_response",
      "github.actions.runs expected total_count and workflow_runs",
    )
  }
  const total_count = __nonnegative_decimal(response.total_count)
  if total_count == nil {
    return connector_error(
      "invalid_response",
      "github.actions.runs expected a non-negative total_count",
    )
  }
  let runs: list<GithubWorkflowRun> = []
  for run in response.workflow_runs {
    const typed = __typed_workflow_run(r.full_name, run)
    if is_err(typed) {
      return typed
    }
    runs = runs + [unwrap(typed)]
  }
  const workflow_id = args?.workflow_id ?? args?.workflow ?? args?.workflow_file
  const result: GithubWorkflowRuns = {
    repo: r.full_name,
    workflow_id: if workflow_id == nil {
      nil
    } else {
      to_string(workflow_id)
    },
    total_count: total_count,
    runs: runs,
    page: page,
    per_page: per_page,
  }
  return result
}

