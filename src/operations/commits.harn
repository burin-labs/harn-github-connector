import "../client"
import "../contracts"
import { __err, __graphql_err } from "../errors"
import "./shared"

type SignedObject = {
  __typename: string,
  oid: string,
  url: string,
  tree: {oid: string},
  parents: {totalCount: int, nodes: list<{oid: string}>, pageInfo: {hasNextPage: bool}},
  signature: {isValid: bool, wasSignedByGitHub: bool, state: string}?,
}

type SignedObjectEnvelope = {data: {repository: {nameWithOwner: string, object: SignedObject?}?}?}

fn object_id(value: string) -> bool {
  return regex_match("^[0-9a-f]{40}$", value) && value != "0".repeat(40)
}

fn verified_github_signature(commit: any, surface: string) {
  const signature = commit?.signature
  if signature?.isValid != true || signature?.wasSignedByGitHub != true
    || signature?.state != "VALID" {
    return __err(
      "signature_invalid",
      surface + " did not return a valid GitHub-generated signature",
    )
  }
  return Ok(true)
}

/** One bounded read, with no mutation fallback when the exact object is unavailable. */
pub fn __github_read_signed_commit(harness: Harness, args: any, cfg: any) {
  const repository = __repo_parts(args)
  if is_err(repository) {
    return repository
  }
  const repo = unwrap(repository)
  const oid = args?.oid
  if type_of(oid) != "string" || !object_id(oid) {
    return __err("schema_drift", "signed commit read requires one exact nonzero commit oid")
  }
  const payload = __github_json(
    harness,
    "POST",
    __github_api_url(cfg.api_base_url, "/graphql"),
    {
      query: """
query HarnGithubConnectorSignedCommit($owner: String!, $repo: String!, $oid: GitObjectID!) {
  repository(owner: $owner, name: $repo) {
    nameWithOwner
    object(oid: $oid) {
      __typename
      ... on Commit {
        oid
        url
        tree { oid }
        parents(first: 20) {
          totalCount
          nodes { oid }
          pageInfo { hasNextPage }
        }
        signature { isValid state wasSignedByGitHub }
      }
    }
  }
}
""",
      variables: {owner: repo.owner, repo: repo.name, oid: oid},
    },
    cfg,
  )
  if is_err(payload) {
    return payload
  }
  if payload?.errors != nil && len(payload.errors) != 0 {
    return __graphql_err("github signed commit read", payload.errors)
  }
  if !schema_is(payload, SignedObjectEnvelope) {
    return __err("invalid_response", "signed commit read omitted complete object evidence")
  }
  const envelope: SignedObjectEnvelope = payload
  const observed = envelope.data?.repository
  const commit = observed?.object
  if observed == nil || commit == nil {
    return __err("not_found", "signed commit object is unavailable")
  }
  const parents = commit.parents.nodes.map({ parent -> parent.oid })
  if observed.nameWithOwner != repo.owner + "/" + repo.name || commit.__typename != "Commit"
    || commit.oid != oid
    || !object_id(commit.tree.oid)
    || commit.parents.totalCount < 0
    || commit.parents.totalCount > 20
    || commit.parents.pageInfo.hasNextPage
    || len(parents) != commit.parents.totalCount
    || len(set(parents)) != len(parents)
    || !parents.all({ parent -> object_id(parent) }) {
    return __err("invalid_response", "signed commit identity or complete parent inventory differs")
  }
  const signature = verified_github_signature(commit, "github signed commit read")
  if is_err(signature) {
    return signature
  }
  const result: GithubSignedCommitObservation = {
    repository: observed.nameWithOwner,
    oid: commit.oid,
    tree_oid: commit.tree.oid,
    parent_oids: parents,
    url: commit.url,
    signature_valid: true,
    signed_by_github: true,
    signature_state: commit.signature!.state,
  }
  return result
}

pub fn __typed_commit_signature(repo: any, commit: any, surface: any) {
  const verification = commit?.commit?.verification
  if type_of(commit) != "dict" || trim(to_string(commit?.sha ?? "")) == ""
    || type_of(verification)
      != "dict"
    || type_of(verification?.verified) != "bool"
    || trim(to_string(verification?.reason ?? "")) == "" {
    return __err("invalid_response", surface + " response omitted verification evidence")
  }
  const result: GithubCommitSignature = {
    repo: repo,
    sha: to_string(commit.sha),
    verified: verification.verified,
    reason: lowercase(to_string(verification.reason)),
    signature_present: verification?.signature != nil
      && trim(to_string(verification.signature)) != "",
    payload_present: verification?.payload != nil && trim(to_string(verification.payload)) != "",
    verified_at: verification?.verified_at,
  }
  return Ok(result)
}

pub fn __typed_pull_request_commit(repo: any, commit: any) {
  if type_of(commit) != "dict" || trim(to_string(commit?.sha ?? "")) == ""
    || commit?.commit?.message
      == nil {
    return __err("invalid_response", "github.pr.commits response omitted commit sha or message")
  }
  const signature = __typed_commit_signature(repo, commit, "github.pr.commits")
  if is_err(signature) {
    return signature
  }
  const result: GithubPullRequestCommit = {
    sha: to_string(commit.sha),
    message: to_string(commit.commit.message),
    signature: unwrap(signature),
  }
  return Ok(result)
}

pub fn __github_create_signed_commit(harness: Harness, args: any, cfg: any) {
  const owner = trim(to_string(args?.owner ?? ""))
  const repo = trim(to_string(args?.repo ?? ""))
  const branch = trim(to_string(args?.branch ?? ""))
  const expected_head_oid = trim(to_string(args?.expected_head_oid ?? args?.expectedHeadOid ?? ""))
  const headline = trim(to_string(args?.headline ?? ""))
  if owner == "" || repo == "" || branch == "" || expected_head_oid == "" || headline == "" {
    return __err(
      "schema_drift",
      "github.branch.create_signed_commit requires owner, repo, branch, expected_head_oid, and headline",
    )
  }
  const additions_result = __github_signed_commit_additions(args?.additions ?? [])
  if is_err(additions_result) {
    return additions_result
  }
  const additions = unwrap(additions_result)
  const deletions_result = __github_signed_commit_deletions(args?.deletions ?? [])
  if is_err(deletions_result) {
    return deletions_result
  }
  const deletions = unwrap(deletions_result)
  if len(additions) == 0 && len(deletions) == 0 {
    return __err(
      "schema_drift",
      "github.branch.create_signed_commit requires at least one file change",
    )
  }
  for addition in additions {
    for deletion in deletions {
      if addition.path == deletion.path {
        return __err(
          "schema_drift",
          "github.branch.create_signed_commit cannot add and delete the same path `"
            + addition.path
            + "`",
        )
      }
    }
  }
  let message = {headline: headline}
  const body = trim(to_string(args?.body ?? ""))
  if body != "" {
    message["body"] = body
  }
  const payload = __github_json(
    harness,
    "POST",
    __github_api_url(cfg.api_base_url, "/graphql"),
    {
      query: __create_commit_on_branch_mutation(),
      variables: {
        input: {
          branch: {repositoryNameWithOwner: owner + "/" + repo, branchName: branch},
          expectedHeadOid: expected_head_oid,
          message: message,
          fileChanges: {additions: additions, deletions: deletions},
        },
      },
    },
    cfg,
  )
  if is_err(payload) {
    return payload
  }
  if payload?.errors != nil && len(payload.errors) != 0 {
    return __graphql_err("github createCommitOnBranch", payload.errors)
  }
  const result = payload?.data?.createCommitOnBranch
  const commit = result?.commit
  if commit?.oid == nil || trim(to_string(commit.oid)) == "" {
    return __err("schema_drift", "github createCommitOnBranch returned no commit oid")
  }
  const verified = verified_github_signature(commit, "github createCommitOnBranch")
  if is_err(verified) {
    return verified
  }
  const receipt: GithubSignedCommitReceipt = {
    oid: to_string(commit.oid),
    url: to_string(commit.url ?? ""),
    branch: to_string(result?.ref?.name ?? branch),
    signature_valid: true,
    signed_by_github: true,
    signature_state: to_string(commit.signature.state),
  }
  return receipt
}

fn __github_signed_commit_additions(raw: any) {
  let additions = []
  let seen = {}
  for item in raw {
    const path = trim(to_string(item?.path ?? ""))
    const raw_contents = item?.contents_base64 ?? item?.contents
    if path == "" || raw_contents == nil {
      return __err("schema_drift", "signed commit additions require path and contents_base64")
    }
    const contents = trim(to_string(raw_contents))
    if seen.get(path) ?? false {
      return __err("schema_drift", "signed commit additions contain duplicate path `" + path + "`")
    }
    seen[path] = true
    additions = additions + [{path: path, contents: contents}]
  }
  return Ok(additions)
}

fn __github_signed_commit_deletions(raw: any) {
  let deletions = []
  let seen = {}
  for item in raw {
    const path = trim(to_string(item?.path ?? ""))
    if path == "" {
      return __err("schema_drift", "signed commit deletions require path")
    }
    if seen.get(path) ?? false {
      return __err("schema_drift", "signed commit deletions contain duplicate path `" + path + "`")
    }
    seen[path] = true
    deletions = deletions + [{path: path}]
  }
  return Ok(deletions)
}

fn __create_commit_on_branch_mutation() {
  return """
mutation HarnGithubConnectorCreateCommitOnBranch($input: CreateCommitOnBranchInput!) {
  createCommitOnBranch(input: $input) {
    commit {
      oid
      url
      signature {
        isValid
        state
        wasSignedByGitHub
      }
    }
    ref {
      name
      target {
        oid
      }
    }
  }
}
"""
}
