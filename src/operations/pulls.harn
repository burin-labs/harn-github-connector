pub fn __github_merge_queue_entries(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const branch = args?.branch ?? args?.base_branch ?? args?.base
  if branch == nil || trim(to_string(branch)) == "" {
    return __err("merge_queue", "github.merge_queue.entries requires branch or base_branch")
  }
  const limit = to_int(args?.limit ?? args?.per_page ?? 100)
  if limit == nil || limit < 1 || limit > 100 {
    return __err("schema_drift", "github.merge_queue.entries limit must be from 1 to 100")
  }
  const response = __github_json(
    harness,
    "POST",
    __github_api_url(cfg.api_base_url, "/graphql"),
    {
      query: __merge_queue_entries_query(),
      variables: {owner: r.owner, repo: r.name, branch: to_string(branch), limit: limit},
    },
    cfg,
  )
  if is_err(response) {
    return response
  }
  if response?.errors != nil && len(response.errors) > 0 {
    return __err(
      "graphql",
      "github merge queue query returned errors: " + json_stringify(response.errors),
    )
  }
  const repository = response?.data?.repository
  if type_of(repository) != "dict" {
    return __err("invalid_response", "github merge queue response omitted repository evidence")
  }
  const queue = repository?.mergeQueue
  if queue == nil {
    const absent: GithubMergeQueueEntries = {
      repo: r.full_name,
      branch: to_string(branch),
      configured: false,
      url: nil,
      entries: [],
    }
    return absent
  }
  const nodes = queue?.entries?.nodes
  if type_of(nodes) != "list" {
    return __err("invalid_response", "github merge queue response omitted entries.nodes")
  }
  let entries: list<GithubMergeQueueEntry> = []
  for entry in nodes {
    const typed = __typed_merge_queue_entry(entry)
    if is_err(typed) {
      return typed
    }
    entries = entries + [unwrap(typed)]
  }
  const result: GithubMergeQueueEntries = {
    repo: r.full_name,
    branch: to_string(branch),
    configured: true,
    url: to_string(queue?.url ?? ""),
    entries: entries,
  }
  return result
}

pub fn __github_merge_queue_membership(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const number = args?.pr_number ?? args?.number ?? args?.pull_number
  if number == nil {
    return __err(
      "schema_drift",
      "github.merge_queue.membership requires pr_number, number, or pull_number",
    )
  }
  let pull = args?.pull
  if pull == nil {
    pull = __github_json(
      harness,
      "GET",
      __github_api_url(
        cfg.api_base_url,
        "/repos/" + r.owner + "/" + r.name + "/pulls/" + to_string(number),
      ),
      nil,
      cfg,
    )
    if is_err(pull) {
      return pull
    }
  }
  const valid = __validate_pull_identity(pull, "github.merge_queue.membership")
  if is_err(valid) {
    return valid
  }
  const response = __github_json(
    harness,
    "POST",
    __github_api_url(cfg.api_base_url, "/graphql"),
    {
      query: __merge_queue_membership_query(),
      variables: {owner: r.owner, repo: r.name, number: to_int(number)},
    },
    cfg,
  )
  if is_err(response) {
    return response
  }
  if response?.errors != nil && len(response.errors) > 0 {
    return __err(
      "graphql",
      "github merge queue membership returned errors: " + json_stringify(response.errors),
    )
  }
  const node = response?.data?.repository?.pullRequest
  if node?.number == nil || to_int(node.number) != to_int(number) {
    return __err(
      "invalid_response",
      "github merge queue membership omitted the requested pull request",
    )
  }
  let entry = nil
  if node?.mergeQueueEntry != nil {
    const typed = __typed_merge_queue_entry(node.mergeQueueEntry)
    if is_err(typed) {
      return typed
    }
    entry = unwrap(typed)
  }
  const membership: GithubMergeQueueMembership = {
    repo: r.full_name,
    pull_number: to_int(number),
    available: true,
    queued: entry != nil,
    auto_merge_armed: node?.autoMergeRequest != nil || pull?.auto_merge != nil,
    auto_merge_method: if node?.autoMergeRequest?.mergeMethod != nil {
      uppercase(to_string(node.autoMergeRequest.mergeMethod))
    } else if pull?.auto_merge?.merge_method != nil {
      uppercase(to_string(pull.auto_merge.merge_method))
    } else {
      nil
    },
    entry: entry,
    error: nil,
  }
  return membership
}

pub fn __github_merge_queue_enqueue(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const number = args?.pr_number ?? args?.number ?? args?.pull_number
  if number == nil {
    return __err(
      "merge_queue",
      "github.merge_queue.enqueue requires pr_number, number, or pull_number",
    )
  }
  const expected_head_oid = trim(to_string(args?.expected_head_oid ?? args?.expectedHeadOid ?? ""))
  if expected_head_oid == "" {
    return __err("schema_drift", "github.merge_queue.enqueue requires expected_head_oid")
  }
  const pull = __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + r.owner + "/" + r.name + "/pulls/" + to_string(number),
    ),
    nil,
    cfg,
  )
  if is_err(pull) {
    return pull
  }
  const valid = __validate_pull_identity(pull, "github.merge_queue.enqueue")
  if is_err(valid) {
    return valid
  }
  if to_string(pull?.head?.sha ?? "") != expected_head_oid {
    return __err(
      "stale_head",
      "pull request head no longer matches expected_head_oid",
      {expected_head_oid: expected_head_oid, observed_head_oid: pull?.head?.sha},
    )
  }
  if trim(to_string(pull?.node_id ?? "")) == "" {
    return __err(
      "invalid_response",
      "github.merge_queue.enqueue response omitted pull request node_id",
    )
  }
  const response = __github_json(
    harness,
    "POST",
    __github_api_url(cfg.api_base_url, "/graphql"),
    {
      query: __enqueue_pull_request_mutation(),
      variables: {
        input: {
          pullRequestId: pull.node_id,
          expectedHeadOid: expected_head_oid,
          jump: args?.jump ?? false,
        },
      },
    },
    cfg,
  )
  if is_err(response) {
    return response
  }
  if response?.errors != nil && len(response.errors) > 0 {
    if __graphql_errors_indicate_stale_head(response.errors) {
      return __err(
        "stale_head",
        "GitHub rejected merge queue enqueue because the pull request head changed",
      )
    }
    return __err(
      "graphql",
      "github merge queue enqueue returned errors: " + json_stringify(response.errors),
    )
  }
  const entry = __typed_merge_queue_entry(response?.data?.enqueuePullRequest?.mergeQueueEntry)
  if is_err(entry) {
    return entry
  }
  const receipt: GithubMergeQueueEnqueueReceipt = {
    repo: r.full_name,
    pull_number: to_int(number),
    expected_head_oid: expected_head_oid,
    entry: unwrap(entry),
  }
  return receipt
}

pub fn __github_issue_create(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  return __github_json(
    harness,
    "POST",
    __github_api_url(cfg.api_base_url, "/repos/" + r.owner + "/" + r.name + "/issues"),
    __body_without(
      args,
      __request_context_keys()
        + ["repo", "repository", "repo_ref", "repo_full_name", "owner"],
    ),
    cfg,
  )
}

pub fn __github_issue_comment(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const number = args?.issue_number ?? args?.number ?? args?.pr_number ?? args?.pull_number
  if number == nil {
    return __err(
      "schema_drift",
      "github issue comment helpers require issue_number, number, pr_number, or pull_number",
    )
  }
  if trim(to_string(args?.body ?? "")) == "" {
    return __err("schema_drift", "github issue comment helpers require a non-empty body")
  }
  const comment = __github_json(
    harness,
    "POST",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + r.owner + "/" + r.name + "/issues/" + to_string(number) + "/comments",
    ),
    {body: args?.body},
    cfg,
  )
  if is_err(comment) {
    return comment
  }
  if comment?.id == nil || comment?.body == nil {
    return __err("invalid_response", "github comment response omitted id or body")
  }
  return {
    repo: r.full_name,
    issue_number: to_int(number),
    id: comment.id,
    body: to_string(comment.body),
    url: to_string(comment?.html_url ?? comment?.url ?? ""),
    user: __typed_user(comment?.user),
    created_at: comment?.created_at,
    updated_at: comment?.updated_at,
  }
}

pub fn __github_branch_protection(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const branch = args?.branch ?? args?.base_branch ?? args?.base
  const protection = __github_branch_protection_raw(harness, r, branch, cfg)
  if is_err(protection) {
    return protection
  }
  return __branch_protection_summary(unwrap(protection), branch)
}

pub fn __issues_create_with_template(harness: Harness, args, cfg) {
  const template = args?.template ?? {}
  const title_template = if type_of(template) == "dict" {
    template?.title ?? args?.title_template ?? args?.title ?? "Merge Captain follow-up"
  } else {
    args?.title_template ?? args?.title ?? "Merge Captain follow-up"
  }
  const body_template = if type_of(template) == "dict" {
    template?.body ?? args?.body_template ?? ""
  } else {
    to_string(template)
  }
  let body = {
    title: __render_template(title_template, args?.vars ?? {}),
    body: __render_template(body_template, args?.vars ?? {}),
  }
  const labels = args?.labels
    ?? if type_of(template) == "dict" {
    template?.labels
  } else {
    nil
  }
  if labels != nil {
    body["labels"] = labels
  }
  const assignees = args?.assignees
    ?? if type_of(template) == "dict" {
    template?.assignees
  } else {
    nil
  }
  if assignees != nil {
    body["assignees"] = assignees
  }
  const milestone = args?.milestone
    ?? if type_of(template) == "dict" {
    template?.milestone
  } else {
    nil
  }
  if milestone != nil {
    body["milestone"] = milestone
  }
  return __github_json(
    harness,
    "POST",
    __github_api_url(cfg.api_base_url, "/repos/" + args.owner + "/" + args.repo + "/issues"),
    body,
    cfg,
  )
}

pub fn __pulls_list_with_checks(harness: Harness, args, cfg) {
  const graph = __github_json(
    harness,
    "POST",
    __github_api_url(cfg.api_base_url, "/graphql"),
    {
      query: __pulls_with_checks_query(),
      variables: {
        owner: args.owner,
        repo: args.repo,
        states: [uppercase(args?.state ?? "OPEN")],
        limit: min(max(to_int(args?.limit ?? 100) ?? 100, 1), 100),
        checkLimit: min(max(to_int(args?.check_limit ?? 50) ?? 50, 1), 100),
      },
    },
    cfg,
  )
  if is_err(graph) {
    return graph
  }
  const payload = graph
  if payload?.errors != nil && len(payload.errors) > 0 {
    return __err("graphql", "github GraphQL returned errors: " + json_stringify(payload.errors))
  }
  const nodes = payload?.data?.repository?.pullRequests?.nodes ?? []
  let pulls = []
  for node in nodes {
    pulls = pulls + [__normalize_graphql_pr(node)]
  }
  return pulls
}

pub fn __pulls_merge_safe(harness: Harness, args, cfg) {
  const pull = __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + args.owner + "/" + args.repo + "/pulls/" + to_string(args.pull_number),
    ),
    nil,
    cfg,
  )
  if is_err(pull) {
    return pull
  }
  const base_branch = pull?.base?.ref ?? args?.base_branch
  const protection_result = __github_branch_protection_raw(
    harness,
    {owner: to_string(args.owner), name: to_string(args.repo)},
    base_branch,
    cfg,
  )
  if is_err(protection_result) {
    return protection_result
  }
  const protection = unwrap(protection_result)
  const protected = protection != nil
  if protected && !(args?.admin_override ?? false) {
    return __err(
      "protected_branch_requires_admin_override",
      "base branch `" + to_string(base_branch)
        + "` is protected; pass admin_override to merge through it",
    )
  }
  const merged = __github_json(
    harness,
    "PUT",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + args.owner + "/" + args.repo + "/pulls/" + to_string(args.pull_number) + "/merge",
    ),
    __merge_body(args, pull),
    cfg,
  )
  if is_err(merged) {
    return merged
  }
  let result = {
    pull_request: pull,
    protected: protected,
    branch_protection: protection,
    merge: __merge_annotation(merged, args),
  }
  if args?.delete_branch ?? false {
    const deleted = __delete_pull_head_branch(harness, args, pull, cfg)
    if is_err(deleted) {
      return deleted
    }
    result["delete_branch"] = deleted
  }
  return result
}

fn __pulls_enable_auto_merge(harness: Harness, args, cfg) {
  const expected_head_oid = trim(to_string(args?.expected_head_oid ?? args?.expectedHeadOid ?? ""))
  if expected_head_oid == "" {
    return __err(
      "schema_drift",
      "github.pr.enable_auto_merge requires expected_head_oid as an explicit publication lease",
    )
  }
  const pull = __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + args.owner + "/" + args.repo + "/pulls/" + to_string(args.pull_number),
    ),
    nil,
    cfg,
  )
  if is_err(pull) {
    return pull
  }
  const valid = __validate_pull_identity(pull, "github.pr.enable_auto_merge")
  if is_err(valid) {
    return valid
  }
  const observed_head_oid = trim(to_string(pull?.head?.sha ?? ""))
  if observed_head_oid != expected_head_oid {
    return __err(
      "stale_head",
      "pull request head no longer matches expected_head_oid",
      {expected_head_oid: expected_head_oid, observed_head_oid: observed_head_oid},
    )
  }
  const method = __graphql_merge_method(args?.method ?? args?.merge_method ?? "MERGE")
  if is_err(method) {
    return method
  }
  if pull?.auto_merge != nil {
    return {
      repo: to_string(args.owner) + "/" + to_string(args.repo),
      pull_number: args.pull_number,
      state: "already_enabled",
      already_enabled: true,
      expected_head_oid: expected_head_oid,
      observed_head_oid: observed_head_oid,
      merge_method: uppercase(to_string(pull?.auto_merge?.merge_method ?? unwrap(method))),
      url: to_string(pull?.html_url ?? pull?.url ?? ""),
    }
  }
  const node_id = pull?.node_id
  if node_id == nil || trim(to_string(node_id)) == "" {
    return __err("schema_drift", "GitHub PR response did not include node_id for auto-merge")
  }
  const graph = __github_json(
    harness,
    "POST",
    __github_api_url(cfg.api_base_url, "/graphql"),
    {
      query: __enable_auto_merge_mutation(),
      variables: {
        pullRequestId: node_id,
        mergeMethod: unwrap(method),
        commitHeadline: args?.commit_headline ?? args?.commit_title,
        commitBody: args?.commit_body ?? args?.commit_message,
        expectedHeadOid: expected_head_oid,
      },
    },
    cfg,
  )
  if is_err(graph) {
    return graph
  }
  if graph?.errors != nil && len(graph.errors) > 0 {
    if __graphql_errors_indicate_stale_head(graph.errors) {
      return __err(
        "stale_head",
        "GitHub rejected auto-merge because the pull request head changed",
        {expected_head_oid: expected_head_oid, observed_head_oid: observed_head_oid},
      )
    }
    return __err("graphql", "github GraphQL returned errors: " + json_stringify(graph.errors))
  }
  const enabled = graph?.data?.enablePullRequestAutoMerge
  const enabled_pull = enabled?.pullRequest
  if enabled_pull?.number == nil || enabled_pull?.autoMergeRequest == nil {
    return __err("invalid_response", "GitHub auto-merge response omitted pull request evidence")
  }
  return {
    repo: to_string(args.owner) + "/" + to_string(args.repo),
    pull_number: args.pull_number,
    state: "enabled",
    already_enabled: false,
    expected_head_oid: expected_head_oid,
    observed_head_oid: observed_head_oid,
    merge_method: uppercase(
      to_string(enabled_pull?.autoMergeRequest?.mergeMethod ?? unwrap(method)),
    ),
    url: to_string(enabled_pull?.url ?? pull?.html_url ?? ""),
  }
}

fn __reenable_after_lost_disable(harness: Harness, cfg, node_id, head_oid, method) {
  if trim(to_string(head_oid ?? "")) == "" {
    return {ok: false, detail: "post-mutation pull response omitted the head needed to compensate"}
  }
  const graph = __github_json(
    harness,
    "POST",
    __github_api_url(cfg.api_base_url, "/graphql"),
    {
      query: __enable_auto_merge_mutation(),
      variables: {
        pullRequestId: node_id,
        mergeMethod: method,
        commitHeadline: nil,
        commitBody: nil,
        expectedHeadOid: head_oid,
      },
    },
    cfg,
  )
  if is_err(graph) {
    return {ok: false, detail: to_string(unwrap_err(graph)?.message ?? unwrap_err(graph))}
  }
  if graph?.errors != nil && len(graph.errors) > 0 {
    return {ok: false, detail: json_stringify(graph.errors)}
  }
  if graph?.data?.enablePullRequestAutoMerge?.pullRequest?.autoMergeRequest == nil {
    return {ok: false, detail: "compensating enable omitted auto-merge evidence"}
  }
  return {ok: true, detail: "restored auto-merge at the post-mutation head"}
}

fn __fail_uncertain_disable(harness: Harness, args, cfg, node_id, method, reason) {
  const pull = __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + args.owner + "/" + args.repo + "/pulls/" + to_string(args.pull_number),
    ),
    nil,
    cfg,
  )
  if is_err(pull) {
    return __err(
      "disable_unverified",
      reason + "; could not observe or compensate the uncertain mutation",
      {compensation_state: "failed", compensation_message: to_string(unwrap_err(pull))},
    )
  }
  if pull?.auto_merge != nil {
    return __err(
      "disable_unverified",
      reason + "; auto-merge remained armed",
      {compensation_state: "not_needed", compensation_message: "auto-merge remained armed"},
    )
  }
  const observed_head_oid = trim(to_string(pull?.head?.sha ?? ""))
  const compensated = __reenable_after_lost_disable(
    harness,
    cfg,
    node_id,
    observed_head_oid,
    method,
  )
  return __err(
    "disable_unverified",
    reason + "; " + compensated.detail,
    {
      observed_head_oid: observed_head_oid,
      compensation_state: if compensated.ok {
        "restored"
      } else {
        "failed"
      },
      compensation_message: compensated.detail,
    },
  )
}

fn __pulls_disable_auto_merge(harness: Harness, args, cfg) {
  const expected_head_oid = trim(to_string(args?.expected_head_oid ?? ""))
  const base_branch = trim(to_string(args?.base_branch ?? ""))
  const expected_base_oid = trim(to_string(args?.expected_base_oid ?? ""))
  const method = __graphql_merge_method(args?.restore_merge_method ?? "")
  if expected_head_oid == "" || base_branch == "" || expected_base_oid == "" {
    return __err(
      "schema_drift",
      "github.pr.disable_auto_merge requires expected_head_oid, base_branch, and expected_base_oid",
    )
  }
  if is_err(method) {
    return method
  }
  const restore_merge_method = unwrap(method)
  const repo = {owner: to_string(args.owner), name: to_string(args.repo)}
  const base = __github_branch_head_raw(harness, repo, base_branch, cfg)
  if is_err(base) {
    return base
  }
  const observed_base_oid = unwrap(base).oid
  if observed_base_oid != expected_base_oid {
    return __err(
      "stale_base",
      "base branch no longer matches expected_base_oid",
      {expected_base_oid: expected_base_oid, observed_base_oid: observed_base_oid},
    )
  }
  const pull = __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + args.owner + "/" + args.repo + "/pulls/" + to_string(args.pull_number),
    ),
    nil,
    cfg,
  )
  if is_err(pull) {
    return pull
  }
  const valid = __validate_pull_identity(pull, "github.pr.disable_auto_merge")
  if is_err(valid) {
    return valid
  }
  const observed_head_oid = trim(to_string(pull?.head?.sha ?? ""))
  if observed_head_oid != expected_head_oid {
    return __err(
      "stale_head",
      "pull request head no longer matches expected_head_oid",
      {expected_head_oid: expected_head_oid, observed_head_oid: observed_head_oid},
    )
  }
  if trim(to_string(pull?.base?.ref ?? "")) != base_branch {
    return __err("stale_base", "pull request base branch no longer matches base_branch")
  }
  const receipt = {
    repo: to_string(args.owner) + "/" + to_string(args.repo),
    pull_number: args.pull_number,
    expected_head_oid: expected_head_oid,
    observed_head_oid: observed_head_oid,
    base_branch: base_branch,
    expected_base_oid: expected_base_oid,
    observed_base_oid: observed_base_oid,
    restore_merge_method: restore_merge_method,
    url: to_string(pull?.html_url ?? pull?.url ?? ""),
  }
  if pull?.auto_merge == nil {
    return receipt + {state: "already_disabled", already_disabled: true}
  }
  const node_id = trim(to_string(pull?.node_id ?? ""))
  if node_id == "" {
    return __err("schema_drift", "GitHub PR response omitted node_id for auto-merge disable")
  }
  const graph = __github_json(
    harness,
    "POST",
    __github_api_url(cfg.api_base_url, "/graphql"),
    {query: __disable_auto_merge_mutation(), variables: {pullRequestId: node_id}},
    cfg,
  )
  if is_err(graph) {
    return __fail_uncertain_disable(
      harness,
      args,
      cfg,
      node_id,
      restore_merge_method,
      "GitHub auto-merge disable request failed without terminal evidence",
    )
  }
  if graph?.errors != nil && len(graph.errors) > 0 {
    return __fail_uncertain_disable(
      harness,
      args,
      cfg,
      node_id,
      restore_merge_method,
      "GitHub auto-merge disable returned errors: " + json_stringify(graph.errors),
    )
  }
  const disabled_pull = graph?.data?.disablePullRequestAutoMerge?.pullRequest
  if disabled_pull?.number != args.pull_number || disabled_pull?.autoMergeRequest != nil {
    return __fail_uncertain_disable(
      harness,
      args,
      cfg,
      node_id,
      restore_merge_method,
      "GitHub auto-merge disable omitted terminal pull evidence",
    )
  }
  const post_head_oid = trim(to_string(disabled_pull?.headRefOid ?? ""))
  const post_base_branch = trim(to_string(disabled_pull?.baseRefName ?? ""))
  const post_base = __github_branch_head_raw(harness, repo, base_branch, cfg)
  const post_base_oid = if !is_err(post_base) {
    unwrap(post_base).oid
  } else {
    ""
  }
  if post_head_oid != expected_head_oid || post_base_branch != base_branch
    || post_base_oid
    != expected_base_oid {
    const compensated = __reenable_after_lost_disable(
      harness,
      cfg,
      node_id,
      post_head_oid,
      restore_merge_method,
    )
    return __err(
      if post_head_oid != expected_head_oid {
        "stale_head"
      } else {
        "stale_base"
      },
      "release queue lease changed during auto-merge disable; " + compensated.detail,
      {
        expected_head_oid: expected_head_oid,
        observed_head_oid: post_head_oid,
        expected_base_oid: expected_base_oid,
        observed_base_oid: post_base_oid,
        compensation_state: if compensated.ok {
          "restored"
        } else {
          "failed"
        },
        compensation_message: compensated.detail,
      },
    )
  }
  const typed: GithubAutoMergeDisableReceipt = receipt
    + {state: "disabled", already_disabled: false}
  return typed
}

pub fn __repos_commit_pulls(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const sha = args?.sha ?? args?.commit_sha
  if sha == nil || trim(to_string(sha)) == "" {
    return __err("schema_drift", "repos.commit_pulls requires `sha`")
  }
  return __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + r.owner + "/" + r.name + "/commits/" + url_encode(to_string(sha)) + "/pulls"
        + __pagination_query(
        args,
      ),
    ),
    nil,
    cfg,
  )
}

const DEFAULT_MERGEABLE_MAX_ATTEMPTS = 4

const DEFAULT_MERGEABLE_POLL_INTERVAL_MS = 1500

/**
 * Resolve a PR's async-computed `mergeable`/`mergeable_state` by GETting the
 * single-PR endpoint (which triggers the background computation) and polling
 * with bounded backoff while `mergeable` is null or `mergeable_state` is
 * "unknown". Returns a typed mergeability result. The poll bound is
 * `max_attempts` (default 4) with
 * `poll_interval_ms` (default 1500ms) between attempts.
 */
@complexity(allow)
pub fn __pull_requests_resolve_mergeable(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return __mergeable_envelope(false, nil, "unknown", 0, false, nil, unwrap_err(repo))
  }
  const r = unwrap(repo)
  const number = args?.pull_number ?? args?.number ?? args?.pr_number
  if number == nil {
    return __mergeable_envelope(
      false,
      nil,
      "unknown",
      0,
      false,
      nil,
      {
        code: "schema_drift",
        category: "schema_drift",
        message: "resolve_mergeable requires pull_number",
      },
    )
  }
  const polling = args?.polling ?? {}
  const max_attempts = max(1, __positive_int(polling?.max_attempts, DEFAULT_MERGEABLE_MAX_ATTEMPTS))
  const poll_interval = __positive_int(polling?.interval_ms, DEFAULT_MERGEABLE_POLL_INTERVAL_MS)
  const url = __github_api_url(
    cfg.api_base_url,
    "/repos/" + r.owner + "/" + r.name + "/pulls/" + to_string(number),
  )
  let attempt = 0
  let last = nil
  while attempt < max_attempts {
    attempt = attempt + 1
    const pull = __github_json(harness, "GET", url, nil, cfg)
    if is_err(pull) {
      return __mergeable_envelope(false, nil, "unknown", attempt, false, nil, unwrap_err(pull))
    }
    last = pull
    const mergeable = pull?.mergeable
    const state = pull?.mergeable_state ?? "unknown"
    if mergeable != nil && state != "unknown" {
      return __mergeable_envelope(true, mergeable, state, attempt, true, pull, nil)
    }
    if attempt < max_attempts && poll_interval > 0 {
      harness.clock.sleep_ms(poll_interval)
    }
  }
  return __mergeable_envelope(
    true,
    last?.mergeable,
    last?.mergeable_state ?? "unknown",
    attempt,
    false,
    last,
    nil,
  )
}

fn __mergeable_envelope(ok, mergeable, mergeable_state, attempts, resolved, raw, error) {
  if !ok {
    return Err(error)
  }
  const value: GithubMergeability = {
    mergeable: mergeable,
    mergeable_state: mergeable_state,
    is_conflict: mergeable_state == "dirty",
    attempts: attempts,
    resolved: resolved,
    raw: raw,
  }
  return value
}

fn __render_template(template, vars) {
  let rendered = to_string(template ?? "")
  for entry in (vars ?? {}).entries() {
    const value = to_string(entry.value ?? "")
    rendered = rendered.replace("{{" + to_string(entry.key) + "}}", value)
    rendered = rendered.replace("${" + to_string(entry.key) + "}", value)
  }
  return rendered
}

fn __graphql_errors_indicate_stale_head(errors) {
  const message = lowercase(json_stringify(errors ?? []))
  return contains(message, "expected head") || contains(message, "expectedheadoid")
    || contains(
    message,
    "head oid",
  )
    || contains(message, "head sha")
}
