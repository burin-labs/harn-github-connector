import "../client"
import "../contracts"
import { __err } from "../errors"
import "./shared"

/**
 * Refusals from `POST /git/refs` that might mean the ref is already there.
 *
 * 422 is what GitHub returns for a taken ref today, verified against the live
 * API. 409 is what its create contract documents for the same case, and a claim
 * that treats a documented status as an unknown failure reports contention as
 * an unreadable lock — the one answer a caller cannot act on. Both statuses buy
 * a read-back, and the read-back is what decides.
 */
const CLAIM_CONTENTION_STATUSES = [409, 422]

const CLAIM_READ_BACK_MAX_ATTEMPTS = 3

const CLAIM_READ_BACK_DELAY_MS = 100

/**
 * Claim one ref for an exact object, atomically.
 *
 * `POST /git/refs` is the only GitHub primitive that serializes across
 * machines: it either creates the ref or fails, and no caller can observe a
 * half-created one. Every softer check — read then write, or ask whether a tag
 * or PR already claims the work — has a window where two agents both decide
 * they are alone.
 *
 * No status answers "is it taken". GitHub returns 422 for a taken ref today,
 * and spends that same status on a malformed ref name and a missing object; the
 * documented create contract also lists 409. Reading the ref back is what
 * separates them: if it resolves, someone holds it; if it does not, the refusal
 * meant something else and stays an error. The status only decides whether the
 * read-back is worth a round trip.
 */
pub fn __github_ref_claim(harness: Harness, args: any, cfg: any) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const ref = trim(to_string(args?.ref ?? ""))
  if !starts_with(ref, "refs/") {
    return __err("schema_drift", "github.ref.claim requires a fully qualified `refs/...` ref")
  }
  const minted = __github_claim_object(harness, r, args, cfg)
  if is_err(minted) {
    return minted
  }
  const oid = unwrap(minted)
  const created = __github_json(
    harness,
    "POST",
    __github_api_url(cfg.api_base_url, "/repos/" + r.owner + "/" + r.name + "/git/refs"),
    {ref: ref, sha: oid},
    cfg,
  )
  if !is_err(created) {
    const won: GithubRefClaim = {
      repo: r.full_name,
      ref: ref,
      oid: oid,
      claimed: true,
      holder_headline: "",
    }
    return won
  }
  const failure = unwrap_err(created)
  if !CLAIM_CONTENTION_STATUSES.contains(failure?.http_status ?? 0) {
    return Err(failure)
  }
  const existing = __github_ref_after_contention(harness, r, ref, cfg)
  if is_err(existing) {
    return Err(failure)
  }
  const holder = unwrap(existing)
  const lost: GithubRefClaim = {
    repo: r.full_name,
    ref: ref,
    oid: holder.oid,
    claimed: false,
    holder_headline: __github_commit_headline(harness, r, holder, cfg),
  }
  return lost
}

/**
 * Read a lost claim through GitHub's short ref-propagation window.
 *
 * The create endpoint is authoritative that somebody won, but a GET routed to
 * another replica can briefly return 404. The harness clock keeps this bounded
 * delay instant under test-time virtualization. Any non-404 failure stops the
 * retry, and the caller preserves the original create refusal if no holder
 * becomes visible.
 */
fn __github_ref_after_contention(harness: Harness, repo: any, ref: string, cfg: any) {
  let observed = nil
  for attempt in range(0, CLAIM_READ_BACK_MAX_ATTEMPTS) {
    observed = __github_ref_object(harness, repo, ref, cfg)
    if !is_err(observed) {
      return observed
    }
    const status = unwrap_err(observed)?.http_status ?? 0
    if status != 404 || attempt + 1 >= CLAIM_READ_BACK_MAX_ATTEMPTS {
      return observed
    }
    harness.clock.sleep_ms(CLAIM_READ_BACK_DELAY_MS)
  }
  return observed
}

fn __github_ref_object(harness: Harness, repo: any, ref: string, cfg: any) {
  const value = __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + repo.owner + "/" + repo.name + "/git/ref/" + regex_replace("^refs/", "", ref),
    ),
    nil,
    cfg,
  )
  if is_err(value) {
    return value
  }
  const oid = trim(to_string(value?.object?.sha ?? ""))
  if oid == "" {
    return __err("invalid_response", "GitHub ref response omitted object.sha")
  }
  return {oid: oid, type: trim(to_string(value?.object?.type ?? ""))}
}

/**
 * The holder's first message line, or empty when there is nothing to read.
 *
 * A missing headline never fails the claim: `claimed` is the answer the caller
 * acted on, and a lock whose payload has been garbage collected is still held.
 */
fn __github_commit_headline(harness: Harness, repo: any, holder: any, cfg: any) -> string {
  if holder.type != "commit" {
    return ""
  }
  const value = __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + repo.owner + "/" + repo.name + "/git/commits/" + holder.oid,
    ),
    nil,
    cfg,
  )
  if is_err(value) {
    return ""
  }
  return trim(split(to_string(value?.message ?? ""), "\n")[0] ?? "")
}

/**
 * The object this claim will point at: the caller's oid, or one minted here.
 *
 * Exactly one of `oid` and `payload` is meaningful. A caller with neither is
 * asking for a ref to nothing, which is the schema error it looks like.
 */
fn __github_claim_object(harness: Harness, repo: any, args: any, cfg: any) {
  const oid = trim(to_string(args?.oid ?? args?.sha ?? ""))
  if oid != "" {
    return Ok(oid)
  }
  const payload = args?.payload
  const message = trim(to_string(payload?.message ?? ""))
  const base_ref = trim(to_string(payload?.base_ref ?? ""))
  if type_of(payload) != "dict" || message == "" || base_ref == "" {
    return __err(
      "schema_drift",
      "github.ref.claim requires an `oid`, or a `payload` with `message` and `base_ref`",
    )
  }
  const base = __github_ref_object(harness, repo, base_ref, cfg)
  if is_err(base) {
    return base
  }
  const tree = __github_commit_tree(harness, repo, unwrap(base).oid, cfg)
  if is_err(tree) {
    return tree
  }
  // Parentless: the payload is a label, not history. Giving it the base commit
  // as a parent would make it reachable from a lock ref and let a careless
  // merge carry it into the branch it was only ever describing.
  const created = __github_json(
    harness,
    "POST",
    __github_api_url(cfg.api_base_url, "/repos/" + repo.owner + "/" + repo.name + "/git/commits"),
    {message: message, tree: unwrap(tree), parents: []},
    cfg,
  )
  if is_err(created) {
    return created
  }
  const minted = trim(to_string(created?.sha ?? ""))
  if minted == "" {
    return __err("invalid_response", "GitHub commit creation response omitted sha")
  }
  return Ok(minted)
}

fn __github_commit_tree(harness: Harness, repo: any, oid: string, cfg: any) {
  const value = __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + repo.owner + "/" + repo.name + "/git/commits/" + oid,
    ),
    nil,
    cfg,
  )
  if is_err(value) {
    return value
  }
  const tree = trim(to_string(value?.tree?.sha ?? ""))
  if tree == "" {
    return __err("invalid_response", "GitHub commit response omitted tree.sha")
  }
  return Ok(tree)
}

/**
 * Release one ref, and only while it still holds the caller's exact object.
 *
 * GitHub's ref delete takes no lease, so this reads first and refuses when the
 * ref has moved. A ref that is already gone is the intended end state, not a
 * failure: a release that retries after a partial failure should be able to
 * finish.
 */
pub fn __github_ref_release(harness: Harness, args: any, cfg: any) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const ref = trim(to_string(args?.ref ?? ""))
  const expected = lowercase(trim(to_string(args?.expected_oid ?? "")))
  if !starts_with(ref, "refs/") || expected == "" {
    return __err(
      "schema_drift",
      "github.ref.release requires a fully qualified `refs/...` ref and an expected_oid",
    )
  }
  const existing = __github_ref_object(harness, r, ref, cfg)
  if is_err(existing) {
    const failure = unwrap_err(existing)
    if (failure?.http_status ?? 0) != 404 {
      return Err(failure)
    }
    const absent: GithubRefRelease = {
      repo: r.full_name,
      ref: ref,
      oid: "",
      released: false,
      reason: "already_absent",
    }
    return absent
  }
  const holder = lowercase(unwrap(existing).oid)
  if holder != expected {
    const other: GithubRefRelease = {
      repo: r.full_name,
      ref: ref,
      oid: holder,
      released: false,
      reason: "held_by_another",
    }
    return other
  }
  const deleted = __github_json(
    harness,
    "DELETE",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + r.owner + "/" + r.name + "/git/refs/" + regex_replace("^refs/", "", ref),
    ),
    nil,
    cfg,
  )
  if is_err(deleted) {
    return deleted
  }
  const released: GithubRefRelease = {
    repo: r.full_name,
    ref: ref,
    oid: holder,
    released: true,
    reason: "released",
  }
  return released
}
