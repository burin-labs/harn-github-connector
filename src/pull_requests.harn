import {
  __body_without,
  __config_keys,
  __github_api_url,
  __github_json,
  __pagination_query,
  __pulls_list_query,
} from "./client"
import { GithubPullRequestCreateReceipt } from "./contracts"
import { connector_error } from "./errors"
import { __github_issue_comment } from "./issues"
import {
  __github_merge_queue_membership,
  __graphql_errors_indicate_stale_head,
} from "./merge_queue"
import {
  __branch_protection_summary,
  __branch_protection_unavailable,
  __check_rollup,
  __classify_pr_state,
  __normalize_graphql_pr,
  __pull_is_merged,
  __queue_membership_unavailable,
  __typed_check_runs,
  __typed_pr_details,
  __typed_pr_edit,
  __typed_pr_file,
  __typed_pr_summary,
  __typed_pr_view,
  __validate_pull_identity,
  __validate_pull_response,
} from "./pull_request_models"
import { __is_status_error, __repo_parts } from "./repository"
import { __pulls_create, __pulls_update } from "./writes"

pub fn __github_pr_list(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  let filters = (args?.filters ?? args ?? {}) + {}
  const requested_state = lowercase(to_string(filters.state ?? "open"))
  if !["open", "closed", "all", "merged"].contains(requested_state) {
    return connector_error(
      "schema_drift",
      "github.pr.list state must be open, closed, all, or merged",
    )
  }
  filters["state"] = if requested_state == "merged" {
    "closed"
  } else {
    requested_state
  }
  const head = trim(to_string(filters.head ?? ""))
  if head != "" && !contains(head, ":") {
    filters["head"] = r.owner + ":" + head
  }
  const pulls = __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + r.owner + "/" + r.name + "/pulls" + __pulls_list_query(filters),
    ),
    nil,
    cfg,
  )
  if is_err(pulls) {
    return pulls
  }
  if type_of(pulls) != "list" {
    return connector_error(
      "invalid_response",
      "github.pr.list expected GitHub to return a pull-request list",
    )
  }
  let typed = []
  for pull in pulls {
    const valid = __validate_pull_response(pull, "github.pr.list")
    if is_err(valid) {
      return valid
    }
    if requested_state == "merged" && !__pull_is_merged(pull) {
      continue
    }
    typed = typed + [__typed_pr_summary(pull)]
  }
  return typed
}

pub fn __github_pr_create(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  if trim(to_string(args?.title ?? "")) == "" || trim(to_string(args?.head ?? "")) == ""
    || trim(
    to_string(args?.base ?? ""),
  )
    == "" {
    return connector_error(
      "schema_drift",
      "github.pr.create requires non-empty title, head, and base",
    )
  }
  let request = {
    owner: r.owner,
    repo: r.name,
    title: to_string(args.title),
    head: to_string(args.head),
    base: to_string(args.base),
  }
  const optional_fields = [
    "body",
    "draft",
    "maintainer_can_modify",
    "github_author_choice",
    "author_choice",
    "author_mode",
    "trailers",
  ]
  for field in optional_fields {
    if args.get(field) != nil {
      request[field] = args.get(field)
    }
  }
  const created = __pulls_create(harness, request, cfg)
  if is_err(created) {
    return created
  }
  const valid = __validate_pull_response(created, "github.pr.create")
  if is_err(valid) {
    return valid
  }
  const receipt: GithubPullRequestCreateReceipt = __typed_pr_details(created) + {created: true}
  return receipt
}

pub fn __github_pr_view(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const number = args?.pr_number ?? args?.number ?? args?.pull_number
  if number == nil {
    return connector_error(
      "schema_drift",
      "github.pr.view requires number, pr_number, or pull_number",
    )
  }
  const pull = __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + r.owner + "/" + r.name + "/pulls/" + to_string(number),
    ),
    nil,
    cfg,
  )
  if is_err(pull) {
    return pull
  }
  const valid = __validate_pull_response(pull, "github.pr.view")
  if is_err(valid) {
    return valid
  }
  const base_branch = pull?.base?.ref ?? args?.branch ?? args?.base_branch
  const protection = __github_branch_protection_raw(harness, r, base_branch, cfg)
  let protection_evidence = nil
  if is_err(protection) {
    const protection_error = unwrap_err(protection)
    if protection_error?.category != "permission" {
      return protection
    }
    protection_evidence = __branch_protection_unavailable(base_branch, protection_error)
  } else {
    protection_evidence = __branch_protection_summary(unwrap(protection), base_branch)
  }
  const membership = __github_merge_queue_membership(
    harness,
    args + {owner: r.owner, repo: r.name, pull_number: number},
    cfg,
  )
  const queue_evidence = if is_err(membership) {
    __queue_membership_unavailable(
      r.full_name,
      number,
      unwrap_err(membership),
      pull?.auto_merge != nil,
    )
  } else {
    membership
  }
  return __typed_pr_view(pull, protection_evidence, queue_evidence)
}

pub fn __github_pr_edit(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const number = args?.pr_number ?? args?.number ?? args?.pull_number
  if number == nil {
    return connector_error(
      "schema_drift",
      "github.pr.edit requires number, pr_number, or pull_number",
    )
  }
  const updated = __pulls_update(
    harness,
    args + {owner: r.owner, repo: r.name, pull_number: number},
    cfg,
  )
  if is_err(updated) {
    return updated
  }
  return __typed_pr_edit(updated)
}

pub fn __github_pr_files(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const number = args?.pr_number ?? args?.number ?? args?.pull_number
  if number == nil {
    return connector_error(
      "schema_drift",
      "github.pr.files requires number, pr_number, or pull_number",
    )
  }
  const files = __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + r.owner + "/" + r.name + "/pulls/" + to_string(number) + "/files"
        + __pagination_query(
        args,
      ),
    ),
    nil,
    cfg,
  )
  if is_err(files) {
    return files
  }
  if type_of(files) != "list" {
    return connector_error(
      "invalid_response",
      "github.pr.files expected GitHub to return a file list",
    )
  }
  let normalized = []
  for file in files {
    const typed = __typed_pr_file(file)
    if is_err(typed) {
      return typed
    }
    normalized = normalized + [unwrap(typed)]
  }
  return {
    repo: r.full_name,
    pull_number: to_int(number),
    files: normalized,
    page: if args?.page == nil {
      1
    } else {
      to_int(args.page)
    },
    per_page: if args?.per_page == nil {
      30
    } else {
      to_int(args.per_page)
    },
  }
}

pub fn __github_pr_comment(harness: Harness, args, cfg) {
  const commented = __github_issue_comment(
    harness,
    args + {issue_number: args?.pr_number ?? args?.number ?? args?.pull_number},
    cfg,
  )
  if is_err(commented) {
    return commented
  }
  let result = commented + {pull_number: commented.issue_number}
  result.remove("issue_number")
  return result
}

pub fn __github_pr_checks(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  let head_sha = args?.head_sha ?? args?.sha
  const number = args?.pr_number ?? args?.number ?? args?.pull_number
  let pull = nil
  if (head_sha == nil || trim(to_string(head_sha)) == "") && number != nil {
    const fetched = __github_json(
      harness,
      "GET",
      __github_api_url(
        cfg.api_base_url,
        "/repos/" + r.owner + "/" + r.name + "/pulls/" + to_string(number),
      ),
      nil,
      cfg,
    )
    if is_err(fetched) {
      return fetched
    }
    pull = fetched
    head_sha = fetched?.head?.sha
  }
  if head_sha == nil || trim(to_string(head_sha)) == "" {
    return connector_error(
      "schema_drift",
      "github.pr.checks requires pr_number, number, pull_number, head_sha, or sha",
    )
  }
  const envelope = __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + r.owner + "/" + r.name + "/commits/" + to_string(head_sha) + "/check-runs"
        + __pagination_query(
        args,
      ),
    ),
    nil,
    cfg,
  )
  if is_err(envelope) {
    return envelope
  }
  const checks = __typed_check_runs(envelope?.check_runs ?? [])
  const rollup = __check_rollup(checks)
  return {
    repo: r.full_name,
    pull_number: number,
    head_sha: to_string(head_sha),
    state: __classify_pr_state(pull, rollup, nil),
    rollup: rollup,
    checks: checks,
  }
}

pub fn __github_pr_merge(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const number = args?.pr_number ?? args?.number ?? args?.pull_number
  if number == nil {
    return connector_error(
      "schema_drift",
      "github.pr.merge requires number, pr_number, or pull_number",
    )
  }
  const method = args?.method ?? args?.merge_method ?? args?.options?.merge_method ?? "merge"
  const options = args?.options ?? {}
  const merged = __pulls_merge_safe(
    harness,
    options
      + args
      + {owner: r.owner, repo: r.name, pull_number: number, merge_method: method},
    cfg,
  )
  if is_err(merged) {
    const err = unwrap_err(merged)
    if err?.category == "branch_protection"
      || err?.code == "protected_branch_requires_admin_override" {
      return connector_error("branch_protection", err?.message ?? "branch protection blocked merge")
    }
    return merged
  }
  return merged
    + {repo: r.full_name, pull_number: number, requested_method: method, state: "merged"}
}

pub fn __github_pr_enable_auto_merge(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const number = args?.pr_number ?? args?.number ?? args?.pull_number
  if number == nil {
    return connector_error(
      "schema_drift",
      "github.pr.enable_auto_merge requires number, pr_number, or pull_number",
    )
  }
  return __pulls_enable_auto_merge(
    harness,
    args + {owner: r.owner, repo: r.name, pull_number: number},
    cfg,
  )
}

pub fn __pulls_list_with_checks(harness: Harness, args, cfg) {
  const graph = __github_json(
    harness,
    "POST",
    __github_api_url(cfg.api_base_url, "/graphql"),
    {
      query: __pulls_with_checks_query(),
      variables: {
        owner: args.owner,
        repo: args.repo,
        states: [uppercase(args?.state ?? "OPEN")],
        limit: min(max(to_int(args?.limit ?? 100) ?? 100, 1), 100),
        checkLimit: min(max(to_int(args?.check_limit ?? 50) ?? 50, 1), 100),
      },
    },
    cfg,
  )
  if is_err(graph) {
    return graph
  }
  const payload = graph
  if payload?.errors != nil && len(payload.errors) > 0 {
    return connector_error(
      "graphql",
      "github GraphQL returned errors: " + json_stringify(payload.errors),
    )
  }
  const nodes = payload?.data?.repository?.pullRequests?.nodes ?? []
  let pulls = []
  for node in nodes {
    pulls = pulls + [__normalize_graphql_pr(node)]
  }
  return pulls
}

pub fn __pulls_merge(harness: Harness, args, cfg) {
  const merged = __github_json(
    harness,
    "PUT",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + args.owner + "/" + args.repo + "/pulls/" + to_string(args.pull_number)
        + "/merge",
    ),
    __body_without(
      args,
      __config_keys() + ["owner", "repo", "pull_number", "admin_override", "delete_branch"],
    ),
    cfg,
  )
  if is_err(merged) {
    return merged
  }
  return __merge_annotation(merged, args)
}

pub fn __pulls_merge_safe(harness: Harness, args, cfg) {
  const pull = __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + args.owner + "/" + args.repo + "/pulls/" + to_string(args.pull_number),
    ),
    nil,
    cfg,
  )
  if is_err(pull) {
    return pull
  }
  const base_branch = pull?.base?.ref ?? args?.base_branch
  const protection_result = __github_branch_protection_raw(
    harness,
    {owner: to_string(args.owner), name: to_string(args.repo)},
    base_branch,
    cfg,
  )
  if is_err(protection_result) {
    return protection_result
  }
  const protection = unwrap(protection_result)
  const protected = protection != nil
  if protected && !(args?.admin_override ?? false) {
    return connector_error(
      "protected_branch_requires_admin_override",
      "base branch `" + to_string(base_branch)
        + "` is protected; pass admin_override to merge through it",
    )
  }
  const merged = __github_json(
    harness,
    "PUT",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + args.owner + "/" + args.repo + "/pulls/" + to_string(args.pull_number) + "/merge",
    ),
    __merge_body(args, pull),
    cfg,
  )
  if is_err(merged) {
    return merged
  }
  let result = {
    pull_request: pull,
    protected: protected,
    branch_protection: protection,
    merge: __merge_annotation(merged, args),
  }
  if args?.delete_branch ?? false {
    const deleted = __delete_pull_head_branch(harness, args, pull, cfg)
    if is_err(deleted) {
      return deleted
    }
    result["delete_branch"] = deleted
  }
  return result
}

pub fn __pulls_enable_auto_merge(harness: Harness, args, cfg) {
  const expected_head_oid = trim(to_string(args?.expected_head_oid ?? args?.expectedHeadOid ?? ""))
  if expected_head_oid == "" {
    return connector_error(
      "schema_drift",
      "github.pr.enable_auto_merge requires expected_head_oid as an explicit publication lease",
    )
  }
  const pull = __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + args.owner + "/" + args.repo + "/pulls/" + to_string(args.pull_number),
    ),
    nil,
    cfg,
  )
  if is_err(pull) {
    return pull
  }
  const valid = __validate_pull_identity(pull, "github.pr.enable_auto_merge")
  if is_err(valid) {
    return valid
  }
  const observed_head_oid = trim(to_string(pull?.head?.sha ?? ""))
  if observed_head_oid != expected_head_oid {
    return connector_error(
      "stale_head",
      "pull request head no longer matches expected_head_oid",
      {expected_head_oid: expected_head_oid, observed_head_oid: observed_head_oid},
    )
  }
  const method = __graphql_merge_method(args?.method ?? args?.merge_method ?? "MERGE")
  if is_err(method) {
    return method
  }
  if pull?.auto_merge != nil {
    return {
      repo: to_string(args.owner) + "/" + to_string(args.repo),
      pull_number: args.pull_number,
      state: "already_enabled",
      already_enabled: true,
      expected_head_oid: expected_head_oid,
      observed_head_oid: observed_head_oid,
      merge_method: uppercase(to_string(pull?.auto_merge?.merge_method ?? unwrap(method))),
      url: to_string(pull?.html_url ?? pull?.url ?? ""),
    }
  }
  const node_id = pull?.node_id
  if node_id == nil || trim(to_string(node_id)) == "" {
    return connector_error(
      "schema_drift",
      "GitHub PR response did not include node_id for auto-merge",
    )
  }
  const graph = __github_json(
    harness,
    "POST",
    __github_api_url(cfg.api_base_url, "/graphql"),
    {
      query: __enable_auto_merge_mutation(),
      variables: {
        pullRequestId: node_id,
        mergeMethod: unwrap(method),
        commitHeadline: args?.commit_headline ?? args?.commit_title,
        commitBody: args?.commit_body ?? args?.commit_message,
        expectedHeadOid: expected_head_oid,
      },
    },
    cfg,
  )
  if is_err(graph) {
    return graph
  }
  if graph?.errors != nil && len(graph.errors) > 0 {
    if __graphql_errors_indicate_stale_head(graph.errors) {
      return connector_error(
        "stale_head",
        "GitHub rejected auto-merge because the pull request head changed",
        {expected_head_oid: expected_head_oid, observed_head_oid: observed_head_oid},
      )
    }
    return connector_error(
      "graphql",
      "github GraphQL returned errors: " + json_stringify(graph.errors),
    )
  }
  const enabled = graph?.data?.enablePullRequestAutoMerge
  const enabled_pull = enabled?.pullRequest
  if enabled_pull?.number == nil || enabled_pull?.autoMergeRequest == nil {
    return connector_error(
      "invalid_response",
      "GitHub auto-merge response omitted pull request evidence",
    )
  }
  return {
    repo: to_string(args.owner) + "/" + to_string(args.repo),
    pull_number: args.pull_number,
    state: "enabled",
    already_enabled: false,
    expected_head_oid: expected_head_oid,
    observed_head_oid: observed_head_oid,
    merge_method: uppercase(
      to_string(enabled_pull?.autoMergeRequest?.mergeMethod ?? unwrap(method)),
    ),
    url: to_string(enabled_pull?.url ?? pull?.html_url ?? ""),
  }
}

fn __pulls_with_checks_query() {
  return """
query HarnGithubConnectorPullsWithChecks($owner: String!, $repo: String!, $states: [PullRequestState!], $limit: Int!, $checkLimit: Int!) {
  repository(owner: $owner, name: $repo) {
    pullRequests(states: $states, first: $limit, orderBy: {field: UPDATED_AT, direction: DESC}) {
      nodes {
        number
        title
        headRefName
        baseRefName
        isDraft
        mergeStateStatus
        url
        statusCheckRollup {
          contexts(first: $checkLimit) {
            nodes {
              __typename
              ... on CheckRun {
                name
                status
                conclusion
                detailsUrl
              }
              ... on StatusContext {
                context
                state
                targetUrl
              }
            }
          }
        }
      }
    }
  }
}
"""
}

fn __enable_auto_merge_mutation() {
  return """
mutation HarnGithubConnectorEnableAutoMerge($pullRequestId: ID!, $mergeMethod: PullRequestMergeMethod, $commitHeadline: String, $commitBody: String, $expectedHeadOid: GitObjectID) {
  enablePullRequestAutoMerge(input: {pullRequestId: $pullRequestId, mergeMethod: $mergeMethod, commitHeadline: $commitHeadline, commitBody: $commitBody, expectedHeadOid: $expectedHeadOid}) {
    actor {
      login
    }
    pullRequest {
      number
      url
      mergeStateStatus
      autoMergeRequest {
        enabledAt
        mergeMethod
      }
    }
  }
}
"""
}

fn __graphql_merge_method(method) {
  const normalized = uppercase(to_string(method ?? "MERGE"))
  if normalized == "MERGE" || normalized == "SQUASH" || normalized == "REBASE" {
    return Ok(normalized)
  }
  return connector_error("schema_drift", "merge method must be MERGE, SQUASH, or REBASE")
}

pub fn __github_branch_protection_raw(harness: Harness, repo, branch, cfg) {
  if branch == nil || trim(to_string(branch)) == "" {
    return Ok(nil)
  }
  const protection = __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + repo.owner + "/" + repo.name + "/branches/" + url_encode(to_string(branch))
        + "/protection",
    ),
    nil,
    cfg,
  )
  if is_err(protection) {
    const err = unwrap_err(protection)
    if __is_status_error(err, 404) {
      return Ok(nil)
    }
    return protection
  }
  return Ok(protection)
}

fn __merge_body(args, pull) {
  let body = __body_without(
    args,
    __config_keys()
      + [
      "owner",
      "repo",
      "pull_number",
      "admin_override",
      "delete_branch",
      "base_branch",
      "check_branch_protection",
      "method",
      "number",
      "options",
      "pr_number",
    ],
  )
  if body?.sha == nil && pull?.head?.sha != nil {
    body["sha"] = pull.head.sha
  }
  return body
}

fn __merge_annotation(response, args) {
  if args?.admin_override ?? false {
    return response + {admin_override_requested: true}
  }
  return response
}

fn __delete_pull_head_branch(harness: Harness, args, pull, cfg) {
  const head_ref = pull?.head?.ref
  if head_ref == nil || trim(to_string(head_ref)) == "" {
    return connector_error(
      "missing_head_ref",
      "cannot delete PR branch because pull.head.ref was missing",
    )
  }
  const head_repo = pull?.head?.repo
  const repo_owner = head_repo?.owner?.login ?? args.owner
  const repo_name = head_repo?.name ?? args.repo
  return __github_json(
    harness,
    "DELETE",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + repo_owner + "/" + repo_name + "/git/refs/heads/" + to_string(head_ref),
    ),
    nil,
    cfg,
  )
}

pub fn __github_branch_protection(harness: Harness, args, cfg) {
  const repo = __repo_parts(args)
  if is_err(repo) {
    return repo
  }
  const r = unwrap(repo)
  const branch = args?.branch ?? args?.base_branch ?? args?.base
  const protection = __github_branch_protection_raw(harness, r, branch, cfg)
  if is_err(protection) {
    return protection
  }
  return __branch_protection_summary(unwrap(protection), branch)
}
