/** Read every commit on one stable pull-request head. */
pub fn github_pr_commits(
  harness: Harness,
  request: GithubPullRequestCommitsRequest,
) -> GithubConnectorResult<GithubPullRequestCommits> {
  return call_typed(harness, "github.pr.commits", __request_args(request), GithubPullRequestCommits)
}

/**
 * Read complete changed-file evidence, including rename sources.
 *
 * Head, base, and declared count must stay stable across the reads. Missing,
 * partial, duplicate, or over-limit evidence is refused. A measured zero is
 * returned only after an empty page agrees with both explicit count reads.
 */
pub fn github_pr_file_census(
  harness: Harness,
  request: GithubPullRequestFileCensusRequest,
) -> GithubConnectorResult<GithubPullRequestFileCensus> {
  return call_typed(
    harness,
    "github.pr.file_census",
    __request_args(request),
    GithubPullRequestFileCensus,
  )
}

/** Resolve GitHub's asynchronous mergeability state with bounded polling. */
pub fn github_resolve_mergeable(
  harness: Harness,
  request: GithubMergeabilityRequest,
) -> GithubConnectorResult<GithubMergeability> {
  return call_typed(
    harness,
    "pull_requests.resolve_mergeable",
    __request_args(request),
    GithubMergeability,
  )
}
