/** Disable auto-merge under exact pull and base leases. */
pub fn pulls_disable_auto_merge(
  harness: Harness,
  request: GithubAutoMergeDisableRequest,
) -> GithubConnectorResult<GithubAutoMergeDisableReceipt> {
  return call_typed(
