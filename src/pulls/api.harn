import { call_typed } from "../api"
import {
  GithubAutoMergeDisableReceipt,
  GithubAutoMergeDisableRequest,
  GithubAutoMergeReceipt,
  GithubAutoMergeRequest,
  GithubConnectorResult,
  GithubMergeability,
  GithubMergeabilityRequest,
  GithubPullRequestCommits,
  GithubPullRequestCommitsRequest,
  GithubPullRequestEditReceipt,
  GithubPullRequestEditRequest,
  GithubPullRequestFileCensus,
  GithubPullRequestFileCensusRequest,
  GithubPullRequestMergeReceipt,
  GithubPullRequestMergeRequest,
  GithubPullRequestUpsertReceipt,
  GithubPullRequestUpsertRequest,
  GithubPullRequestsWithChecks,
  GithubPullsWithChecksRequest,
} from "../contracts"
import { pr_edit_body } from "../pr_edit"
import { __request_args } from "../request_options"

/** List pull requests with normalized merge state and CI contexts. */
pub fn pulls_list_with_checks(
  harness: Harness,
  request: GithubPullsWithChecksRequest,
) -> GithubConnectorResult<GithubPullRequestsWithChecks> {
  return call_typed(
    harness,
    "pulls.list_with_checks",
    __request_args(request),
    GithubPullRequestsWithChecks,
  )
}

/** Create or refresh the sole open pull request for one exact head/base pair. */
pub fn github_upsert_pull_request(
  harness: Harness,
  request: GithubPullRequestUpsertRequest,
) -> GithubConnectorResult<GithubPullRequestUpsertReceipt> {
  return call_typed(
    harness,
    "github.pr.upsert",
    __request_args(request),
    GithubPullRequestUpsertReceipt,
  )
}

/** Update the closed editable field set of one pull request. */
pub fn pulls_update(
  harness: Harness,
  request: GithubPullRequestEditRequest,
) -> GithubConnectorResult<GithubPullRequestEditReceipt> {
  const body = pr_edit_body(request.edits)
  if is_err(body) {
    return Err(unwrap_err(body))
  }
  const args = __request_args(request).removing("edits") + unwrap(body)
  return call_typed(harness, "github.pr.edit", args, GithubPullRequestEditReceipt)
}

/** Merge one pull request after checking its base-branch protection. */
pub fn pulls_merge_safe(
  harness: Harness,
  request: GithubPullRequestMergeRequest,
) -> GithubConnectorResult<GithubPullRequestMergeReceipt> {
  return call_typed(
    harness,
    "pulls.merge_safe",
    __request_args(request),
    GithubPullRequestMergeReceipt,
  )
}

/** Enable auto-merge under an exact pull-request head lease. */
pub fn pulls_enable_auto_merge(
  harness: Harness,
  request: GithubAutoMergeRequest,
) -> GithubConnectorResult<GithubAutoMergeReceipt> {
  return call_typed(
    harness,
    "github.pr.enable_auto_merge",
