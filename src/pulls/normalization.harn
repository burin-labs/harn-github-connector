import { __duration_seconds } from "../actions/normalization"
import {
  GithubCheckRollup,
  GithubCheckRun,
  GithubMergeQueueEntry,
  GithubPullRequestDetails,
  GithubPullRequestEditReceipt,
  GithubPullRequestFile,
  GithubPullRequestRef,
  GithubPullRequestSummary,
  GithubPullRequestUser,
  GithubPullRequestView,
} from "../contracts"
import { __err } from "../errors"
import { pr_edit_result } from "../pr_edit"

pub fn __normalize_graphql_pr(node: any) {
  return {
    number: node?.number,
    title: node?.title ?? "",
    headRefName: node?.headRefName ?? "",
    baseRefName: node?.baseRefName ?? "",
    isDraft: node?.isDraft ?? false,
    mergeStateStatus: node?.mergeStateStatus ?? "UNKNOWN",
    statusCheckRollup: __normalize_status_check_rollup(node?.statusCheckRollup),
    url: node?.url ?? "",
  }
}

pub fn __normalize_status_check_rollup(rollup: any) {
  const contexts = rollup?.contexts?.nodes ?? []
  let checks = []
  for context in contexts {
    checks = checks + [__normalize_status_check(context)]
  }
  return checks
}

/** Project GraphQL check contexts into the same exact-head rows as the REST adapter. */
pub fn __graphql_pr_check_runs(rollup: any, head_sha: string) -> list<GithubCheckRun> {
  let checks: list<GithubCheckRun> = []
  for context in __normalize_status_check_rollup(rollup) {
    const details_url = context?.detailsUrl
    const check: GithubCheckRun = {
      id: nil,
      name: context?.name ?? "",
      status: lowercase(context?.status ?? ""),
      conclusion: lowercase(context?.conclusion ?? ""),
      head_sha: head_sha,
      started_at: nil,
      completed_at: nil,
      duration_seconds: nil,
      details_url: details_url,
      html_url: details_url,
      external_id: nil,
    }
    checks = checks + [check]
  }
  return checks
}

pub fn __normalize_status_check(context: any) {
  if context?.__typename == "StatusContext" {
    const state = uppercase(context?.state ?? "")
    return {
      name: context?.context ?? "",
      status: if state == "PENDING" {
        "IN_PROGRESS"
      } else {
        "COMPLETED"
      },
      conclusion: __status_context_conclusion(state),
      detailsUrl: context?.targetUrl,
    }
  }
  return {
    name: context?.name ?? "",
    status: context?.status ?? "",
    conclusion: context?.conclusion,
    detailsUrl: context?.detailsUrl,
  }
}

pub fn __status_context_conclusion(state: any) {
  if state == "SUCCESS" {
    return "SUCCESS"
  }
  if state == "FAILURE" || state == "ERROR" {
    return state
  }
  return nil
}

pub fn __typed_pr_summary(pull: any) -> GithubPullRequestSummary {
  const state = __classify_pr_state(pull, nil, nil)
  const summary: GithubPullRequestSummary = {
    repo: pull?.base?.repo?.full_name ?? "",
    number: pull?.number,
    title: pull?.title ?? "",
    url: pull?.html_url ?? pull?.url ?? "",
    state: state,
    github_state: pull?.state ?? "",
    draft: pull?.draft ?? false,
    merged: __pull_is_merged(pull),
    merged_at: if pull?.merged_at == nil {
      nil
    } else {
      to_string(pull.merged_at)
    },
    merge_commit_oid: __pull_merge_commit_oid(pull),
    mergeable: pull?.mergeable,
    mergeable_state: pull?.mergeable_state ?? "unknown",
    base: __typed_ref(pull?.base),
    head: __typed_ref(pull?.head),
    labels: __label_names(pull?.labels ?? []),
    auto_merge_armed: pull?.auto_merge != nil,
    auto_merge_method: if pull?.auto_merge?.merge_method == nil {
      nil
    } else {
      uppercase(to_string(pull.auto_merge.merge_method))
    },
    in_merge_queue: nil,
  }
  return summary
}

pub fn __typed_pr_details(pull: any) -> GithubPullRequestDetails {
  const details: GithubPullRequestDetails = __typed_pr_summary(pull)
    + {
      body: pull?.body ?? "",
      user: __typed_user(pull?.user),
      created_at: pull?.created_at,
      updated_at: pull?.updated_at,
      closed_at: pull?.closed_at,
    }
  return details
}

pub fn __typed_pr_view(pull: any, protection: any, queue: any) -> GithubPullRequestView {
  let summary = __typed_pr_details(pull)
  summary["auto_merge_armed"] = queue.auto_merge_armed
  summary["auto_merge_method"] = queue.auto_merge_method
  summary["in_merge_queue"] = if queue.available {
    queue.queued
  } else {
    nil
  }
  summary["state"] = __classify_pr_state(
    pull,
    nil,
    if queue.available {
      queue.entry
    } else {
      nil
    },
  )
  const view: GithubPullRequestView = summary
    + {branch_protection: protection, queue_membership: queue}
  return view
}

pub fn __typed_pr_edit(pull: any) -> GithubPullRequestEditReceipt {
  const receipt: GithubPullRequestEditReceipt = pr_edit_result(__typed_pr_summary(pull), pull)
  return receipt
}

pub fn __typed_ref(ref: any) -> GithubPullRequestRef {
  const typed: GithubPullRequestRef = {
    ref: ref?.ref ?? "",
    sha: ref?.sha ?? "",
    repo: ref?.repo?.full_name ?? "",
    owner: ref?.repo?.owner?.login ?? ref?.user?.login ?? "",
  }
  return typed
}

pub fn __typed_user(user: any) -> GithubPullRequestUser? {
  if user == nil {
    return nil
  }
  return {id: user?.id, login: user?.login ?? "", type: user?.type ?? ""}
}

pub fn __validate_pull_response(pull: any, surface: any) {
  if type_of(pull) != "dict" || pull?.number == nil || trim(to_string(pull?.title ?? "")) == ""
    || trim(to_string(pull?.state ?? ""))
      == ""
    || trim(to_string(pull?.base?.ref ?? "")) == ""
    || trim(to_string(pull?.head?.ref ?? "")) == ""
    || trim(to_string(pull?.head?.sha ?? "")) == "" {
    return __err("invalid_response", surface + " response omitted required pull-request fields")
  }
  const merge_commit_oid = __pull_merge_commit_oid(pull)
  if __pull_is_merged(pull)
    && (type_of(pull?.merged_at) != "string"
      || trim(pull.merged_at) == ""
      || merge_commit_oid == nil
      || len(regex_captures("^[0-9a-fA-F]{40}$", merge_commit_oid)) == 0) {
    return __err(
      "invalid_response",
      surface + " response omitted required merged pull-request evidence",
    )
  }
  return Ok(true)
}

pub fn __pull_is_merged(pull: any) {
  return (pull?.merged ?? false) || pull?.merged_at != nil
}

pub fn __pull_merge_commit_oid(pull: any) {
  if !__pull_is_merged(pull) {
    return nil
  }
  const oid = pull?.merge_commit_oid ?? pull?.merge_commit_sha
  if oid == nil || trim(to_string(oid)) == "" {
    return nil
  }
  return lowercase(to_string(oid))
}

pub fn __validate_pull_identity(pull: any, surface: any) {
  if type_of(pull) != "dict" || pull?.number == nil
    || trim(to_string(pull?.head?.sha ?? "")) == "" {
    return __err("invalid_response", surface + " response omitted pull number or head sha")
  }
  return Ok(true)
}

pub fn __typed_pr_file(file: any) {
  if type_of(file) != "dict" || trim(to_string(file?.sha ?? "")) == ""
    || trim(to_string(file?.filename ?? ""))
      == ""
    || trim(to_string(file?.status ?? "")) == ""
    || file?.additions == nil
    || file?.deletions == nil
    || file?.changes == nil {
    return __err("invalid_response", "github.pr.files entry omitted required file evidence")
  }
  const typed: GithubPullRequestFile = {
    sha: to_string(file.sha),
    filename: to_string(file.filename),
    status: lowercase(to_string(file.status)),
    additions: to_int(file.additions),
    deletions: to_int(file.deletions),
    changes: to_int(file.changes),
    previous_filename: file?.previous_filename,
    blob_url: file?.blob_url,
    raw_url: file?.raw_url,
    contents_url: file?.contents_url,
  }
  return Ok(typed)
}

pub fn __label_names(labels: any) {
  let names = []
  for label in labels ?? [] {
    names = names + [label?.name ?? to_string(label)]
  }
  return names
}

pub fn __branch_protection_summary(protection: any, branch: any) {
  if protection == nil {
    return {
      available: true,
      branch: to_string(branch ?? ""),
      protected: false,
      required_checks: [],
      strict: false,
      required_review_count: 0,
      require_code_owner_reviews: false,
      require_conversation_resolution: false,
      allow_force_pushes: false,
      allow_deletions: false,
      error: nil,
    }
  }
  return {
    available: true,
    branch: to_string(branch ?? ""),
    protected: true,
    required_checks: protection?.required_status_checks?.contexts ?? [],
    strict: protection?.required_status_checks?.strict ?? false,
    required_review_count: protection?.required_pull_request_reviews
      ?.required_approving_review_count
      ?? 0,
    require_code_owner_reviews: protection?.required_pull_request_reviews
      ?.require_code_owner_reviews
      ?? false,
    require_conversation_resolution: protection?.required_conversation_resolution?.enabled ?? false,
    allow_force_pushes: protection?.allow_force_pushes?.enabled ?? false,
    allow_deletions: protection?.allow_deletions?.enabled ?? false,
    error: nil,
  }
}

pub fn __branch_protection_unavailable(branch: any, error: any) {
  return {
    available: false,
    branch: to_string(branch ?? ""),
    protected: nil,
    required_checks: [],
    strict: nil,
    required_review_count: nil,
    require_code_owner_reviews: nil,
    require_conversation_resolution: nil,
    allow_force_pushes: nil,
    allow_deletions: nil,
    error: error,
  }
}

pub fn __queue_membership_unavailable(
  repo: any,
  number: any,
  error: any,
  auto_merge_armed: any,
  auto_merge_method: any,
) {
  return {
    repo: repo,
    pull_number: to_int(number),
    available: false,
    queued: false,
    auto_merge_armed: auto_merge_armed,
    auto_merge_method: if auto_merge_method == nil {
      nil
    } else {
      uppercase(to_string(auto_merge_method))
    },
    entry: nil,
    error: error,
  }
}

pub fn __typed_check_runs(runs: any) -> list<GithubCheckRun> {
  let checks: list<GithubCheckRun> = []
  for run in runs ?? [] {
    checks = checks + [__typed_check_run(run)]
  }
  return checks
}

pub fn __typed_check_run(run: any) -> GithubCheckRun {
  const typed: GithubCheckRun = {
    id: run?.id,
    name: run?.name ?? "",
    status: lowercase(run?.status ?? ""),
    conclusion: lowercase(run?.conclusion ?? ""),
    head_sha: run?.head_sha ?? "",
    started_at: run?.started_at,
    completed_at: run?.completed_at,
    duration_seconds: __duration_seconds(run?.started_at, run?.completed_at),
    details_url: run?.details_url ?? run?.detailsUrl,
    html_url: run?.html_url,
    external_id: run?.external_id,
  }
  return typed
}

pub fn __check_rollup(checks: any) -> GithubCheckRollup {
  let pending = 0
  let failed = 0
  let successful = 0
  let skipped = 0
  for check in checks ?? [] {
    const status = lowercase(check?.status ?? "")
    const conclusion = lowercase(check?.conclusion ?? "")
    if status != "completed" {
      pending = pending + 1
    } else if conclusion == "success" || conclusion == "neutral" {
      successful = successful + 1
    } else if conclusion == "skipped" {
      skipped = skipped + 1
    } else {
      failed = failed + 1
    }
  }
  const state = if failed > 0 {
    "failing"
  } else if pending > 0 || len(checks ?? []) == 0 {
    "pending"
  } else {
    "green"
  }
  const rollup: GithubCheckRollup = {
    state: state,
    total: len(checks ?? []),
    pending: pending,
    failed: failed,
    successful: successful,
    skipped: skipped,
    conclusion: if state == "green" {
      "success"
    } else if state == "failing" {
      "failure"
    } else {
      nil
    },
  }
  return rollup
}

pub fn __classify_pr_state(pull: any, rollup: any, queue: any) {
  if __pull_is_merged(pull) {
    return "merged"
  }
  if queue != nil {
    return "queued"
  }
  if !(pull?.mergeable ?? true) || lowercase(pull?.mergeable_state ?? "") == "dirty" {
    return "dirty"
  }
  if rollup?.state == "failing" {
    return "failing"
  }
  if rollup?.state == "pending" {
    return "pending"
  }
  if rollup?.state == "green" || lowercase(pull?.mergeable_state ?? "") == "clean" {
    return "green"
  }
  return "pending"
}

pub fn __typed_merge_queue_entry(entry: any) {
  if type_of(entry) != "dict" || trim(to_string(entry?.id ?? "")) == ""
    || entry?.pullRequest?.number
      == nil
    || entry?.position == nil
    || trim(to_string(entry?.state ?? "")) == "" {
    return __err("invalid_response", "github merge queue entry omitted required evidence")
  }
  const typed: GithubMergeQueueEntry = {
    id: to_string(entry.id),
    pull_number: to_int(entry.pullRequest.number),
    url: to_string(entry?.pullRequest?.url ?? ""),
    state: lowercase(to_string(entry.state)),
    position: to_int(entry.position),
    enqueued_at: entry?.enqueuedAt,
    head_sha: to_string(entry?.headCommit?.oid ?? entry?.pullRequest?.headRefOid ?? ""),
    base_branch: to_string(entry?.pullRequest?.baseRefName ?? ""),
    jump: entry?.jump ?? false,
    solo: entry?.solo ?? false,
    estimated_time_to_merge_seconds: entry?.estimatedTimeToMerge,
  }
  return Ok(typed)
}
