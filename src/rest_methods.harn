pub fn __check_runs_update(harness: Harness, args, cfg) {
  return __github_json(
    harness,
    "PATCH",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + args.owner + "/" + args.repo + "/check-runs/" + to_string(args.check_run_id),
    ),
