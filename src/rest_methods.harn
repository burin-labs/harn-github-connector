}

pub fn __pulls_list(harness: Harness, args, cfg) {
  return __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + args.owner + "/" + args.repo + "/pulls" + __pulls_list_query(args),
    ),
    nil,
    cfg,
  )
}

