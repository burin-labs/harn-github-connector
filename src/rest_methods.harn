pub fn __repos_get_content(harness: Harness, args, cfg) {
  return __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + args.owner + "/" + args.repo + "/contents/"
        + __trim_leading_slash(args.path ?? "")
        + __ref_query(args),
    ),
    nil,
    cfg,
  )
}

pub fn __repos_get_branch_protection(harness: Harness, args, cfg) {
  return __github_json(
    harness,
    "GET",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + args.owner + "/" + args.repo + "/branches/"
        + url_encode(to_string(args.branch))
        + "/protection",
    ),
    nil,
    cfg,
  )
}

