import { __api_call_author_mode_body } from "./authoring"
import {
  __body_without,
  __config_keys,
  __github_api_url,
  __github_json,
  __github_request,
  __github_text,
  __pagination_query,
  __pulls_list_query,
  __ref_query,
  __trim_leading_slash,
} from "./client"
import { connector_error } from "./errors"

/** Return the installation token already resolved by the shared client boundary. */
pub fn __installation_token_result(harness: Harness, args, cfg) {
  return {
    token: cfg.installation_token,
    token_mode: cfg.token_mode,
    installation_id: cfg.installation_id,
    api_base_url: cfg.api_base_url,
  }
}

pub fn __issues_create_comment(harness: Harness, args, cfg) {
  return __github_json(
    harness,
    "POST",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + args.owner + "/" + args.repo + "/issues/" + to_string(args.issue_number)
        + "/comments",
    ),
    {body: args.body},
    cfg,
  )
}

pub fn __issues_create(harness: Harness, args, cfg) {
  return __github_json(
    harness,
    "POST",
    __github_api_url(cfg.api_base_url, "/repos/" + args.owner + "/" + args.repo + "/issues"),
    __body_without(args, __config_keys() + ["owner", "repo"]),
    cfg,
  )
}

pub fn __issues_update(harness: Harness, args, cfg) {
  return __github_json(
    harness,
    "PATCH",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + args.owner + "/" + args.repo + "/issues/" + to_string(args.issue_number),
    ),
    __body_without(args, __config_keys() + ["owner", "repo", "issue_number"]),
    cfg,
  )
}

pub fn __issues_add_labels(harness: Harness, args, cfg) {
  return __github_json(
    harness,
    "POST",
    __github_api_url(
      cfg.api_base_url,
      "/repos/" + args.owner + "/" + args.repo + "/issues/" + to_string(args.issue_number)
        + "/labels",
    ),
    {labels: args.labels ?? []},
    cfg,
