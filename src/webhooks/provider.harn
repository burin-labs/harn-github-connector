import { __err } from "../errors"
import { __normalize_github_payload } from "./normalization"
import { __extract_mention_candidates } from "./projections"
import { __occurred_at, __repo } from "./values"

const GITHUB_PROVIDER_ID = "github"

const GITHUB_WEBHOOK_EVENTS = [
  "issues",
  "pull_request",
  "issue_comment",
  "pull_request_review",
  "push",
  "workflow_run",
  "deployment_status",
  "check_run",
  "check_suite",
  "status",
  "merge_group",
  "installation",
  "installation_repositories",
  "release",
]

type GithubConnectorState = {initialized: bool, active: bool, bindings: dict, ctx: dict}

const MAX_BODY_BYTES = 1048576

let GITHUB_STATE: GithubConnectorState = {initialized: false, active: false, bindings: {}, ctx: {}}

/** Return this connector's Harn provider id. */
pub fn provider_id() {
  return GITHUB_PROVIDER_ID
}

/** Return the trigger kinds supported by this connector. */
pub fn kinds() {
  return ["webhook"]
}

/** Return the canonical normalized GitHub webhook payload schema. */
pub fn payload_schema() {
  return {
    harn_schema_name: "GitHubEventPayload",
    json_schema: {
      type: "object",
      required: ["event", "raw"],
      additionalProperties: true,
      properties: {
        provider: {type: "string"},
        event: {type: "string"},
        topic: {type: "string"},
        reaction_topics: {type: "array", items: {type: "string"}},
        action: {type: ["string", "null"]},
        delivery_id: {type: ["string", "null"]},
        installation_id: {type: ["integer", "null"]},
        repository: {type: ["object", "null"]},
        repo: {type: ["object", "null"]},
        pull_request_number: {type: ["integer", "null"]},
        head_sha: {type: ["string", "null"]},
        head_ref: {type: ["string", "null"]},
        base_ref: {type: ["string", "null"]},
        run_id: {type: ["integer", "null"]},
        check_id: {type: ["integer", "null"]},
        check_suite_id: {type: ["integer", "null"]},
        merge_group_id: {type: ["integer", "null", "string"]},
        release_id: {type: ["integer", "null"]},
        source: {type: ["object", "null"]},
        source_refs: {type: ["array", "null"]},
        triage_event: {type: ["object", "null"]},
        job_event: {type: ["object", "null"]},
        mention: {type: ["object", "null"]},
        raw: {type: "object"},
        issue: {type: ["object", "null"]},
        pull_request: {type: ["object", "null"]},
        comment: {type: ["object", "null"]},
        review: {type: ["object", "null"]},
        commits: {type: ["array", "null"]},
        workflow_run: {type: ["object", "null"]},
        deployment_status: {type: ["object", "null"]},
        deployment: {type: ["object", "null"]},
        check_run: {type: ["object", "null"]},
        check_suite: {type: ["object", "null"]},
        status: {type: ["string", "null"]},
        commit_status: {type: ["object", "null"]},
        merge_group: {type: ["object", "null"]},
        installation: {type: ["object", "null"]},
        release: {type: ["object", "null"]},
        repositories_added: {type: ["array", "null"]},
        repositories_removed: {type: ["array", "null"]},
      },
    },
  }
}

/** Initialize connector state with orchestrator context. */
pub fn init(_harness: Harness, ctx = nil) {
  const next = __state()
    + {
      initialized: true,
      ctx: if type_of(ctx) == "dict" {
        ctx
      } else {
        {}
      },
    }
  __set_state(next)
  return next
}

/** Activate webhook bindings and reject duplicate configured paths. */
pub fn activate(_harness: Harness, bindings = []) {
  let by_id = {}
  let seen_paths = {}
  for binding in bindings ?? [] {
    const fallback_id = "binding-" + to_string(len(by_id.keys()))
    const binding_id = binding?.binding_id ?? binding?.id ?? fallback_id
    const path = binding?.path ?? binding?.match?.path
    if path != nil && path != "" {
      if seen_paths.get(path) {
        return __err(
          "activation",
          "github connector path `" + path + "` is configured by multiple bindings",
        )
      }
      seen_paths[path] = true
    }
    by_id[binding_id] = binding + {binding_id: binding_id}
  }
  const next = __state() + {bindings: by_id, active: true}
  __set_state(next)
  return {provider: GITHUB_PROVIDER_ID, kind: "webhook", bindings: len(by_id.keys())}
}

/**
 * Clear connector lifecycle state. Cached installation tokens persist
 * across restarts so subsequent runs can refresh them lazily. Call
 * `reset_token_cache(harness.runtime)` explicitly to invalidate the persistent cache.
 */
pub fn shutdown(_harness: Harness) {
  GITHUB_STATE = {initialized: false, active: false, bindings: {}, ctx: {}}
  return {provider: GITHUB_PROVIDER_ID, active: false}
}

/** Verify and normalize a raw GitHub webhook request into NormalizeResult v1. */
@complexity(allow)
pub fn normalize_inbound(harness: Harness, raw) {
  const body_text = raw?.body_text ?? raw?.body ?? ""
  if len(body_text) > MAX_BODY_BYTES {
    return __reject(413, "payload_too_large", "github webhook body exceeds 1 MiB cap")
  }
  const headers = raw?.headers ?? {}
  const verified = __verify_github_signature(harness.secrets, raw, headers, body_text)
  if is_err(verified) {
    return __reject_err(unwrap_err(verified))
  }
  const signature_status = unwrap(verified)
  const parsed = try {
    json_parse(body_text)
  }
  if is_err(parsed) {
    return __reject(400, "invalid_json", "github payload body is not valid JSON")
  }
  const payload = unwrap(parsed)
  const event_kind = __event_kind(raw, headers)
  if event_kind == nil || event_kind == "" {
    return __reject(400, "missing_event", "missing x-github-event header")
  }
  if !contains(GITHUB_WEBHOOK_EVENTS, event_kind) {
    return __reject(
      400,
      "unsupported_event",
      "unsupported GitHub event type `" + to_string(event_kind) + "`",
    )
  }
  const event = __build_event(event_kind, payload, raw, headers, signature_status)
  return {type: "event", event: event}
}

/**
 * Extract `@handle command args...` mentions from a free-text body using pure
 * string scanning (CPU-only, no network). Returns a list of
 * `{handle, command, rest}` candidates. Mirrors the `mention.candidates`
 * surfaced on normalized issue/PR/comment payloads.
 */
pub fn github_extract_mentions(body) {
  return __extract_mention_candidates(body)
}

fn __state() -> GithubConnectorState {
  return GITHUB_STATE
}

fn __set_state(state: GithubConnectorState) {
  GITHUB_STATE = state
  return state
}

fn __reject(status, code, message) {
  return {
    type: "reject",
    reject: {
      status: status,
      body: json_stringify({error: code, message: message}),
      content_type: "application/json",
    },
  }
}

fn __reject_err(err) {
  const code = err?.code ?? "rejected"
  const message = err?.message ?? "request rejected"
  const status = if code == "missing_signature" || code == "invalid_signature"
    || code
      == "missing_secret" {
    401
  } else {
    400
  }
  return __reject(status, code, message)
}

fn __header(headers, name) {
  const wanted = lowercase(name)
  for entry in (headers ?? {}).entries() {
    if lowercase(trim(to_string(entry.key))) == wanted {
      return trim(to_string(entry.value))
    }
  }
  return nil
}

fn __event_kind(raw, headers) {
  return __header(headers, "x-github-event") ?? raw?.kind ?? raw?.event
}

fn __signing_secret(secrets: HarnessSecrets, raw) {
  const state = __state()
  const ctx_secret = state.ctx?.signing_secret ?? state.ctx?.secrets?.signing_secret
  if ctx_secret != nil && trim(to_string(ctx_secret)) != "" {
    return to_string(ctx_secret)
  }
  const bindings = state.bindings ?? {}
  const binding_id = raw?.metadata?.binding_id ?? raw?.binding_id
  if binding_id != nil {
    const binding = bindings.get(binding_id)
    const binding_secret = binding?.signing_secret ?? binding?.secrets?.signing_secret
      ?? binding?.config?.signing_secret
    if binding_secret != nil && trim(to_string(binding_secret)) != "" {
      return to_string(binding_secret)
    }
  }
  const secret_id = __signing_secret_id(raw)
  const secret = __secret_get_optional(secrets, secret_id)
  if secret != nil && trim(to_string(secret)) != "" {
    return secret
  }
  return nil
}

fn __signing_secret_id(raw) {
  const metadata = raw?.metadata ?? {}
  const id = metadata?.secret_ids?.signing_secret ?? metadata?.config?.secret_ids?.signing_secret
  const direct_id = __secret_id_candidate(id, "signing_secret")
  if direct_id != nil {
    return direct_id
  }
  const bindings = __state().bindings ?? {}
  const binding_id = metadata?.binding_id ?? raw?.binding_id
  if binding_id != nil {
    const binding = bindings.get(binding_id)
    return __binding_signing_secret_id(binding)
  }
  return nil
}

fn __binding_signing_secret_id(binding) {
  const id = binding?.signing_secret_id ?? binding?.signing_secret_secret
    ?? binding?.secrets?.signing_secret_id
    ?? binding?.config?.signing_secret_id
    ?? binding?.config?.signing_secret_secret
    ?? binding?.config?.secret_ids?.signing_secret
    ?? binding?.config?.secrets?.signing_secret
  return __secret_id_candidate(id, "signing_secret")
}

fn __secret_id_candidate(value, fallback_name) {
  if value == nil || trim(to_string(value)) == "" {
    return nil
  }
  const text = trim(to_string(value))
  if contains(text, "/") {
    return text
  }
  if fallback_name != nil && trim(to_string(fallback_name)) != "" {
    return GITHUB_PROVIDER_ID + "/" + to_string(fallback_name)
  }
  return nil
}

fn __secret_get_optional(secrets: HarnessSecrets, secret_id) {
  if secret_id == nil || trim(to_string(secret_id)) == "" {
    return nil
  }
  const resolved = try {
    secrets.read(to_string(secret_id))
  }
  if is_err(resolved) {
    return nil
  }
  return to_string(unwrap(resolved))
}

fn __verify_github_signature(secrets: HarnessSecrets, raw, headers, body_text) {
  const signature = __header(headers, "x-hub-signature-256")
  if signature == nil || signature == "" {
    return __err("missing_signature", "missing x-hub-signature-256 header")
  }
  if !starts_with(signature, "sha256=") {
    return __err("invalid_signature", "x-hub-signature-256 must start with sha256=")
  }
  const secret = __signing_secret(secrets, raw)
  if secret == nil || trim(to_string(secret)) == "" {
    return __err("missing_secret", "github signing_secret is required")
  }
  const actual = signature[7:len(signature)]
  const expected = hmac_sha256(to_string(secret), body_text)
  if !constant_time_eq(expected, actual) {
    return __err("invalid_signature", "x-hub-signature-256 did not match the request body")
  }
  return Ok("verified")
}

@complexity(allow)
fn __build_event(event_kind, payload, raw, headers, signature_status) {
  const repo = __repo(payload)
  const occurred_at = __occurred_at(event_kind, payload, raw)
  const delivery_id = __header(headers, "x-github-delivery")
  const dedupe_key = __dedupe_key(event_kind, payload, repo, delivery_id)
  const normalized_payload = __normalize_github_payload(
    event_kind,
    payload,
    delivery_id,
    dedupe_key,
    occurred_at,
  )
  return {
    kind: event_kind,
    topic: normalized_payload.topic,
    occurred_at: occurred_at,
    dedupe_key: dedupe_key,
    delivery_id: delivery_id,
    signature_status: __signature_status(signature_status),
    payload: normalized_payload,
    headers: {"x-github-event": event_kind, "x-github-delivery": delivery_id},
  }
}

fn __signature_status(status) {
  if status == "verified" || status == "signed" {
    return {state: "verified"}
  }
  return {state: "unsigned"}
}

fn __dedupe_key(event_kind, payload, repo, delivery_id) {
  if delivery_id != nil && delivery_id != "" {
    return "github:delivery:" + to_string(delivery_id)
  }
  const repo_part = if repo?.full_name != nil && repo.full_name != "" {
    repo.full_name
  } else {
    "unknown"
  }
  if event_kind == "push" {
    return "github:push:" + repo_part + ":" + to_string(payload?.after ?? "")
  }
  const action = payload?.action ?? ""
  const resource_id = to_string(
    payload?.pull_request?.id ?? payload?.issue?.id ?? payload?.comment?.id ?? payload?.review?.id
      ?? payload?.workflow_run?.id
      ?? payload?.deployment_status?.id
      ?? payload?.check_run?.id
      ?? payload?.check_suite?.id
      ?? payload?.merge_group?.id
      ?? payload?.installation?.id
      ?? payload?.release?.id
      ?? payload?.sha
      ?? "",
  )
  return "github:" + event_kind + ":" + repo_part + ":" + to_string(action) + ":" + resource_id
}
