import { actions_workflow_run_cancel, call } from "../src/facade"

const BASE = "https://github-api.test"

const TOKEN = "github-installation-token"

fn auth() {
  return {api_base_url: BASE, installation_token: TOKEN}
}

pipeline test_actions_workflow_run_cancel_requests_exact_run(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  const url = BASE + "/repos/octo-org/octo-repo/actions/runs/29679449/cancel"
  harness.testing.http_mock("POST", url, {status: 202, body: ""})
  const result = actions_workflow_run_cancel(
    harness,
    {owner: "octo-org", repo: "octo-repo", run_id: 29679449, options: auth()},
  )
  assert(is_ok(result), "accepted cancellation returns Ok")
  const calls = harness.testing.http_mock_calls()
  assert_eq(len(calls), 1)
  assert_eq(calls[0].url, url)
  assert_eq(calls[0].method, "POST")
  harness.testing.http_mock_clear()
}

pipeline test_github_actions_run_cancel_returns_closed_receipt(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  const url = BASE + "/repos/octo-org/octo-repo/actions/runs/29679449/cancel"
  harness.testing.http_mock("POST", url, {status: 202, body: ""})
  const result = call(
    harness,
    "github.actions.run_cancel",
    auth() + {repo: "octo-org/octo-repo", run_id: 29679449},
  )
  assert(is_ok(result), "canonical cancellation returns Ok")
  const receipt = unwrap(result)
  assert_eq(
    receipt,
    {repo: "octo-org/octo-repo", run_id: 29679449, accepted: true, state: "cancel_requested"},
  )
  harness.testing.http_mock_clear()
}

pipeline test_actions_workflow_run_cancel_rejects_invalid_id(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  const result = call(
    harness,
    "github.actions.run_cancel",
    auth() + {repo: "octo-org/octo-repo", run_id: "1/force"},
  )
  assert(is_err(result), "invalid run id fails before HTTP")
  assert_eq(unwrap_err(result).code, "schema_drift")
  assert_eq(len(harness.testing.http_mock_calls()), 0)
  harness.testing.http_mock_clear()
}
