import { call, github_auth_fallback_enabled } from "../src/facade"

pipeline test_explicit_canonical_policy_dominates_environment(task: any) {
  assert_eq(
    github_auth_fallback_enabled({allow_gh_auth_fallback: false}, true),
    false,
    "explicit opt-out dominates an enabled environment default",
  )
  assert_eq(
    github_auth_fallback_enabled({allow_gh_auth_fallback: true}, false),
    true,
    "explicit opt-in dominates a disabled environment default",
  )
}

pipeline test_canonical_policy_dominates_legacy_alias(task: any) {
  assert_eq(
    github_auth_fallback_enabled({allow_gh_auth_fallback: false, gh_auth_fallback: true}, true),
    false,
    "canonical opt-out dominates the legacy alias and environment",
  )
}

pipeline test_legacy_alias_precedes_environment_when_canonical_is_absent(task: any) {
  assert_eq(
    github_auth_fallback_enabled({gh_auth_fallback: false}, true),
    false,
    "legacy explicit opt-out dominates the environment default",
  )
  assert_eq(
    github_auth_fallback_enabled({gh_auth_fallback: true}, false),
    true,
    "legacy explicit opt-in remains supported",
  )
}

pipeline test_environment_is_only_the_absent_option_default(task: any) {
  assert_eq(github_auth_fallback_enabled({}, true), true, "enabled environment default")
  assert_eq(github_auth_fallback_enabled({}, false), false, "disabled environment default")
}

pipeline test_empty_explicit_token_reaches_typed_gh_fallback(harness: Harness) {
  const base = "https://api.github.test"
  harness.testing.http_mock(
    "GET",
    base + "/repos/octo-org/octo-repo/pulls?state=open",
    {status: 200, body: "[]", headers: {"x-ratelimit-remaining": "6"}},
  )
  const result = call(
    harness,
    "github.pr.list",
    {
      api_base_url: base,
      allow_gh_auth_fallback: true,
      gh_token: "",
      repo: "octo-org/octo-repo",
      filters: {state: "open"},
    },
  )
  if is_err(result) {
    assert_eq(
      unwrap_err(result).category,
      "auth",
      "an unavailable gh credential remains a structured auth error",
    )
  } else {
    assert_eq(len(unwrap(result)), 0, "an available gh credential reaches the mocked API")
  }
  harness.testing.http_mock_clear()
}
