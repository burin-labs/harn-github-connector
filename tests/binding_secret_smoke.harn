import { activate, init, normalize_inbound, shutdown } from "../src/facade"
import { fixture_raw } from "./helpers"

/**
 * Regression: `activate` must preserve a caller-supplied binding id verbatim so
 * a webhook with `metadata.binding_id` resolves the binding-scoped secret.
 */
pipeline test_binding_secret_smoke(harness: Harness, task) {
  const secret = "binding-scoped-secret"
  shutdown(harness)
  // No ctx-level signing secret: verification must fall back to the binding.
  init(harness, {})
  const activated = activate(
    harness,
    [{id: "primary", path: "/github/events", signing_secret: secret}],
  )
  assert_eq(activated.bindings, 1, "one binding activated")
  const raw = fixture_raw(
    harness.fs,
    "issues_opened",
    secret,
    "issues",
    {metadata: {binding_id: "primary"}},
  )
  const result = normalize_inbound(harness, raw)
  assert_eq(result.type, "event", "binding-scoped signing secret verifies the webhook")
  assert_eq(result.event.payload.issue.number, 7, "normalized issue number")
  shutdown(harness)
}
