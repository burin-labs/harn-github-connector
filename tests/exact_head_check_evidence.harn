import { call } from "../src/facade"

const BASE = "https://github-api.test"

const HEAD = "exact-head"

const AUTH = {api_base_url: BASE, installation_token: "fixture-token"}

fn check_run(overrides: any = {}) {
  return {
    id: 11,
    name: "CI",
    status: "completed",
    conclusion: "success",
    head_sha: HEAD,
    started_at: "2026-08-20T00:00:00Z",
    completed_at: "2026-08-20T00:01:00Z",
    details_url: "https://example.test/check/11",
  }
    + overrides
}

fn actions_check(run_id: int, overrides: any = {}) {
  return check_run(
    {
      id: run_id * 10,
      details_url: "https://github.com/octo-org/octo-repo/actions/runs/" + to_string(run_id)
        + "/job/1",
    }
      + overrides,
  )
}

fn workflow_run(id: int, workflow_id: int, overrides: any = {}) {
  return {
    id: id,
    workflow_id: workflow_id,
    path: ".github/workflows/" + to_string(workflow_id) + ".yml",
    name: "Workflow " + to_string(workflow_id),
    event: "pull_request",
    status: "completed",
    conclusion: "success",
    head_sha: HEAD,
    run_attempt: 1,
    html_url: "https://github.com/octo-org/octo-repo/actions/runs/" + to_string(id),
  }
    + overrides
}

fn status_context(overrides: any = {}) {
  return {
    id: 21,
    context: "legacy/policy",
    state: "success",
    created_at: "2026-08-20T00:00:00Z",
    updated_at: "2026-08-20T00:01:00Z",
    target_url: "https://example.test/status/21",
  }
    + overrides
}

fn mock_checks(
  testing: HarnessTesting,
  runs: any,
  total: int? = nil,
  workflow_runs: any = [],
  workflow_total: int? = nil,
) {
  testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/commits/" + HEAD
      + "/check-runs?filter=latest&per_page=100&page=1",
    {
      status: 200,
      body: json_stringify({total_count: total ?? len(runs), check_runs: runs}),
      headers: {"x-ratelimit-remaining": "20"},
    },
  )
  if len(workflow_runs) > 0 {
    testing.http_mock(
      "GET",
      BASE + "/repos/octo-org/octo-repo/actions/runs?head_sha=" + HEAD
        + "&per_page=100&page=1",
      {
        status: 200,
        body: json_stringify(
          {total_count: workflow_total ?? len(workflow_runs), workflow_runs: workflow_runs},
        ),
        headers: {"x-ratelimit-remaining": "18"},
      },
    )
  }
}

fn mock_statuses(
  testing: HarnessTesting,
  statuses: any,
  total: int? = nil,
  envelope_sha: string = HEAD,
) {
  testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/commits/" + HEAD
      + "/status?per_page=100&page=1",
    {
      status: 200,
      body: json_stringify(
        {sha: envelope_sha, total_count: total ?? len(statuses), statuses: statuses},
      ),
      headers: {"x-ratelimit-remaining": "19"},
    },
  )
}

fn read(harness: Harness) {
  return call(
    harness,
    "github.pr.checks",
    AUTH + {owner: "octo-org", repo: "octo-repo", head_sha: HEAD},
  )
}

fn assert_code(result: any, code: string) {
  require is_err(result), "mutated evidence fails closed"
  require unwrap_err(result).code == code, "mutated evidence returned the wrong error code"
}

pipeline test_exact_head_checks_join_legacy_statuses_and_preserve_counts(
  harness: Harness,
  task: unknown,
) {
  harness.testing.http_mock_clear()
  mock_checks(harness.testing, [check_run()])
  mock_statuses(harness.testing, [status_context()])
  const joined = unwrap(read(harness))
  assert_eq(joined.rollup.state, "green")
  assert_eq(joined.rollup.total, 2)
  assert_eq(joined.check_run_total, 1)
  assert_eq(joined.status_context_total, 1)
  assert_eq(joined.check_run_pages_fetched, 1)
  assert_eq(joined.status_context_pages_fetched, 1)
  assert_eq(joined.checks[1].name, "legacy/policy")
  assert_eq(joined.checks[1].external_id, "legacy-status:21")
  harness.testing.http_mock_clear()
  mock_checks(harness.testing, [check_run()])
  mock_statuses(harness.testing, [])
  const checks_only = unwrap(read(harness))
  assert_eq(checks_only.rollup.state, "green", "ordinary checks-only exact head remains green")
  assert_eq(checks_only.check_run_total, 1)
  assert_eq(checks_only.status_context_total, 0)
  harness.testing.http_mock_clear()
  mock_checks(harness.testing, [])
  mock_statuses(harness.testing, [])
  const empty = unwrap(read(harness))
  assert_eq(empty.rollup.total, 0)
  assert_eq(empty.rollup.state, "pending", "measuring nothing cannot read as green")
}

pipeline test_exact_head_check_mutations_fail_closed(harness: Harness, task: unknown) {
  // Valid fixture first proves this instrument can return a non-empty green set.
  harness.testing.http_mock_clear()
  mock_checks(harness.testing, [check_run()])
  mock_statuses(harness.testing, [status_context()])
  assert_eq(unwrap(read(harness)).rollup.state, "green")
  harness.testing.http_mock_clear()
  mock_checks(harness.testing, [check_run()], 2)
  assert_code(read(harness), "incomplete_page")
  harness.testing.http_mock_clear()
  mock_checks(harness.testing, [check_run()])
  mock_statuses(harness.testing, [status_context()], 2)
  assert_code(read(harness), "incomplete_page")
  harness.testing.http_mock_clear()
  mock_checks(harness.testing, [check_run({head_sha: "replacement-head"})])
  mock_statuses(harness.testing, [])
  assert_code(read(harness), "stale_head")
  harness.testing.http_mock_clear()
  mock_checks(harness.testing, [check_run()])
  mock_statuses(harness.testing, [status_context()], nil, "replacement-head")
  assert_code(read(harness), "stale_head")
  harness.testing.http_mock_clear()
  mock_checks(harness.testing, [check_run({name: ""})])
  mock_statuses(harness.testing, [])
  assert_code(read(harness), "ambiguous_check_context")
  harness.testing.http_mock_clear()
  mock_checks(harness.testing, [check_run()])
  mock_statuses(harness.testing, [status_context({context: "CI"})])
  const separate = unwrap(read(harness))
  assert_eq(separate.rollup.total, 2)
  assert_eq(len(separate.standalone_checks), 1)
  assert_eq(len(separate.legacy_statuses), 1)
  harness.testing.http_mock_clear()
  mock_checks(harness.testing, [actions_check(11)], nil, [workflow_run(11, 5)], 2)
  mock_statuses(harness.testing, [])
  assert_code(read(harness), "incomplete_page")
  harness.testing.http_mock_clear()
  mock_checks(
    harness.testing,
    [actions_check(11)],
    nil,
    [workflow_run(11, 5, {head_sha: "replacement-head"})],
  )
  mock_statuses(harness.testing, [])
  assert_code(read(harness), "stale_head")
  harness.testing.http_mock_clear()
  mock_checks(
    harness.testing,
    [actions_check(10, {head_sha: "replacement-head"}), actions_check(11)],
    nil,
    [workflow_run(10, 5), workflow_run(11, 5)],
  )
  mock_statuses(harness.testing, [])
  assert_code(read(harness), "stale_head")
}

pipeline test_same_head_replacement_generation_is_pending_not_cancelled(
  harness: Harness,
  task: unknown,
) {
  harness.testing.http_mock_clear()
  mock_checks(
    harness.testing,
    [
      actions_check(10, {status: "completed", conclusion: "cancelled"}),
      actions_check(11, {status: "queued", conclusion: nil}),
    ],
    nil,
    [
      workflow_run(10, 5, {status: "completed", conclusion: "cancelled"}),
      workflow_run(11, 5, {status: "queued", conclusion: nil}),
    ],
  )
  mock_statuses(harness.testing, [])
  const receipt = unwrap(read(harness))
  assert_eq(receipt.rollup.state, "pending")
  assert_eq(receipt.rollup.failed, 0, "superseded cancellation is not current failure evidence")
  assert_eq(len(receipt.generations), 1)
  assert_eq(receipt.generations[0].generation_id, "actions:11:attempt:1")
  assert_eq(receipt.generations[0].evidence_complete, false)
  assert_eq(receipt.evidence_complete, false)
}

pipeline test_replacement_generation_failure_remains_failing(harness: Harness, task: unknown) {
  harness.testing.http_mock_clear()
  mock_checks(
    harness.testing,
    [
      actions_check(10, {status: "completed", conclusion: "cancelled"}),
      actions_check(11, {status: "completed", conclusion: "failure"}),
    ],
    nil,
    [
      workflow_run(10, 5, {status: "completed", conclusion: "cancelled"}),
      workflow_run(11, 5, {status: "completed", conclusion: "failure"}),
    ],
  )
  mock_statuses(harness.testing, [])
  const receipt = unwrap(read(harness))
  assert_eq(receipt.rollup.state, "failing")
  assert_eq(receipt.generations[0].run_id, 11)
  assert_eq(receipt.generations[0].evidence_complete, true)
}

pipeline test_unmeasured_completed_replacement_generation_never_reads_green(
  harness: Harness,
  task: unknown,
) {
  harness.testing.http_mock_clear()
  mock_checks(
    harness.testing,
    [actions_check(10, {status: "completed", conclusion: "cancelled"})],
    nil,
    [
      workflow_run(10, 5, {status: "completed", conclusion: "cancelled"}),
      workflow_run(11, 5, {status: "completed", conclusion: "success"}),
    ],
  )
  mock_statuses(harness.testing, [])
  const receipt = unwrap(read(harness))
  assert_eq(receipt.rollup.state, "pending")
  assert_eq(receipt.rollup.successful, 0)
  assert_eq(receipt.generations[0].check_run_total, 0)
  assert_eq(receipt.generations[0].evidence_complete, false)
}

pipeline test_independently_restarted_workflows_do_not_hide_current_failure(
  harness: Harness,
  task: unknown,
) {
  harness.testing.http_mock_clear()
  mock_checks(
    harness.testing,
    [
      actions_check(10, {name: "CI", status: "completed", conclusion: "cancelled"}),
      actions_check(11, {name: "CI", status: "queued", conclusion: nil}),
      actions_check(20, {name: "Policy", status: "completed", conclusion: "failure"}),
    ],
    nil,
    [
      workflow_run(10, 5, {status: "completed", conclusion: "cancelled"}),
      workflow_run(11, 5, {status: "queued", conclusion: nil}),
      workflow_run(20, 6, {status: "completed", conclusion: "failure"}),
    ],
  )
  mock_statuses(harness.testing, [status_context({context: "Policy", state: "success"})])
  const receipt = unwrap(read(harness))
  assert_eq(receipt.rollup.state, "failing")
  assert_eq(len(receipt.generations), 2)
  assert_eq(len(receipt.legacy_statuses), 1, "legacy contexts remain a separate evidence set")
  assert_eq(receipt.legacy_statuses[0].external_id, "legacy-status:21")
}

fn mock_empty_run_listing(testing: HarnessTesting) {
  testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/actions/runs?head_sha=" + HEAD + "&per_page=100&page=1",
    {
      status: 200,
      body: json_stringify({total_count: 0, workflow_runs: []}),
      headers: {"x-ratelimit-remaining": "18"},
    },
  )
}

fn mock_run_by_id(testing: HarnessTesting, id: int, run: any) {
  testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/actions/runs/" + to_string(id),
    {status: 200, body: json_stringify(run), headers: {"x-ratelimit-remaining": "17"}},
  )
}

/**
 * The race this operation used to report as missing evidence.
 *
 * A run created seconds before the read is in the commit's check list and not
 * yet in the listing filtered by that head. Before the direct read, this exact
 * shape refused with `incomplete_page` and said the check could not be
 * attributed, which named the check rather than the index that lagged.
 */
pipeline test_a_run_absent_from_the_filtered_listing_is_resolved_by_id(
  harness: Harness,
  task: unknown,
) {
  harness.testing.http_mock_clear()
  mock_checks(harness.testing, [actions_check(31)])
  mock_empty_run_listing(harness.testing)
  mock_run_by_id(harness.testing, 31, workflow_run(31, 7))
  mock_statuses(harness.testing, [])
  const resolved = unwrap(read(harness))
  assert_eq(resolved.rollup.state, "green")
  assert_eq(resolved.rollup.total, 1)
  assert_eq(resolved.evidence_complete, true, "the resolved run completes the generation")
  assert_eq(len(resolved.generations), 1, "the resolved run is a generation, not an exemption")
  assert_eq(resolved.generations[0].run_id, 31)
}

/**
 * The negative control. Resolving by id must not become a way to skip the head
 * comparison: a run that belongs to a different commit still refuses, and it
 * refuses on the head, not on the attribution.
 */
pipeline test_a_resolved_run_on_another_head_still_refuses(harness: Harness, task: unknown) {
  harness.testing.http_mock_clear()
  mock_checks(harness.testing, [actions_check(32)])
  mock_empty_run_listing(harness.testing)
  mock_run_by_id(harness.testing, 32, workflow_run(32, 7, {head_sha: "some-other-head"}))
  mock_statuses(harness.testing, [])
  assert_code(read(harness), "stale_head")
}

/**
 * A check naming a run the direct read cannot produce is still a refusal. The
 * resolution answers "has the index caught up", never "does this run exist".
 */
pipeline test_a_run_that_cannot_be_read_is_still_a_refusal(harness: Harness, task: unknown) {
  harness.testing.http_mock_clear()
  mock_checks(harness.testing, [actions_check(33)])
  mock_empty_run_listing(harness.testing)
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/actions/runs/33",
    {status: 404, body: json_stringify({message: "Not Found"}), headers: {}},
  )
  mock_statuses(harness.testing, [])
  require is_err(read(harness)), "an unreadable run must not complete the evidence"
}
