pipeline test_delta_rejects_a_base_oid_that_is_not_the_local_head(harness: Harness, task) {
  harness.testing.http_mock_clear()
  mock_forbid_everything(harness.testing)
  const dir = new_repo({fs: harness.fs, process: harness.process})
  harness.fs.write_text(dir + "/keep.txt", "changed\n")
  const result = github_commit_worktree(
    harness,
    {
      owner: OWNER,
      repo: REPO,
      branch: BRANCH,
      headline: "Publish worktree",
      body: nil,
      repo_dir: dir,
      source: "worktree",
      base_oid: OTHER_OID,
      create_branch: true,
      reset_branch: false,
    },
    options(),
  )
  expect(is_err(result), "mismatched base rejected")
  const error = unwrap_err(result)
  assert_eq(error.code, "stale_head", "base mismatch code")
  assert_eq(error.expected_head_oid, OTHER_OID, "requested base")
  assert_eq(error.observed_head_oid, head_oid(harness.process, dir), "local HEAD")
  assert_eq(len(harness.testing.http_mock_calls()), 0, "no network request")
  drop_repo({fs: harness.fs, process: harness.process}, dir)
  harness.testing.http_mock_clear()
}
