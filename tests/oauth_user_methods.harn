import {
  call,
  oauth_user_device_code,
  oauth_user_device_poll,
  oauth_user_exchange_code,
  oauth_user_refresh,
} from "../src/facade"

pipeline test_oauth_user_methods(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  const oauth_base = "https://github.test"
  const client_id = "Iv1.abc123"
  const opts = {oauth_base_url: oauth_base}
  // Device code request.
  harness.testing.http_mock(
    "POST",
    oauth_base + "/login/device/code",
    {
      status: 200,
      body: json_stringify(
        {
          device_code: "dc-123",
          user_code: "WDJB-MJHT",
          verification_uri: "https://github.com/login/device",
          expires_in: 900,
          interval: 5,
        },
      ),
    },
  )
  const device = unwrap(
    oauth_user_device_code(harness, {client_id: client_id, scope: "repo", options: opts}),
  )
  assert_eq(device.device_code, "dc-123", "device code")
  assert_eq(device.user_code, "WDJB-MJHT", "user code")
  // Device poll: pending then granted.
  harness.testing.http_mock(
    "POST",
    oauth_base + "/login/oauth/access_token",
    {
      responses: [
        {status: 200, body: json_stringify({error: "authorization_pending"})},
        {
          status: 200,
          body: json_stringify(
            {
              access_token: "ghu_user1",
              token_type: "bearer",
              scope: "repo",
              expires_in: 28800,
              refresh_token: "ghr_refresh1",
              refresh_token_expires_in: 15897600,
            },
          ),
        },
      ],
    },
  )
  const poll_request = {client_id: client_id, device_code: "dc-123", options: opts}
  const pending = unwrap(oauth_user_device_poll(harness, poll_request))
  assert_eq(pending.error, "authorization_pending", "poll pending")
  const granted = unwrap(oauth_user_device_poll(harness, poll_request))
  assert_eq(granted.access_token, "ghu_user1", "granted user token")
  assert_eq(granted.refresh_token, "ghr_refresh1", "granted refresh token")
  // Web-flow code exchange.
  harness.testing.http_mock(
    "POST",
    oauth_base + "/login/oauth/access_token",
    {
      status: 200,
      body: json_stringify(
        {access_token: "ghu_user2", refresh_token: "ghr_refresh2", expires_in: 28800},
      ),
    },
  )
  const exchanged = unwrap(
    oauth_user_exchange_code(
      harness,
      {client_id: client_id, code: "web-code", client_secret: "shh", options: opts},
    ),
  )
  assert_eq(exchanged.access_token, "ghu_user2", "exchanged token")
  // Refresh rotates the refresh token.
  harness.testing.http_mock(
    "POST",
    oauth_base + "/login/oauth/access_token",
    {
      status: 200,
      body: json_stringify(
        {access_token: "ghu_user3", refresh_token: "ghr_rotated", expires_in: 28800},
      ),
    },
  )
  const refreshed = unwrap(
    oauth_user_refresh(
      harness,
      {client_id: client_id, refresh_token: "ghr_refresh2", options: opts},
    ),
  )
  assert_eq(refreshed.access_token, "ghu_user3", "refreshed token")
  assert_eq(refreshed.refresh_token, "ghr_rotated", "refresh token rotates")
  // Missing client_id is rejected before any network call.
  const bad = call(harness, "oauth.user.device_code", {})
  assert(is_err(bad), "missing client_id rejected")
  assert_eq(unwrap_err(bad).category, "schema_drift", "missing client_id category")
  const calls = harness.testing.http_mock_calls()
  const device_body: {client_id: string, scope: string} = json_parse(calls[0].body)
  const poll_body: {grant_type: string} = json_parse(calls[1].body)
  const refresh_body: {grant_type: string, refresh_token: string} = json_parse(calls[4].body)
  assert_eq(device_body.client_id, client_id, "device code client id")
  assert_eq(device_body.scope, "repo", "device code scope")
  assert_eq(
    poll_body.grant_type,
    "urn:ietf:params:oauth:grant-type:device_code",
    "device poll grant type",
  )
  assert_eq(refresh_body.grant_type, "refresh_token", "refresh grant type")
  assert_eq(refresh_body.refresh_token, "ghr_refresh2", "refresh sends old token")
  harness.testing.http_mock_clear()
}
