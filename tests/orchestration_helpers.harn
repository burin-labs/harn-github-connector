import {
  github_close_pr,
  github_dispatch_workflow_and_resolve_run,
  github_dispatch_workflow_and_wait,
  github_ensure_auto_merge,
  github_find_open_pr,
  github_wait_for_pr_checks,
  github_wait_for_workflow_run,
} from "../src/lib"

const BASE = "https://github-api.test"

const TOKEN = "github-installation-token"

fn auth() {
  return {api_base_url: BASE, installation_token: TOKEN, poll_interval_ms: 0, max_attempts: 5}
}

fn run_payload(id, status, conclusion = nil, created_at = "2026-05-06T18:00:00Z") {
  return {
    id: id,
    status: status,
    conclusion: conclusion,
    workflow_id: 4242,
    path: ".github/workflows/release.yml",
    run_attempt: 1,
    head_sha: "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef",
    head_branch: "main",
    event: "workflow_dispatch",
    created_at: created_at,
    run_started_at: created_at,
    updated_at: created_at,
    html_url: "https://github.com/octo-org/octo-repo/actions/runs/" + to_string(id),
  }
}

fn dispatch_returning(run_id) {
  return json_stringify({workflow_run_id: run_id})
}

fn dispatch_204() {
  return ""
}

pipeline test_dispatch_identity_hydrates_returned_run_id_after_eventual_consistency(
  harness: Harness,
  task,
) {
  harness.testing.http_mock_clear()
  const runs_url = BASE
    + "/repos/octo-org/octo-repo/actions/workflows/identity-returned.yml/runs?branch=main&event=workflow_dispatch&per_page=10"
  harness.testing.http_mock(
    "GET",
    runs_url,
    {
      responses: [
        {
          status: 200,
          body: json_stringify({total_count: 0, workflow_runs: []}),
          headers: {"x-ratelimit-remaining": "31"},
        },
      ],
    },
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/repos/octo-org/octo-repo/actions/workflows/identity-returned.yml/dispatches",
    {status: 200, body: dispatch_returning(321), headers: {"x-ratelimit-remaining": "30"}},
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/actions/runs/321",
    {
      responses: [
        {
          status: 404,
          body: json_stringify({message: "Not Found"}),
          headers: {"x-ratelimit-remaining": "29"},
        },
        {
          status: 200,
          body: json_stringify(run_payload(321, "queued", nil)),
          headers: {"x-ratelimit-remaining": "28"},
        },
      ],
    },
  )
  const result = github_dispatch_workflow_and_resolve_run(
    harness,
    "octo-org",
    "octo-repo",
    "identity-returned.yml",
    "main",
    nil,
    auth(),
  )
  assert_eq(result.ok, true, "returned run identity succeeds")
  assert_eq(result.status, "dispatch_accepted", "identity boundary status")
  assert_eq(result.run_id, 321, "returned run id is pinned")
  assert_eq(result.candidate_run_ids, [321], "returned identity is structured")
  assert_eq(
    result.head_sha,
    "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef",
    "direct-id dispatch hydrates the observed source sha",
  )
  assert_eq(result.head_branch, "main", "direct-id dispatch hydrates the observed source branch")
  assert_eq(result.event, "workflow_dispatch", "direct-id dispatch hydrates the observed event")
  assert_eq(
    result.workflow_path,
    ".github/workflows/release.yml",
    "direct-id dispatch hydrates the workflow path",
  )
  assert_eq(result.run_attempt, 1, "direct-id dispatch hydrates the run attempt")
  assert(result.run_url.contains("/actions/runs/321"), "direct-id dispatch hydrates the run URL")
  assert_eq(result.conclusion, nil, "terminal state is not observed")
  assert_eq(result.timed_out, false, "identity resolution did not time out")
  const calls = harness.testing.http_mock_calls()
  assert_eq(len(calls), 3, "identity boundary retries only the exact returned run")
  assert_eq(calls[0].method, "POST", "dispatch is the first request")
  assert_eq(calls[1].url, calls[2].url, "eventual-consistency retry keeps the exact run identity")
  harness.testing.http_mock_clear()
}

pipeline test_dispatch_with_run_id_completes_success(harness: Harness, task) {
  harness.testing.http_mock_clear()
  const runs_url = BASE
    + "/repos/octo-org/octo-repo/actions/workflows/bump-harn.yml/runs?branch=main&event=workflow_dispatch&per_page=10"
  harness.testing.http_mock(
    "GET",
    runs_url,
    {
      responses: [
        {
          status: 200,
          body: json_stringify({total_count: 0, workflow_runs: []}),
          headers: {"x-ratelimit-remaining": "31"},
        },
      ],
    },
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/repos/octo-org/octo-repo/actions/workflows/bump-harn.yml/dispatches",
    {status: 200, body: dispatch_returning(123), headers: {"x-ratelimit-remaining": "30"}},
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/actions/runs/123",
    {
      responses: [
        {
          status: 200,
          body: json_stringify(run_payload(123, "in_progress", nil)),
          headers: {"x-ratelimit-remaining": "29"},
        },
        {
          status: 200,
          body: json_stringify(run_payload(123, "completed", "success")),
          headers: {"x-ratelimit-remaining": "28"},
        },
      ],
    },
  )
  const result = github_dispatch_workflow_and_wait(
    harness,
    "octo-org",
    "octo-repo",
    "bump-harn.yml",
    "main",
    {version: "v0.7.59"},
    auth(),
  )
  assert_eq(result.ok, true, "dispatch+wait succeeds")
  assert_eq(result.status, "completed", "status completed")
  assert_eq(result.conclusion, "success", "conclusion success")
  assert_eq(result.run_id, 123, "run id from dispatch")
  assert_eq(result.workflow_id, 4242, "workflow id from run")
  assert_eq(
    result.head_sha,
    "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef",
    "terminal run preserves source sha",
  )
  assert_eq(result.head_branch, "main", "terminal run preserves source branch")
  assert_eq(result.event, "workflow_dispatch", "terminal run preserves event")
  assert(result.run_url.contains("/actions/runs/123"), "run url")
  assert_eq(result.timed_out, false, "not timed out")
  assert(len(result.attempts) >= 2, "polled at least twice")
  assert_eq(result.candidate_run_ids, [123], "returned run id is the only candidate")
  const calls = harness.testing.http_mock_calls()
  assert_eq(len(calls), 3, "dispatch and two direct run probes")
  assert_eq(calls[0].method, "POST", "dispatch is the first request")
  assert_eq(
    calls[1].url,
    BASE + "/repos/octo-org/octo-repo/actions/runs/123",
    "returned id is the fast path",
  )
  assert_eq(
    calls[2].url,
    BASE + "/repos/octo-org/octo-repo/actions/runs/123",
    "returned id stays pinned",
  )
  harness.testing.http_mock_clear()
}

pipeline test_dispatch_identity_rejects_legacy_204_without_correlation(harness: Harness, task) {
  harness.testing.http_mock_clear()
  const sha = "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef"
  const runs_url = BASE
    + "/repos/octo-org/octo-repo/actions/workflows/release.yml/runs?branch=main&event=workflow_dispatch&head_sha="
    + sha
    + "&per_page=10"
  harness.testing.http_mock(
    "GET",
    runs_url,
    {
      responses: [
        {
          status: 200,
          body: json_stringify(
            {
              total_count: 1,
              workflow_runs: [run_payload(900, "completed", "success", "2035-01-01T00:00:00Z")],
            },
          ),
          headers: {"x-ratelimit-remaining": "21"},
        },
        {
          status: 200,
          body: json_stringify(
            {
              total_count: 5,
              workflow_runs: [
                run_payload(900, "completed", "success", "2035-01-01T00:00:00Z"),
                run_payload(901, "in_progress", nil, "not-a-timestamp"),
                run_payload(902, "queued") + {event: "push"},
                run_payload(903, "queued") + {head_branch: "other"},
                run_payload(904, "queued") + {head_sha: "cafebabecafebabecafebabecafebabecafebabe"},
              ],
            },
          ),
          headers: {"x-ratelimit-remaining": "19"},
        },
      ],
    },
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/repos/octo-org/octo-repo/actions/workflows/release.yml/dispatches",
    {status: 204, body: dispatch_204(), headers: {"x-ratelimit-remaining": "20"}},
  )
  const result = github_dispatch_workflow_and_resolve_run(
    harness,
    "octo-org",
    "octo-repo",
    "release.yml",
    "main",
    nil,
    auth() + {head_sha: sha},
  )
  assert_eq(result.status, "dispatch_identity_missing", "legacy response fails closed")
  assert_eq(result.ok, false, "legacy response cannot authorize correlation")
  assert_eq(result.run_id, nil, "no listed run is guessed")
  assert_eq(result.candidate_run_ids, [], "no candidate identity is inferred")
  assert_eq(result.error.code, "dispatch_identity_missing", "failure is typed")
  const calls = harness.testing.http_mock_calls()
  assert_eq(len(calls), 1, "legacy response never triggers a workflow-list query")
  assert_eq(calls[0].method, "POST", "only the dispatch request is sent")
  harness.testing.http_mock_clear()
}

pipeline test_dispatch_missing_identity_never_considers_ambiguous_list_rows(
  harness: Harness,
  task,
) {
  harness.testing.http_mock_clear()
  const runs_url = BASE
    + "/repos/octo-org/octo-repo/actions/workflows/ambiguous.yml/runs?branch=main&event=workflow_dispatch&per_page=10"
  harness.testing.http_mock(
    "GET",
    runs_url,
    {
      responses: [
        {
          status: 200,
          body: json_stringify(
            {total_count: 1, workflow_runs: [run_payload(800, "completed", "success")]},
          ),
          headers: {"x-ratelimit-remaining": "12"},
        },
        {
          status: 200,
          body: json_stringify(
            {
              total_count: 3,
              workflow_runs: [
                run_payload(800, "completed", "success"),
                run_payload(801, "queued", nil, "2020-01-01T00:00:00Z"),
                run_payload(802, "queued", nil, "2030-01-01T00:00:00Z"),
              ],
            },
          ),
          headers: {"x-ratelimit-remaining": "10"},
        },
      ],
    },
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/repos/octo-org/octo-repo/actions/workflows/ambiguous.yml/dispatches",
    {status: 204, body: dispatch_204(), headers: {"x-ratelimit-remaining": "11"}},
  )
  const result = github_dispatch_workflow_and_wait(
    harness,
    "octo-org",
    "octo-repo",
    "ambiguous.yml",
    "main",
    nil,
    auth(),
  )
  assert_eq(result.ok, false, "missing dispatch identity fails closed")
  assert_eq(result.status, "dispatch_identity_missing", "missing identity is typed")
  assert_eq(result.run_id, nil, "no listed run is pinned")
  assert_eq(result.candidate_run_ids, [], "list rows are never considered")
  assert_eq(result.error.code, "dispatch_identity_missing", "typed error is preserved")
  assert_eq(result.timed_out, false, "missing identity terminates immediately")
  assert_eq(len(harness.testing.http_mock_calls()), 1, "workflow runs are never listed")
  harness.testing.http_mock_clear()
}

pipeline test_dispatch_identity_missing_does_not_poll_for_a_run(harness: Harness, task) {
  harness.testing.http_mock_clear()
  const runs_url = BASE
    + "/repos/octo-org/octo-repo/actions/workflows/never.yml/runs?branch=main&event=workflow_dispatch&per_page=10"
  harness.testing.http_mock(
    "GET",
    runs_url,
    {
      responses: [
        {status: 200, body: json_stringify({total_count: 0, workflow_runs: []})},
        {status: 200, body: json_stringify({total_count: 0, workflow_runs: []})},
        {status: 200, body: json_stringify({total_count: 0, workflow_runs: []})},
        {status: 200, body: json_stringify({total_count: 0, workflow_runs: []})},
      ],
    },
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/repos/octo-org/octo-repo/actions/workflows/never.yml/dispatches",
    {status: 204, body: "", headers: {"x-ratelimit-remaining": "10"}},
  )
  const result = github_dispatch_workflow_and_resolve_run(
    harness,
    "octo-org",
    "octo-repo",
    "never.yml",
    "main",
    nil,
    auth() + {max_attempts: 3},
  )
  assert_eq(result.ok, false, "ok=false when never found")
  assert_eq(result.status, "dispatch_identity_missing", "status is fail-closed")
  assert_eq(result.timed_out, false, "missing identity is not a timeout")
  assert_eq(result.run_id, nil, "run_id=nil")
  assert_eq(
    len(harness.testing.http_mock_calls()),
    1,
    "the connector does not poll after a legacy response",
  )
  harness.testing.http_mock_clear()
}

pipeline test_dispatch_returns_dispatch_failed(harness: Harness, task) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    BASE
      + "/repos/octo-org/octo-repo/actions/workflows/broken.yml/runs?branch=main&event=workflow_dispatch&per_page=10",
    {responses: [{status: 200, body: json_stringify({total_count: 0, workflow_runs: []})}]},
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/repos/octo-org/octo-repo/actions/workflows/broken.yml/dispatches",
    {
      status: 422,
      body: "{\"message\":\"workflow does not have a workflow_dispatch trigger\"}",
      headers: {"x-ratelimit-remaining": "5"},
    },
  )
  const result = github_dispatch_workflow_and_resolve_run(
    harness,
    "octo-org",
    "octo-repo",
    "broken.yml",
    "main",
    nil,
    auth(),
  )
  assert_eq(result.ok, false, "ok=false")
  assert_eq(result.status, "dispatch_failed", "status=dispatch_failed")
  assert(result.error != nil, "error captured")
  assert_eq(len(harness.testing.http_mock_calls()), 1, "dispatch failure is returned directly")
  harness.testing.http_mock_clear()
}

pipeline test_dispatch_does_not_query_workflow_runs_before_post(harness: Harness, task) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    BASE
      + "/repos/octo-org/octo-repo/actions/workflows/private.yml/runs?branch=main&event=workflow_dispatch&per_page=10",
    {
      responses: [
        {
          status: 403,
          body: json_stringify({message: "Resource not accessible by integration"}),
          headers: {"x-ratelimit-remaining": "5"},
        },
      ],
    },
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/repos/octo-org/octo-repo/actions/workflows/private.yml/dispatches",
    {status: 200, body: dispatch_returning(55)},
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/actions/runs/55",
    {status: 200, body: json_stringify(run_payload(55, "queued"))},
  )
  const result = github_dispatch_workflow_and_resolve_run(
    harness,
    "octo-org",
    "octo-repo",
    "private.yml",
    "main",
    nil,
    auth(),
  )
  assert_eq(result.ok, true, "dispatch does not depend on a list-runs permission probe")
  assert_eq(result.status, "dispatch_accepted", "returned run id is hydrated directly")
  const calls = harness.testing.http_mock_calls()
  assert_eq(len(calls), 2, "only dispatch and exact-run hydration are requested")
  assert_eq(calls[0].method, "POST", "dispatch is first")
  assert(calls[1].url.ends_with("/actions/runs/55"), "exact returned run is hydrated")
  harness.testing.http_mock_clear()
}

pipeline test_wait_for_workflow_run_times_out_with_known_run(harness: Harness, task) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/actions/runs/777",
    {
      responses: [
        {
          status: 200,
          body: json_stringify(run_payload(777, "in_progress", nil)),
          headers: {"x-ratelimit-remaining": "5"},
        },
        {
          status: 200,
          body: json_stringify(run_payload(777, "in_progress", nil)),
          headers: {"x-ratelimit-remaining": "4"},
        },
      ],
    },
  )
  const result = github_wait_for_workflow_run(
    harness,
    "octo-org",
    "octo-repo",
    777,
    auth() + {max_attempts: 2},
  )
  assert_eq(result.status, "timed_out", "status=timed_out")
  assert_eq(result.timed_out, true, "timed_out flag set")
  assert_eq(result.run_id, 777, "still surfaces last known run")
  assert_eq(
    result.head_sha,
    "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef",
    "timeout preserves source sha",
  )
  assert_eq(result.head_branch, "main", "timeout preserves source branch")
  assert_eq(result.event, "workflow_dispatch", "timeout preserves source event")
  assert_eq(result.ok, false, "ok=false on timeout")
  harness.testing.http_mock_clear()
}

pipeline test_ensure_auto_merge_already_enabled(harness: Harness, task) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/pulls/9",
    {
      status: 200,
      body: json_stringify(
        {
          number: 9,
          node_id: "PR_node_9",
          html_url: "https://github.com/octo-org/octo-repo/pull/9",
          head: {sha: "abc"},
          auto_merge: {merge_method: "SQUASH", enabled_by: {login: "octocat"}},
        },
      ),
      headers: {"x-ratelimit-remaining": "20"},
    },
  )
  const result = unwrap(
    github_ensure_auto_merge(
      harness,
      "octo-org",
      "octo-repo",
      9,
      auth() + {method: "squash", expected_head_oid: "abc"},
    ),
  )
  assert_eq(result.state, "already_enabled", "already_enabled state")
  assert_eq(result.already_enabled, true, "already_enabled flag")
  assert_eq(result.merge_method, "SQUASH", "merge method recorded from existing auto_merge")
  harness.testing.http_mock_clear()
}

pipeline test_ensure_auto_merge_enables_via_graphql(harness: Harness, task) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/pulls/12",
    {
      status: 200,
      body: json_stringify(
        {
          number: 12,
          node_id: "PR_node_12",
          html_url: "https://github.com/octo-org/octo-repo/pull/12",
          head: {sha: "fff"},
          auto_merge: nil,
        },
      ),
      headers: {"x-ratelimit-remaining": "19"},
    },
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {
          data: {
            enablePullRequestAutoMerge: {
              actor: {login: "octocat"},
              pullRequest: {
                number: 12,
                url: "https://github.com/octo-org/octo-repo/pull/12",
                mergeStateStatus: "CLEAN",
                autoMergeRequest: {enabledAt: "2026-05-06T18:00:00Z", mergeMethod: "MERGE"},
              },
            },
          },
        },
      ),
      headers: {"x-ratelimit-remaining": "18"},
    },
  )
  const result = unwrap(
    github_ensure_auto_merge(
      harness,
      "octo-org",
      "octo-repo",
      12,
      auth() + {expected_head_oid: "fff"},
    ),
  )
  assert_eq(result.state, "enabled", "state=enabled")
  assert_eq(result.already_enabled, false, "not already enabled")
  assert_eq(result.merge_method, "MERGE", "default method MERGE")
  assert_eq(result.url, "https://github.com/octo-org/octo-repo/pull/12", "url surfaced")
  harness.testing.http_mock_clear()
}

pipeline test_ensure_auto_merge_failed(harness: Harness, task) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/pulls/77",
    {status: 404, body: "{\"message\":\"Not Found\"}", headers: {"x-ratelimit-remaining": "10"}},
  )
  const result = github_ensure_auto_merge(
    harness,
    "octo-org",
    "octo-repo",
    77,
    auth() + {expected_head_oid: "missing"},
