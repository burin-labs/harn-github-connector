import { GithubPullRequestReviewCensusRequest, github_pr_review_census } from "../src/facade"

const BASE = "https://github-api.test"

const HEAD = "cccccccccccccccccccccccccccccccccccccccc"

const OTHER = "dddddddddddddddddddddddddddddddddddddddd"

fn identity(head: string = HEAD) {
  return {
    number: 42,
    headRefOid: head,
    baseRefOid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    reviewDecision: "APPROVED",
    author: {id: "source-author", login: "author", type: "User"},
    state: "OPEN",
    isDraft: false,
    headRepository: {id: "repository-id", nameWithOwner: "octo-org/octo-repo"},
    baseRepository: {id: "repository-id", nameWithOwner: "octo-org/octo-repo"},
  }
}

fn review(
  id: string,
  commit: string? = HEAD,
  author: any = {id: "actor", login: "reviewer", type: "Bot"},
) {
  return {
    id: id,
    state: "APPROVED",
    commit: if commit == nil {
      nil
    } else {
      {oid: commit}
    },
    author: author,
    updatedAt: "2026-10-14T16:00:00Z",
    submittedAt: "2026-10-14T15:00:00Z",
  }
}

fn thread(id: string, resolved: bool = false) {
  return {id: id, isResolved: resolved, isOutdated: false}
}

fn page(nodes: list<any>, total: int, next: bool = false, cursor: string? = nil) {
  return identity()
    + {
      inventory: {
        totalCount: total,
        nodes: nodes,
        pageInfo: {hasNextPage: next, endCursor: cursor},
      },
    }
}

fn final(reviews: int, threads: int) {
  return identity() + {reviews: {totalCount: reviews}, reviewThreads: {totalCount: threads}}
}

fn mock(testing: HarnessTesting, pulls: list<any>) {
  testing.http_mock(
    "POST",
    BASE + "/graphql",
    {
      responses: pulls.map(
        { pull -> {status: 200, body: json_stringify({data: {repository: {pullRequest: pull}}})} },
      ),
    },
  )
}

fn read(harness: Harness, options: dict = {}) {
  const request: GithubPullRequestReviewCensusRequest = schema_expect(
    {
      owner: "octo-org",
      repo: "octo-repo",
      pull_number: 42,
      expected_head_oid: HEAD,
      options: {api_base_url: BASE, installation_token: "fixture-token"},
    }
      + options,
    schema_of(GithubPullRequestReviewCensusRequest),
  )
  return github_pr_review_census(harness, request)
}

pipeline test_review_census_reaches_both_complete_inventories_and_retains_unknown_actors(
  harness: Harness,
) {
  mock(
    harness.testing,
    [
      page([review("review-1")], 2, true, "review-cursor"),
      page([review("review-2", OTHER, nil)], 2),
      page([thread("thread-1")], 2, true, "thread-cursor"),
      page([thread("thread-2", true)], 2),
      final(2, 2),
    ],
  )
  const result = unwrap(read(harness, {per_page: 1}))
  assert_eq(result.head_oid, HEAD)
  assert_eq(result.total_reviews, 2)
  assert_eq(result.total_threads, 2)
  assert_eq(result.pages_fetched, 4)
  assert_eq(result.author.id, "source-author")
  assert_eq(result.state, "OPEN")
  assert_eq(result.is_draft, false)
  assert_eq(result.head_repository.id, "repository-id")
  assert_eq(result.base_repository.full_name, "octo-org/octo-repo")
  assert_eq(result.reviews[0].submitted_at, "2026-10-14T15:00:00Z")
  assert_eq(result.reviews[0].updated_at, "2026-10-14T16:00:00Z")
  assert_eq(result.reviews[0].author?.id, "actor")
  assert_eq(result.reviews[1].author, nil)
  assert_eq(
    result.reviews[1].commit_oid,
    OTHER,
    "an old approval must not become a current-head vote",
  )
  assert_eq(result.threads.map({ row -> row.resolved }), [false, true])
  assert_eq(
    len(harness.testing.http_mock_calls()),
    5,
    "four data pages and final confirmation fired",
  )
}

pipeline test_review_census_refuses_absent_partial_overcount_and_malformed_pages(harness: Harness) {
  for bad in [
    nil,
    identity(),
    page([], 1),
    page([review("r")], 2),
    page([review("r"), review("s")], 1),
    page([review("r"), review("r")], 2),
    page([], -1),
    page([], 2001),
    page([nil], 1),
    page([review("r") + {state: "future-unknown"}], 1),
    page([review("r") + {updatedAt: ""}], 1),
    page([review("r") + {submittedAt: ""}], 1),
    page([review("r")], 1) + {author: {id: "", login: "author", type: "User"}},
    page([review("r")], 1) + {headRepository: {id: "", nameWithOwner: "octo-org/octo-repo"}},
    page([review("r")], 1) + {state: "UNKNOWN"},
    page([review("r", "malformed")], 1),
  ] {
    harness.testing.http_mock_clear()
    mock(harness.testing, [bad, page([], 0), final(1, 0)])
    assert(is_err(read(harness)), "an incomplete review inventory must never qualify")
  }
}

pipeline test_review_census_refuses_repeated_cursor_duplicate_page_and_changed_count(
  harness: Harness,
) {
  for second in [
    page([review("r")], 2),
    page([review("s")], 3),
    page([review("s")], 3, true, "cursor"),
    page([], 2),
  ] {
    harness.testing.http_mock_clear()
    mock(harness.testing, [page([review("r")], 2, true, "cursor"), second])
    assert(is_err(read(harness, {per_page: 1})))
  }
  harness.testing.http_mock_clear()
  mock(harness.testing, [page([review("r")], 2, true, "cursor")])
  assert(is_err(read(harness, {per_page: 1, max_pages: 1})))
}

pipeline test_review_census_refuses_changed_head_base_decision_or_final_counts(harness: Harness) {
  for last in [
    final(1, 0) + {headRefOid: OTHER},
    final(1, 0) + {baseRefOid: OTHER},
    final(1, 0) + {reviewDecision: "CHANGES_REQUESTED"},
    final(1, 0) + {author: nil},
    final(1, 0) + {state: "CLOSED"},
    final(1, 0) + {isDraft: true},
    final(1, 0) + {headRepository: nil},
    final(1, 0) + {baseRepository: {id: "renamed-id", nameWithOwner: "octo-org/octo-repo"}},
    final(2, 0),
    final(1, 1),
    nil,
  ] {
    harness.testing.http_mock_clear()
    mock(harness.testing, [page([review("r")], 1), page([], 0), last])
    assert_eq(unwrap_err(read(harness)).code, "stale_head")
  }
  harness.testing.http_mock_clear()
  mock(harness.testing, [page([review("r")], 1) + {headRefOid: OTHER}])
  assert_eq(unwrap_err(read(harness)).code, "stale_head")
}

pipeline test_review_census_measures_zero_and_keeps_missing_commit_unknown(harness: Harness) {
  mock(harness.testing, [page([], 0), page([], 0), final(0, 0)])
  const empty = unwrap(read(harness))
  assert_eq(empty.total_reviews, 0)
  assert_eq(empty.total_threads, 0)
  assert_eq(
    len(harness.testing.http_mock_calls()),
    3,
    "zero requires both page reads and confirmation",
  )
  harness.testing.http_mock_clear()
  mock(harness.testing, [page([review("r", nil)], 1), page([], 0), final(1, 0)])
  assert_eq(unwrap(read(harness)).reviews[0].commit_oid, nil)
}

pipeline test_review_census_retains_unknown_source_and_submission_facts(harness: Harness) {
  const unknown = {author: nil, headRepository: nil, baseRepository: nil}
  const row = review("r") + {submittedAt: nil}
  mock(harness.testing, [page([row], 1) + unknown, page([], 0) + unknown, final(1, 0) + unknown])
  const result = unwrap(read(harness))
  assert_eq(result.author, nil)
  assert_eq(result.head_repository, nil)
  assert_eq(result.base_repository, nil)
  assert_eq(result.reviews[0].submitted_at, nil)
  assert_eq(result.reviews[0].updated_at, "2026-10-14T16:00:00Z")
  assert_eq(len(harness.testing.http_mock_calls()), 3)
}

pipeline test_review_census_refuses_source_identity_drift_between_pages(harness: Harness) {
  for changed in [
    {author: nil},
    {isDraft: true},
    {state: "MERGED"},
    {headRepository: {id: "fork-id", nameWithOwner: "someone/fork"}},
    {baseRepository: nil},
  ] {
    harness.testing.http_mock_clear()
    mock(
      harness.testing,
      [page([review("r")], 2, true, "cursor"), page([review("s")], 2) + changed],
    )
    assert_eq(unwrap_err(read(harness, {per_page: 1})).code, "stale_head")
    assert_eq(
      len(harness.testing.http_mock_calls()),
      2,
      "drift refuses before thread or final reads",
    )
  }
}

pipeline test_review_census_refuses_invalid_request_before_any_http_effect(harness: Harness) {
  for invalid in [
    {expected_head_oid: ""},
    {per_page: 0},
    {per_page: 101},
    {max_pages: 0},
    {max_pages: 21},
    {maximum_count: -1},
    {maximum_count: 2001},
  ] {
    assert_eq(unwrap_err(read(harness, invalid)).code, "schema_drift")
  }
  assert_eq(len(harness.testing.http_mock_calls()), 0)
}

pipeline test_review_census_never_accepts_a_partial_graphql_error_response(harness: Harness) {
  harness.testing.http_mock(
    "POST",
    BASE + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {data: {repository: {pullRequest: page([], 0)}}, errors: [{message: "permission denied"}]},
      ),
    },
  )
  assert(is_err(read(harness)))
}
