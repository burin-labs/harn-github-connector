import { call } from "../src/facade"

const BASE = "https://github-api.test"

const AUTH = {api_base_url: BASE, installation_token: "github-installation-token"}

const REPO = "octo-org/private-repo"

const HEAD = "private-head-sha"

fn pull() {
  return {
    number: 77,
    state: "closed",
    merged: true,
    mergeable: true,
    mergeable_state: "unknown",
    base: {ref: "main", repo: {full_name: REPO}},
    head: {ref: "automation/bump-harn-runtime", sha: HEAD, repo: {full_name: REPO}},
  }
}

fn mock_pull(testing: HarnessTesting) {
  testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/private-repo/pulls/77",
    {status: 200, body: json_stringify(pull()), headers: {"x-ratelimit-remaining": "20"}},
  )
}

fn missing_checks_scope() {
  return {
    status: 403,
    body: json_stringify({message: "Resource not accessible by integration"}),
    headers: {"x-ratelimit-remaining": "19"},
  }
}

pipeline test_private_pr_checks_fall_back_to_exact_graphql_rollup(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  mock_pull(harness.testing)
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/private-repo/commits/" + HEAD
      + "/check-runs?filter=latest&per_page=100&page=1",
    missing_checks_scope(),
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {
          data: {
            repository: {
              pullRequest: {
                number: 77,
                state: "MERGED",
                merged: true,
                headRefOid: HEAD,
                mergeStateStatus: "UNKNOWN",
                statusCheckRollup: {
                  contexts: {
                    totalCount: 2,
                    pageInfo: {hasNextPage: false, endCursor: nil},
                    nodes: [
                      {
                        __typename: "CheckRun",
                        name: "CI status",
                        status: "COMPLETED",
                        conclusion: "SUCCESS",
                        detailsUrl: "https://github.com/octo-org/private-repo/actions/runs/1",
                      },
                      {
                        __typename: "StatusContext",
                        context: "legacy/status",
                        state: "SUCCESS",
                        targetUrl: "https://ci.example.test/77",
                      },
                    ],
                  },
                },
              },
            },
          },
        },
      ),
      headers: {"x-ratelimit-remaining": "18"},
    },
  )
  const checks = unwrap(call(harness, "github.pr.checks", AUTH + {repo: REPO, number: 77}))
  assert_eq(checks.repo, REPO)
  assert_eq(checks.pull_number, 77)
  assert_eq(checks.head_sha, HEAD)
  assert_eq(checks.state, "merged")
  assert_eq(checks.rollup.state, "green")
  assert_eq(checks.rollup.successful, 2)
  assert_eq(checks.check_run_total, 1)
  assert_eq(checks.status_context_total, 1)
  assert_eq(checks.checks[0].head_sha, HEAD)
  assert_eq(checks.checks[1].conclusion, "success")
  assert_eq(len(harness.testing.http_mock_calls()), 3)
}

pipeline test_unrelated_private_pr_permission_failure_does_not_fall_back(
  harness: Harness,
  task: any,
) {
  harness.testing.http_mock_clear()
  mock_pull(harness.testing)
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/private-repo/commits/" + HEAD
      + "/check-runs?filter=latest&per_page=100&page=1",
    {
      status: 403,
      body: json_stringify({message: "Forbidden"}),
      headers: {"x-ratelimit-remaining": "19"},
    },
  )
  const checks = call(harness, "github.pr.checks", AUTH + {repo: REPO, number: 77})
  assert(is_err(checks))
  assert_eq(unwrap_err(checks).code, "permission")
  assert_eq(len(harness.testing.http_mock_calls()), 2)
}

pipeline test_private_pr_graphql_fallback_refuses_a_changed_head(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  mock_pull(harness.testing)
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/private-repo/commits/" + HEAD
      + "/check-runs?filter=latest&per_page=100&page=1",
    missing_checks_scope(),
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {
          data: {
            repository: {
              pullRequest: {
                number: 77,
                state: "OPEN",
                merged: false,
                headRefOid: "replacement-head",
                mergeStateStatus: "CLEAN",
                statusCheckRollup: {contexts: {nodes: []}},
              },
            },
          },
        },
      ),
      headers: {"x-ratelimit-remaining": "18"},
    },
  )
  const checks = call(harness, "github.pr.checks", AUTH + {repo: REPO, number: 77})
  assert(is_err(checks))
  assert_eq(unwrap_err(checks).code, "stale_head")
}

pipeline test_private_pr_checks_use_exact_head_actions_when_checks_scope_is_hidden(
  harness: Harness,
  task: any,
) {
  harness.testing.http_mock_clear()
  mock_pull(harness.testing)
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/private-repo/commits/" + HEAD
      + "/check-runs?filter=latest&per_page=100&page=1",
    missing_checks_scope(),
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {
          data: {repository: {pullRequest: nil}},
          errors: [
            {
              type: "FORBIDDEN",
              path: ["repository", "pullRequest", "statusCheckRollup"],
              message: "Resource not accessible by integration",
            },
          ],
        },
      ),
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/private-repo/actions/runs?head_sha=" + HEAD + "&per_page=100",
    {
      status: 200,
      body: json_stringify(
        {
          total_count: 3,
          workflow_runs: [
            {
              id: 10,
              workflow_id: 5,
              path: ".github/workflows/ci.yml",
              name: "CI (superseded)",
              event: "pull_request",
              status: "completed",
              conclusion: "failure",
              head_sha: HEAD,
              html_url: "https://github.com/octo-org/private-repo/actions/runs/10",
            },
            {
              id: 11,
              workflow_id: 5,
              path: ".github/workflows/ci.yml",
              name: "CI",
              event: "pull_request",
              status: "completed",
              conclusion: "success",
              head_sha: HEAD,
              run_started_at: "2026-08-15T00:00:00Z",
              updated_at: "2026-08-15T00:01:00Z",
              html_url: "https://github.com/octo-org/private-repo/actions/runs/11",
            },
            {
              id: 12,
              workflow_id: 6,
              path: ".github/workflows/policy.yml",
              name: "Repository policy",
              event: "pull_request",
              status: "completed",
              conclusion: "success",
              head_sha: HEAD,
              html_url: "https://github.com/octo-org/private-repo/actions/runs/12",
            },
          ],
        },
      ),
    },
  )
  const checks = unwrap(call(harness, "github.pr.checks", AUTH + {repo: REPO, number: 77}))
  assert_eq(checks.state, "merged")
  assert_eq(checks.rollup.state, "green")
  assert_eq(checks.rollup.total, 2)
  assert_eq(checks.checks[0].name, "CI")
  assert_eq(checks.checks[0].external_id, "actions-workflow-run:11")
  assert_eq(checks.workflow_run_total, 3)
  assert_eq(len(harness.testing.http_mock_calls()), 4)
}

pipeline test_private_pr_checks_do_not_hide_unrelated_graphql_failures(
  harness: Harness,
  task: any,
) {
  harness.testing.http_mock_clear()
  mock_pull(harness.testing)
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/private-repo/commits/" + HEAD
      + "/check-runs?filter=latest&per_page=100&page=1",
    missing_checks_scope(),
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {errors: [{type: "FORBIDDEN", path: ["repository"], message: "Forbidden"}]},
      ),
    },
  )
  const checks = call(harness, "github.pr.checks", AUTH + {repo: REPO, number: 77})
  assert(is_err(checks))
  assert_eq(unwrap_err(checks).code, "graphql")
  assert_eq(len(harness.testing.http_mock_calls()), 3)
}

pipeline test_private_pr_checks_reject_truncated_graphql_contexts(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  mock_pull(harness.testing)
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/private-repo/commits/" + HEAD
      + "/check-runs?filter=latest&per_page=100&page=1",
    missing_checks_scope(),
  )
  harness.testing.http_mock(
    "POST",
    BASE + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {
          data: {
            repository: {
              pullRequest: {
                number: 77,
                state: "OPEN",
                merged: false,
                headRefOid: HEAD,
                mergeStateStatus: "CLEAN",
                statusCheckRollup: {
                  contexts: {
                    totalCount: 101,
                    pageInfo: {hasNextPage: true, endCursor: "opaque"},
                    nodes: [],
                  },
                },
              },
            },
          },
        },
      ),
    },
  )
  const checks = call(harness, "github.pr.checks", AUTH + {repo: REPO, number: 77})
  assert(is_err(checks))
  assert_eq(unwrap_err(checks).code, "incomplete_page")
}
