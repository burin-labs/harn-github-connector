import { GithubClientOptions, GithubRefClaimRequest, github_claim_ref } from "../src/facade"

const BASE = "https://api.github.test"

const HOLDER_OID = "1111111111111111111111111111111111111111"

const OURS = "2222222222222222222222222222222222222222"

const REF = "refs/heads/release-lock/v1.2.3"

fn auth() -> GithubClientOptions {
  return {api_base_url: BASE, installation_token: "github-app-installation-token"}
}

fn request() -> GithubRefClaimRequest {
  return {owner: "octo-org", repo: "octo-repo", ref: REF, oid: OURS, options: auth()}
}

fn refs_url() -> string {
  return BASE + "/repos/octo-org/octo-repo/git/refs"
}

fn ref_read_url() -> string {
  return BASE + "/repos/octo-org/octo-repo/git/ref/heads/release-lock/v1.2.3"
}

fn taken(message: string, status: int = 422) {
  return {
    status: status,
    body: json_stringify({message: message, documentation_url: "https://docs.github.test"}),
  }
}

pipeline test_an_uncontended_ref_is_claimed(harness: Harness, task) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    refs_url(),
    {status: 201, body: json_stringify({ref: REF, object: {sha: OURS, type: "commit"}})},
  )
  const claim = unwrap(github_claim_ref(harness, request()))
  assert_eq(claim.claimed, true)
  assert_eq(claim.oid, OURS)
  assert_eq(claim.ref, REF)
  assert_eq(claim.repo, "octo-org/octo-repo")
  assert_eq(claim.holder_headline, "")
}

pipeline test_a_taken_ref_reports_the_holder_instead_of_failing(harness: Harness, task) {
  // The point of the primitive: losing the race is an answer a caller can act
  // on at second one, not an error it has to classify.
  harness.testing.http_mock_clear()
  harness.testing.http_mock("POST", refs_url(), taken("Reference already exists"))
  harness.testing.http_mock(
    "GET",
    ref_read_url(),
    {status: 200, body: json_stringify({ref: REF, object: {sha: HOLDER_OID, type: "commit"}})},
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/commits/" + HOLDER_OID,
    {
      status: 200,
      body: json_stringify(
        {
          sha: HOLDER_OID,
          message:
            "release-lock v1.2.3 run 019fc846 on hosted-runner\n\nstarted 2026-08-03T10:00:00Z",
        },
      ),
    },
  )
  const claim = unwrap(github_claim_ref(harness, request()))
  assert_eq(claim.claimed, false)
  assert_eq(claim.oid, HOLDER_OID)
  assert_eq(claim.holder_headline, "release-lock v1.2.3 run 019fc846 on hosted-runner")
}

pipeline test_a_holder_without_a_readable_payload_is_still_a_lost_claim(harness: Harness, task) {
  // A lock whose commit has been garbage collected is still held. Reporting the
  // headline is best effort; reporting the loss is not.
  harness.testing.http_mock_clear()
  harness.testing.http_mock("POST", refs_url(), taken("Reference already exists"))
  harness.testing.http_mock(
    "GET",
    ref_read_url(),
    {status: 200, body: json_stringify({ref: REF, object: {sha: HOLDER_OID, type: "tag"}})},
  )
  const claim = unwrap(github_claim_ref(harness, request()))
  assert_eq(claim.claimed, false)
  assert_eq(claim.oid, HOLDER_OID)
  assert_eq(claim.holder_headline, "")
}

pipeline test_a_422_that_is_not_contention_stays_an_error(harness: Harness, task) {
  // GitHub spends one status on "taken", "no such object", and "bad ref name".
  // Reading the ref back is what tells them apart; without it a caller would
  // wait for a lock nobody holds.
  harness.testing.http_mock_clear()
  harness.testing.http_mock("POST", refs_url(), taken("Object does not exist"))
  harness.testing.http_mock("GET", ref_read_url(), {status: 404, body: json_stringify({})})
  const result = github_claim_ref(harness, request())
  assert(is_err(result))
  assert_eq(unwrap_err(result).http_status, 422)
}

pipeline test_the_documented_conflict_status_reports_the_holder_too(harness: Harness, task) {
  // GitHub answers a taken ref with 422 today, and documents 409 for the same
  // case on the create endpoint. A claim that reads back on only one of them
  // turns contention into an unreadable lock — a caller can wait for a holder,
  // but it cannot do anything with "the claim failed for an unknown reason".
  harness.testing.http_mock_clear()
  harness.testing.http_mock("POST", refs_url(), taken("Reference already exists", 409))
  harness.testing.http_mock(
    "GET",
    ref_read_url(),
    {status: 200, body: json_stringify({ref: REF, object: {sha: HOLDER_OID, type: "commit"}})},
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/commits/" + HOLDER_OID,
    {status: 200, body: json_stringify({sha: HOLDER_OID, message: "release-lock v1.2.3 run=019f"})},
  )
  const claim = unwrap(github_claim_ref(harness, request()))
  assert_eq(claim.claimed, false)
  assert_eq(claim.oid, HOLDER_OID)
  assert_eq(claim.holder_headline, "release-lock v1.2.3 run=019f")
}

pipeline test_a_refusal_that_is_not_a_conflict_never_costs_a_read_back(harness: Harness, task) {
  // The read-back is only reachable from a status that could mean "already
  // there". A 500 is not evidence of a holder, and asking again would report
  // whoever happens to hold the ref as the reason this claim failed.
  harness.testing.http_mock_clear()
  harness.testing.http_mock("POST", refs_url(), taken("Server Error", 500))
  harness.testing.http_mock(
    "GET",
    ref_read_url(),
    {status: 200, body: json_stringify({ref: REF, object: {sha: HOLDER_OID, type: "commit"}})},
  )
  const result = github_claim_ref(harness, request())
  assert(is_err(result))
  assert_eq(unwrap_err(result).http_status, 500)
  assert_eq(
    len(harness.testing.http_mock_calls().filter({ call -> call.method == "GET" }).to_list()),
    0,
  )
}

pipeline test_a_partial_ref_is_refused_before_any_request(harness: Harness, task) {
  // `git/refs` and `git/ref` spell the same ref differently. Requiring the
  // qualified name at the boundary is what keeps the claim and the read-back
  // describing one ref.
  harness.testing.http_mock_clear()
  const partial: GithubRefClaimRequest = request() + {ref: "heads/release-lock/v1.2.3"}
  const result = github_claim_ref(harness, partial)
  assert(is_err(result))
  assert_eq(unwrap_err(result).code, "schema_drift")
  const without_oid: GithubRefClaimRequest = request() + {oid: ""}
  assert(is_err(github_claim_ref(harness, without_oid)))
}

const BASE_REF = "refs/heads/main"

const BASE_TIP = "3333333333333333333333333333333333333333"

const BASE_TREE = "4444444444444444444444444444444444444444"

const MINTED = "5555555555555555555555555555555555555555"

fn payload_request() -> GithubRefClaimRequest {
  return {
    owner: "octo-org",
    repo: "octo-repo",
    ref: REF,
    payload: {message: "release-lock v1.2.3 run=019fc846 host=laptop", base_ref: BASE_REF},
    options: auth(),
  }
}

fn mint_mocks(testing: HarnessTesting) {
  testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/ref/heads/main",
    {status: 200, body: json_stringify({ref: BASE_REF, object: {sha: BASE_TIP, type: "commit"}})},
  )
  testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/commits/" + BASE_TIP,
    {status: 200, body: json_stringify({sha: BASE_TIP, tree: {sha: BASE_TREE}})},
  )
  testing.http_mock(
    "POST",
    BASE + "/repos/octo-org/octo-repo/git/commits",
    {status: 201, body: json_stringify({sha: MINTED, tree: {sha: BASE_TREE}})},
  )
}

pipeline test_a_claim_with_no_oid_mints_its_own_payload(harness: Harness, task) {
  // A lock has nothing to point at yet, so the connector mints the object the
  // ref will name and the caller never handles a tree.
  harness.testing.http_mock_clear()
  mint_mocks(harness.testing)
  harness.testing.http_mock(
    "POST",
    refs_url(),
    {status: 201, body: json_stringify({ref: REF, object: {sha: MINTED, type: "commit"}})},
  )
  const claim = unwrap(github_claim_ref(harness, payload_request()))
  assert_eq(claim.claimed, true)
  assert_eq(claim.oid, MINTED)
  const minted = harness.testing.http_mock_calls().filter(
    { call -> call.method == "POST" && call.url == BASE + "/repos/octo-org/octo-repo/git/commits" },
  )
    .to_list()
  assert_eq(len(minted), 1)
  const body: {message: string, tree: string, parents: list<string>} = json_parse(
    to_string(minted[0]?.body ?? "{}"),
  )
  assert_eq(body.tree, BASE_TREE)
  // Parentless on purpose: a lock is a label, not history.
  assert_eq(body.parents, [])
  assert_eq(body.message, "release-lock v1.2.3 run=019fc846 host=laptop")
}

pipeline test_a_minted_payload_still_reports_the_holder_when_the_claim_is_lost(
  harness: Harness,
  task,
) {
  harness.testing.http_mock_clear()
  mint_mocks(harness.testing)
  harness.testing.http_mock("POST", refs_url(), taken("Reference already exists"))
  harness.testing.http_mock(
    "GET",
    ref_read_url(),
    {status: 200, body: json_stringify({ref: REF, object: {sha: HOLDER_OID, type: "commit"}})},
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/git/commits/" + HOLDER_OID,
    {
      status: 200,
      body: json_stringify({sha: HOLDER_OID, message: "release-lock v1.2.3 run=019fc7eb"}),
    },
  )
  const claim = unwrap(github_claim_ref(harness, payload_request()))
  assert_eq(claim.claimed, false)
  assert_eq(claim.oid, HOLDER_OID)
  assert_eq(claim.holder_headline, "release-lock v1.2.3 run=019fc7eb")
}

pipeline test_a_claim_with_neither_an_oid_nor_a_payload_is_refused_before_any_request(
  harness: Harness,
  task,
) {
  harness.testing.http_mock_clear()
  const failure = unwrap_err(
    github_claim_ref(harness, {owner: "octo-org", repo: "octo-repo", ref: REF, options: auth()}),
  )
  assert_eq(failure.code, "schema_drift")
  assert_eq(len(harness.testing.http_mock_calls()), 0)
}
