import {
  GithubFileLookupRequest,
  actions_workflow_dispatch,
  actions_workflow_run,
  actions_workflow_runs,
  api_call,
  github_file_at_ref,
  github_latest_release,
  github_latest_release_lookup,
  github_release_assets,
  pulls_enable_auto_merge,
  repos_get_latest_release,
  repos_get_text,
  repos_list_release_assets,
} from "../src/facade"

fn request_to(calls, method, url) {
  for call in calls {
    if call.method == method && call.url == url {
      return call
    }
  }
  return nil
}

const BASE = "https://github-api.test"

fn typed_auth() -> dict {
  return {api_base_url: BASE, installation_token: "github-installation-token"}
}

fn release_payload() -> dict {
  return {
    id: 501,
    tag_name: "v0.8.4",
    name: "v0.8.4",
    draft: false,
    prerelease: false,
    html_url: "https://github.com/octo-org/octo-repo/releases/tag/v0.8.4",
    target_commitish: "main",
    body: "notes",
    published_at: "2026-05-09T18:00:00Z",
    assets: [],
  }
}

pipeline test_typed_repository_file_helper_validates_the_normalized_contract(
  harness: Harness,
  task,
) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/contents/VERSION?ref=main",
    {
      status: 200,
      body: json_stringify(
        {
          type: "file",
          encoding: "base64",
          name: "VERSION",
          path: "VERSION",
          sha: "file-sha",
          size: 7,
          content: base64_encode("0.6.6\n"),
          html_url: "https://github.com/octo-org/octo-repo/blob/main/VERSION",
        },
      ),
      headers: {"x-ratelimit-remaining": "10"},
    },
  )
  const request: GithubFileLookupRequest = {
    owner: "octo-org",
    repo: "octo-repo",
    path: "VERSION",
    ref: "main",
    options: typed_auth(),
  }
  const result = unwrap(github_file_at_ref(harness, request))
  assert_eq(result.state, "found")
  assert_eq(result.file?.text, "0.6.6\n")
}

pipeline test_typed_latest_release_helper_distinguishes_accessible_absence(harness: Harness, task) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo/releases/latest",
    {
      responses: [
        {status: 200, body: json_stringify(release_payload())},
        {status: 404, body: json_stringify({message: "Not Found"})},
        {status: 404, body: json_stringify({message: "Not Found"})},
      ],
    },
  )
  harness.testing.http_mock(
    "GET",
    BASE + "/repos/octo-org/octo-repo",
    {
      responses: [
        {status: 200, body: json_stringify({full_name: "octo-org/octo-repo"})},
        {status: 404, body: json_stringify({message: "Not Found"})},
      ],
    },
  )
  const request = {owner: "octo-org", repo: "octo-repo", options: typed_auth()}
  const found = unwrap(github_latest_release_lookup(harness, request))
  assert_eq(found.release?.tag_name, "v0.8.4")
  const absent = unwrap(github_latest_release_lookup(harness, request))
  assert_eq(absent, {repo: "octo-org/octo-repo", state: "absent", found: false, release: nil})
  const masked = github_latest_release_lookup(harness, request)
  assert(is_err(masked))
  assert_eq(unwrap_err(masked).code, "inaccessible_resource")
}

pipeline test_repo_automation_methods(harness: Harness, task) {
  harness.testing.http_mock_clear()
  const base = "https://github-api.test"
  const token = "github-installation-token"
  const auth = {api_base_url: base, installation_token: token}
  harness.testing.http_mock(
    "GET",
    base + "/repos/octo-org/octo-repo/contents/.harn-version?ref=main",
    {
      status: 200,
      body: json_stringify(
        {
          name: ".harn-version",
          path: ".harn-version",
          sha: "file-sha",
          size: 7,
          encoding: "base64",
          content: base64_encode("v0.7.59\n"),
        },
      ),
      headers: {"x-ratelimit-remaining": "10"},
    },
  )
  const text = unwrap(
    repos_get_text(
      harness,
      {owner: "octo-org", repo: "octo-repo", path: ".harn-version", ref: "main", options: auth},
    ),
  )
  assert_eq(trim(text.text), "v0.7.59", "repos.get_text decodes base64 content")
  harness.testing.http_mock(
    "POST",
    base + "/repos/octo-org/octo-repo/actions/workflows/bump-harn.yml/dispatches",
    {
      status: 200,
      body: json_stringify(
        {
          workflow_run_id: 123,
          run_url: base + "/repos/octo-org/octo-repo/actions/runs/123",
          html_url: "https://github.com/octo-org/octo-repo/actions/runs/123",
        },
      ),
      headers: {"x-ratelimit-remaining": "9"},
    },
  )
  harness.testing.http_mock(
    "GET",
    base + "/repos/octo-org/octo-repo/actions/runs/123",
    {
      responses: [
        {
          status: 200,
          body: json_stringify(
            {
              id: 123,
              workflow_id: 456,
              path: ".github/workflows/bump-harn.yml",
              head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              head_branch: "main",
              event: "workflow_dispatch",
              status: "queued",
              conclusion: nil,
              html_url: "https://github.com/octo-org/octo-repo/actions/runs/123",
            },
          ),
          headers: {"x-ratelimit-remaining": "8"},
        },
        {
          status: 200,
          body: json_stringify(
            {
              id: 123,
              workflow_id: 456,
              path: ".github/workflows/bump-harn.yml",
              head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              head_branch: "main",
              event: "workflow_dispatch",
              status: "completed",
              conclusion: "success",
              html_url: "https://github.com/octo-org/octo-repo/actions/runs/123",
            },
          ),
          headers: {"x-ratelimit-remaining": "7"},
        },
      ],
    },
  )
  const dispatch = unwrap(
    actions_workflow_dispatch(
      harness,
      {
        owner: "octo-org",
        repo: "octo-repo",
        workflow_id: "bump-harn.yml",
        ref: "main",
        inputs: {version: "v0.7.59"},
        options: auth,
      },
    ),
  )
  assert_eq(dispatch.run_id, 123, "workflow dispatch returns the exact run id")
  harness.testing.http_mock(
    "GET",
    base
      + "/repos/octo-org/octo-repo/actions/workflows/bump-harn.yml/runs?event=workflow_dispatch&per_page=5",
    {
      status: 200,
      body: json_stringify(
        {
          total_count: 1,
          workflow_runs: [
            {
              id: 123,
              workflow_id: 456,
              path: ".github/workflows/bump-harn.yml",
              head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              head_branch: "main",
              event: "workflow_dispatch",
              status: "completed",
              conclusion: "success",
              html_url: "https://github.com/octo-org/octo-repo/actions/runs/123",
            },
          ],
        },
      ),
      headers: {"x-ratelimit-remaining": "8"},
    },
  )
  const runs = unwrap(
    actions_workflow_runs(
      harness,
      {
        owner: "octo-org",
        repo: "octo-repo",
        workflow_id: "bump-harn.yml",
        event: "workflow_dispatch",
        per_page: 5,
        options: auth,
      },
    ),
  )
  assert_eq(runs.runs[0].id, 123, "workflow runs list response")
  const run = unwrap(
    actions_workflow_run(
      harness,
      {owner: "octo-org", repo: "octo-repo", run_id: 123, options: auth},
    ),
  )
  assert_eq(run.conclusion, "success", "workflow run get response")
  harness.testing.http_mock(
    "GET",
    base + "/repos/octo-org/octo-repo/releases/latest",
    {
      status: 200,
      body: json_stringify(
        {
          id: 501,
          tag_name: "v0.8.4",
          name: "v0.8.4",
          draft: false,
          prerelease: false,
          html_url: "https://github.com/octo-org/octo-repo/releases/tag/v0.8.4",
          published_at: "2026-05-09T18:00:00Z",
          assets: [
            {id: 1, name: "harn-aarch64-apple-darwin.tar.gz"},
            {id: 2, name: "harn-x86_64-unknown-linux-gnu.tar.gz"},
          ],
        },
      ),
      headers: {"x-ratelimit-remaining": "7"},
    },
  )
  const repo_request = {owner: "octo-org", repo: "octo-repo", options: auth}
  const raw_release = unwrap(repos_get_latest_release(harness, repo_request))
  assert_eq(raw_release.tag_name, "v0.8.4", "raw latest release tag")
  harness.testing.http_mock(
    "GET",
    base + "/repos/octo-org/octo-repo/releases/latest",
    {
      status: 200,
      body: json_stringify(
        {
          id: 501,
          tag_name: "v0.8.4",
          assets: [
            {id: 1, name: "harn-aarch64-apple-darwin.tar.gz"},
            {id: 2, name: "harn-x86_64-unknown-linux-gnu.tar.gz"},
          ],
        },
      ),
      headers: {"x-ratelimit-remaining": "7"},
    },
  )
  const latest = unwrap(github_latest_release(harness, repo_request))
  assert_eq(latest.ok, true, "latest release envelope ok")
  assert_eq(latest.tag_name, "v0.8.4", "latest release envelope tag")
  assert_eq(
    latest.asset_names[1],
    "harn-x86_64-unknown-linux-gnu.tar.gz",
    "latest release asset names",
  )
  harness.testing.http_mock(
    "GET",
    base + "/repos/octo-org/octo-repo/releases/501/assets?per_page=2",
    {
      status: 200,
      body: json_stringify([{id: 1, name: "harn-aarch64-apple-darwin.tar.gz"}]),
      headers: {"x-ratelimit-remaining": "7"},
    },
  )
  const raw_assets = unwrap(
    repos_list_release_assets(
      harness,
      {owner: "octo-org", repo: "octo-repo", release_id: 501, per_page: 2, options: auth},
    ),
  )
  assert_eq(raw_assets[0].name, "harn-aarch64-apple-darwin.tar.gz", "raw release assets")
  harness.testing.http_mock(
    "GET",
    base + "/repos/octo-org/octo-repo/releases/501/assets?per_page=2",
    {
      status: 200,
      body: json_stringify([{id: 2, name: "harn-x86_64-unknown-linux-gnu.tar.gz"}]),
      headers: {"x-ratelimit-remaining": "7"},
    },
  )
  const assets = unwrap(
    github_release_assets(
      harness,
      {owner: "octo-org", repo: "octo-repo", release_id: 501, per_page: 2, options: auth},
    ),
  )
  assert_eq(assets.ok, true, "release assets envelope ok")
  assert_eq(assets.asset_names[0], "harn-x86_64-unknown-linux-gnu.tar.gz", "release assets names")
  harness.testing.http_mock(
    "GET",
    base + "/repos/octo-org/octo-repo/releases/latest",
    {
      status: 200,
      body: json_stringify({tag_name: "v0.8.4"}),
      headers: {"x-ratelimit-remaining": "7"},
    },
  )
  const raw = unwrap(
    api_call(harness, {path: "/repos/octo-org/octo-repo/releases/latest", options: auth}),
  )
  assert_eq(raw.tag_name, "v0.8.4", "raw api_call works as compatibility escape hatch")
  harness.testing.http_mock(
    "GET",
    base + "/repos/octo-org/octo-repo/pulls/7",
    {
      status: 200,
      body: json_stringify(
        {
          number: 7,
          node_id: "PR_node_7",
          head: {sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
          auto_merge: nil,
        },
      ),
      headers: {"x-ratelimit-remaining": "6"},
    },
  )
  harness.testing.http_mock(
    "POST",
    base + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {
          data: {
            enablePullRequestAutoMerge: {
              actor: {login: "octocat"},
              pullRequest: {
                number: 7,
                url: "https://github.com/octo-org/octo-repo/pull/7",
                mergeStateStatus: "CLEAN",
                autoMergeRequest: {enabledAt: "2026-05-06T18:00:00Z", mergeMethod: "SQUASH"},
              },
            },
          },
        },
      ),
      headers: {"x-ratelimit-remaining": "5"},
    },
  )
  const auto_merge = unwrap(
    pulls_enable_auto_merge(
      harness,
      {
        owner: "octo-org",
        repo: "octo-repo",
        pull_number: 7,
        method: "squash",
        expected_head_oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        options: auth,
      },
    ),
  )
  assert_eq(auto_merge.state, "enabled", "auto-merge enabled state")
  assert_eq(auto_merge.merge_method, "SQUASH", "auto-merge merge method normalized")
  const calls = harness.testing.http_mock_calls()
  const dispatch_call = request_to(
    calls,
    "POST",
    base + "/repos/octo-org/octo-repo/actions/workflows/bump-harn.yml/dispatches",
  )
  const mutation_call = request_to(calls, "POST", base + "/graphql")
  assert(dispatch_call != nil, "workflow dispatch request was observed")
  assert(mutation_call != nil, "auto-merge GraphQL request was observed")
  const dispatch_body = json_parse(dispatch_call?.body ?? "")
  const mutation_body = json_parse(mutation_call?.body ?? "")
  const mutation_vars = mutation_body.get("variables")
  assert_eq(dispatch_body.get("return_run_details"), true, "workflow dispatch asks for run details")
  assert_eq(mutation_vars.get("pullRequestId"), "PR_node_7", "auto-merge mutation uses PR node id")
  assert_eq(
    mutation_vars.get("expectedHeadOid"),
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "auto-merge mutation uses expected head oid",
  )
  assert(
    contains(mutation_body.get("query"), "enablePullRequestAutoMerge"),
    "auto-merge mutation name",
  )
  harness.testing.http_mock_clear()
}
