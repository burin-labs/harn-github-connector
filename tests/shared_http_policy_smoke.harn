import { call } from "../src/facade"

pipeline test_shared_http_policy_smoke(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  const base = "https://github-api.test"
  const auth = {api_base_url: base, installation_token: "github-installation-token"}
  const retry_opts = {max_attempts: 2, base_ms: 0, cap_ms: 1}
  harness.testing.http_mock(
    "GET",
    base + "/repos/octo-org/octo-repo/pulls/1",
    {status: 200, body: "not json", headers: {"x-ratelimit-remaining": "10"}},
  )
  const invalid = call(
    harness,
    "pulls.get",
    auth + {owner: "octo-org", repo: "octo-repo", pull_number: 1},
  )
  assert(is_err(invalid), "invalid JSON responses should be categorized")
  assert_eq(unwrap_err(invalid).code, "invalid_response", "invalid JSON code stays stable")
  assert_eq(unwrap_err(invalid).category, "schema_drift", "invalid JSON category stays stable")
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    base + "/repos/octo-org/octo-repo/pulls/403",
    {
      status: 403,
      body:
        "{\"message\":\"Resource not accessible by integration\",\"token\":\"must-not-surface\"}",
      headers: {"x-ratelimit-remaining": "10"},
    },
  )
  const denied = call(
    harness,
    "pulls.get",
    auth + {owner: "octo-org", repo: "octo-repo", pull_number: 403},
  )
  assert(is_err(denied), "permission denials should remain typed errors")
  const denial = unwrap_err(denied)
  assert_eq(denial.code, "missing_scopes", "provider denial keeps its stable code")
  assert(
    contains(denial.message, "Resource not accessible by integration"),
    "provider denial keeps GitHub's actionable message",
  )
  assert(
    !contains(denial.message, "must-not-surface"),
    "provider denial does not copy unrelated response fields",
  )
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    base + "/repos/octo-org/octo-repo/pulls/2",
    {
      responses: [
        {status: 503, body: "{\"message\":\"busy\"}", headers: {"x-ratelimit-remaining": "10"}},
        {status: 200, body: "{\"number\":2}", headers: {"x-ratelimit-remaining": "9"}},
      ],
    },
  )
  const retried_get = unwrap(
    call(
      harness,
      "pulls.get",
      auth + {owner: "octo-org", repo: "octo-repo", pull_number: 2, retry: retry_opts},
    ),
  )
  assert_eq(retried_get.number, 2, "safe GET retries use shared HTTP policy")
  assert_eq(len(harness.testing.http_mock_calls()), 2, "safe GET retry call count")
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    base + "/repos/octo-org/octo-repo/issues/8/comments",
    {
      responses: [
        {status: 503, body: "{\"message\":\"busy\"}", headers: {"x-ratelimit-remaining": "10"}},
        {status: 201, body: "{\"id\":801}", headers: {"x-ratelimit-remaining": "9"}},
      ],
    },
  )
  const unsafe_write = call(
    harness,
    "issues.create_comment",
    auth
      + {owner: "octo-org", repo: "octo-repo", issue_number: 8, body: "hello", retry: retry_opts},
  )
  assert(is_err(unsafe_write), "unsafe writes without idempotency should not retry")
  assert_eq(
    len(harness.testing.http_mock_calls()),
    1,
    "unsafe write without idempotency call count",
  )
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    base + "/repos/octo-org/octo-repo/issues/9/comments",
    {
      responses: [
        {status: 503, body: "{\"message\":\"busy\"}", headers: {"x-ratelimit-remaining": "10"}},
        {status: 201, body: "{\"id\":901}", headers: {"x-ratelimit-remaining": "9"}},
      ],
    },
  )
  const idempotent_write = unwrap(
    call(
      harness,
      "issues.create_comment",
      auth
        + {
          owner: "octo-org",
          repo: "octo-repo",
          issue_number: 9,
          body: "hello",
          retry: retry_opts,
          idempotency_key: "comment-9",
        },
    ),
  )
  const idempotent_calls = harness.testing.http_mock_calls({include_sensitive: true})
  assert_eq(idempotent_write.id, 901, "idempotency key permits configured unsafe write retry")
  assert_eq(len(idempotent_calls), 2, "idempotent write retry call count")
  assert_eq(idempotent_calls[0].headers["idempotency-key"], "comment-9", "idempotency header")
  harness.testing.http_mock_clear()
}
