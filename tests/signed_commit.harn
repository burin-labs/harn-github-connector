import {
  GithubClientOptions,
  GithubCommitFileAddition,
  GithubCommitFileDeletion,
  GithubSignedCommitRequest,
  github_create_signed_commit,
} from "../src/facade"

type SignedCommitPayload = {
  query: string,
  variables: {
    input: {
      branch: {repositoryNameWithOwner: string, branchName: string},
      expectedHeadOid: string,
      fileChanges: {additions: list<{path: string}>, deletions: list<{path: string}>},
      author?: unknown,
      committer?: unknown,
      signature?: unknown,
    },
  },
}

fn auth(base: string) -> GithubClientOptions {
  return {api_base_url: base, installation_token: "github-app-installation-token"}
}

fn request(base: string) -> GithubSignedCommitRequest {
  const additions: list<GithubCommitFileAddition> = [
    {path: ".harn-version", contents_base64: base64_encode("v0.10.8\n")},
    {path: "VERSION", contents_base64: base64_encode("0.10.8\n")},
  ]
  const deletions: list<GithubCommitFileDeletion> = [{path: "changelog.d/old.changed.md"}]
  return {
    owner: "octo-org",
    repo: "octo-repo",
    branch: "automation/release-v1.2.3",
    expected_head_oid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    headline: "Update runtime to v1.2.3",
    body: "Automated runtime update",
    additions: additions,
    deletions: deletions,
    options: auth(base),
  }
}

pipeline test_create_signed_commit_uses_atomic_github_signed_mutation(harness: Harness, task: any) {
  harness.testing.http_mock_clear()
  const base = "https://api.github.test"
  harness.testing.http_mock(
    "POST",
    base + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {
          data: {
            createCommitOnBranch: {
              commit: {
                oid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                url:
                  "https://github.com/octo-org/octo-repo/commit/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                signature: {isValid: true, state: "VALID", wasSignedByGitHub: true},
              },
              ref: {
                name: "automation/release-v1.2.3",
                target: {oid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"},
              },
            },
          },
        },
      ),
    },
  )
  const receipt = unwrap(github_create_signed_commit(harness, request(base)))
  assert_eq(receipt.oid, "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "commit oid")
  assert_eq(receipt.signature_valid, true, "signature valid")
  assert_eq(receipt.signed_by_github, true, "signed by GitHub")
  assert_eq(receipt.signature_state, "VALID", "signature state")
  const calls = harness.testing.http_mock_calls()
  assert_eq(len(calls), 1, "one atomic GraphQL request")
  const payload = json_parse(calls[0].body)
  guard schema_is(payload, SignedCommitPayload) else {
    throw "signed commit payload shape drifted"
  }
  const typed_payload: SignedCommitPayload = payload
  const input = typed_payload.variables.input
  assert_eq(input.branch.repositoryNameWithOwner, "octo-org/octo-repo", "repository")
  assert_eq(input.branch.branchName, "automation/release-v1.2.3", "branch")
  assert_eq(
    input.expectedHeadOid,
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "expected head lease",
  )
  assert_eq(input.fileChanges.additions[0]?.path, ".harn-version", "addition path")
  assert_eq(input.fileChanges.deletions[0]?.path, "changelog.d/old.changed.md", "deletion path")
  assert_eq(input.author, nil, "no custom author")
  assert_eq(input.committer, nil, "no custom committer")
  assert_eq(input.signature, nil, "no custom signature")
  assert(contains(typed_payload.query, "createCommitOnBranch"), "signed commit mutation")
  harness.testing.http_mock_clear()
}

pipeline test_create_signed_commit_fails_closed_on_unverified_signature(
  harness: Harness,
  task: any,
) {
  harness.testing.http_mock_clear()
  const base = "https://api.github.test"
  harness.testing.http_mock(
    "POST",
    base + "/graphql",
    {
      status: 200,
      body: json_stringify(
        {
          data: {
            createCommitOnBranch: {
              commit: {
                oid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                url:
                  "https://github.com/octo-org/octo-repo/commit/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                signature: {isValid: false, state: "UNSIGNED", wasSignedByGitHub: false},
              },
              ref: {name: "automation/release-v1.2.3"},
            },
          },
        },
      ),
    },
  )
  const result = github_create_signed_commit(harness, request(base))
  assert(is_err(result), "unverified commit rejected")
  assert_eq(unwrap_err(result).code, "signature_invalid", "signature error code")
  harness.testing.http_mock_clear()
}

pipeline test_create_signed_commit_rejects_overlapping_changes_before_network(
  harness: Harness,
  task: any,
) {
  harness.testing.http_mock_clear()
  const additions: list<GithubCommitFileAddition> = [
    {path: "VERSION", contents_base64: base64_encode("0.10.8\n")},
  ]
  const deletions: list<GithubCommitFileDeletion> = [{path: "VERSION"}]
  const overlapping: GithubSignedCommitRequest = request("https://api.github.test")
    + {additions: additions, deletions: deletions}
  const result = github_create_signed_commit(harness, overlapping)
  assert(is_err(result), "overlapping change rejected")
  assert_eq(unwrap_err(result).code, "schema_drift", "overlap error code")
  assert_eq(len(harness.testing.http_mock_calls()), 0, "no network request")
}
